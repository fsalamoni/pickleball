rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() { return request.auth != null; }
    // Atalhos de TODA regra. Existem pelo TAMANHO: o Firebase recusa o ruleset
    // COMPILADO acima de 250 KB (além dos 256 KiB da fonte), e cada
    // `request.resource.data` escrito por extenso vira nós a mais no compilado
    // — em 2026-10-18 as regras ficaram sem publicar por isso (PRs #281–#284;
    // a CLI só mostrava "409 release already exists"). Ver docs/03-WORKFLOW.md §4.3.
    function nd() { return request.resource.data; }  // o documento como FICARÁ (create/update)
    function od() { return resource.data; }          // o documento como ESTÁ (read/update/delete)
    function me() { return request.auth.uid; }
    function chg() { return request.resource.data.diff(resource.data).affectedKeys(); }  // o que o update muda
    function isOwner(uid) { return isAuthed() && uid == me(); }
    // DUPR verificado (update do DONO): não mexe no selo e, com ele, não reescreve ID nem ratings.
    function duprSeloIntacto() {
      return !chg().hasAny(['dupr_verified', 'dupr_verified_at_ms'])
        && !(od().get('dupr_verified', false) == true
             && chg().hasAny(['dupr_id', 'dupr_rating', 'dupr_rating_singles']));
    }
    function isPlatformAdmin() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(me()))
        && get(/databases/$(database)/documents/users/$(me())).data.role == 'platform_admin';
    }
    function tokenEmailVerified() {
      return isAuthed() && request.auth.token.get('email_verified', false) == true;
    }
    function isPlatformOwnerEmail() {
      return tokenEmailVerified() && request.auth.token.email == 'fsalamoni@gmail.com';
    }
    function isTournamentAdmin(tid) {
      return isAuthed()
        && exists(/databases/$(database)/documents/tournament_admins/$(tid + '_' + me()));
    }
    // Criador do torneio (dono do recurso).
    function isTournamentCreator(tid) {
      return isAuthed()
        && exists(/databases/$(database)/documents/tournaments/$(tid))
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.creator_uid == me();
    }
    // Quem pode ver/usar um torneio, respeitando o flag 'archived' (criador +
    // admin continuam vendo; público some). Para coleções filhas, chame
    // isTournamentVisibleByTid(request.resource.data.tournament_id).
    function isTournamentVisibleByTid(tid) {
      return exists(/databases/$(database)/documents/tournaments/$(tid))
        && (
          get(/databases/$(database)/documents/tournaments/$(tid)).data.get('archived', false) != true
          || isPlatformAdmin()
          || isTournamentCreator(tid)
        );
    }
    function isClubMember(clubId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/club_members/$(clubId + '_' + me()));
    }
    function isClubAdmin(clubId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/club_members/$(clubId + '_' + me()))
        && get(/databases/$(database)/documents/club_members/$(clubId + '_' + me())).data.role == 'admin';
    }
    // Idem (tamanho): quem gere a arena / administra o clube DO documento.
    function arenaOd() { return isArenaManager(od().arena_id); }
    function arenaNd() { return isArenaManager(nd().arena_id); }
    function clubOd() { return isClubAdmin(od().club_id); }
    function isClubCreator(clubId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/clubs/$(clubId))
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.created_by == me();
    }
    // ---- Dia de jogo do atleta (game_days) --------------------------------
    function gameDayData(gdId) {
      return get(/databases/$(database)/documents/game_days/$(gdId)).data;
    }
    function gameDayExists(gdId) {
      return exists(/databases/$(database)/documents/game_days/$(gdId));
    }
    // Criador (dono) de um dia de jogo do atleta.
    function isGameDayOwnerOf(gdId) {
      return isAuthed() && gameDayExists(gdId)
        && gameDayData(gdId).created_by == me();
    }
    function gameDayIsPublic(gdId) {
      return gameDayExists(gdId) && gameDayData(gdId).visibility == 'public';
    }
    // Membro de um dia de jogo NO FORMATO PLAY. No Play (open play), a
    // organização é colaborativa: qualquer membro pode operar a fila (concluir
    // jogos, criar o próximo, indicar ausentes) e ajustar a própria participação
    // (pular partidas, dupla fixa). Confinado a game_days com format == 'play'.
    function isPlayGameDayMember(gdId) {
      return isAuthed() && gameDayExists(gdId)
        && gameDayData(gdId).format == 'play'
        && (me() in gameDayData(gdId).member_uids);
    }
    // DIA DE JOGO DA ARENA: o documento tem `arena_id` e pertence à arena, não
    // a quem clicou em criar. Quem gerencia a arena administra o dia —
    // inclusive quem virou gestor depois, e mesmo que o criador tenha saído da
    // equipe. Campo ADITIVO: sem `arena_id`, esta função é sempre falsa e
    // nenhum dia de jogo já existente muda de comportamento.
    function isArenaGameDayManagerOf(gdId) {
      return isAuthed() && gameDayExists(gdId)
        && 'arena_id' in gameDayData(gdId)
        && gameDayData(gdId).arena_id is string
        && exists(/databases/$(database)/documents/arena_managers/$(gameDayData(gdId).arena_id + '_' + me()));
    }
    // DIA DE JOGO DO CLUBE: mesma ideia do de arena. O documento tem `club_id`
    // e pertence ao CLUBE — quem administra o clube administra o dia, mesmo
    // que quem agendou a data tenha saído. Campo ADITIVO: sem `club_id`, esta
    // função é sempre falsa e nenhum dia de jogo já existente muda.
    function isClubGameDayManagerOf(gdId) {
      return isAuthed() && gameDayExists(gdId)
        && 'club_id' in gameDayData(gdId)
        && gameDayData(gdId).club_id is string
        && isClubAdmin(gameDayData(gdId).club_id);
    }
    // Membro do clube dono do dia de jogo — é quem PODE VER. No evento de
    // clube legado qualquer membro lia participantes e jogos; o módulo mantém
    // isso sem abrir o dia para a plataforma inteira (a visibilidade segue
    // `private`, então ninguém de fora se insere).
    function isClubGameDayMemberOf(gdId) {
      return isAuthed() && gameDayExists(gdId)
        && 'club_id' in gameDayData(gdId)
        && gameDayData(gdId).club_id is string
        && isClubMember(gameDayData(gdId).club_id);
    }
    // ADMINISTRADOR do dia de jogo: o criador, alguém que ele nomeou em
    // `admin_uids` (campo aditivo — ausente significa "só o criador"), quem
    // gerencia a arena dona (dia de arena) ou quem administra o clube dono
    // (dia de clube).
    function isGameDayAdminOf(gdId) {
      return isAuthed() && gameDayExists(gdId) && (
        gameDayData(gdId).created_by == me()
        || (
          'admin_uids' in gameDayData(gdId)
          && gameDayData(gdId).admin_uids is list
          && (me() in gameDayData(gdId).admin_uids)
        )
        || isArenaGameDayManagerOf(gdId)
        || isClubGameDayManagerOf(gdId)
      );
    }
    // O criador abriu a gestão para quem está inscrito? Campo aditivo: sem ele,
    // ou com qualquer outro valor, o dia de jogo segue restrito ao criador —
    // nenhum dia de jogo já existente muda de comportamento.
    function gameDayOpenToParticipants(gdId) {
      return gameDayExists(gdId)
        && 'manage_mode' in gameDayData(gdId)
        && gameDayData(gdId).manage_mode == 'participants';
    }
    // Quem pode GERENCIAR as partidas e os participantes: administradores
    // sempre; qualquer membro quando o criador abriu a gestão. Configurar o dia
    // (editar, arquivar, mudar o modo, nomear admin) continua só do criador.
    function canManageGameDayOf(gdId) {
      return isGameDayAdminOf(gdId)
        || (
          isAuthed() && gameDayOpenToParticipants(gdId)
          && (me() in gameDayData(gdId).member_uids)
        );
    }
    // Quem pode ver um dia de jogo: dono, membro, qualquer um se público — e,
    // num dia de jogo de CLUBE, quem é do clube.
    function canAccessGameDay(gdId) {
      return isAuthed() && gameDayExists(gdId) && (
        gameDayData(gdId).created_by == me()
        || (me() in gameDayData(gdId).member_uids)
        || gameDayData(gdId).visibility == 'public'
        || isClubGameDayMemberOf(gdId)
        || isPlatformAdmin()
      );
    }
    // O pagamento é de uma venda de que quem paga FAZ PARTE (comprador ou quem
    // divide a conta), e da mesma arena da venda.
    function paymentBelongsToSale(p) {
      let venda = get(/databases/$(database)/documents/arena_sales/$(p.sale_id)).data;
      return venda.arena_id == p.arena_id
        && (venda.buyer_id == me()
            || me() in venda.get('split_with', []));
    }
    // Gestor (dono ou administrador) de uma arena — doc determinístico arenaId_uid.
    // A indicação que chega com o pedido de reserva (Onda BY): o atleta grava
    // SÓ o código, pendente. Conferir, creditar e aplicar desconto é da arena,
    // na confirmação — por isso ninguém nasce "aplicada", nem com desconto ou
    // prêmio já preenchidos (o controle de uso da arena lê esses campos).
    function bookingReferralOkOnCreate() {
      return !('referral' in nd())
        || nd().referral == null
        || (nd().referral.keys().hasOnly(['code', 'status', 'created_at_ms'])
            && nd().referral.status == 'pending'
            && nd().referral.code is string
            && nd().referral.code.size() <= 20);
    }
    function isArenaManager(arenaId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/arena_managers/$(arenaId + '_' + me()));
    }
    // Ler um documento `{arena}_{uid}` que AINDA NÃO EXISTE (2026-09-24).
    //
    // 🐞 Membro, carteira, mensalidade e indicação têm id determinístico, e o
    // código pergunta "já existe?" com um `get` antes de criar. Só que a regra
    // de leitura dessas coleções olha `resource.data`, e num documento que não
    // existe `resource` é nulo: o `get` dava ERRO — para o próprio atleta E
    // para a arena. Consequências medidas no emulador: a arena não conseguia
    // vender pacote nem creditar saldo a quem ainda não era membro, e o código
    // "Indique e ganhe" nunca era criado (a tela sumia sem aviso).
    //
    // Documento ausente não tem dado nenhum para vazar; mesmo assim a leitura
    // é só do dono do uid, da arena do prefixo e do admin. Ids de arena são
    // automáticos (sem `_`); se um dia não forem, a conta NEGA — nunca libera.
    function canGetMissingArenaUserDoc(docId) {
      return isAuthed() && resource == null && (
        docId == docId.split('_')[0] + '_' + me()
        || isArenaManager(docId.split('_')[0])
        || isPlatformAdmin()
      );
    }
    // Dados/relações de um evento (para validar subcoleções pelo documento-pai).
    function eventData(eventId) {
      return get(/databases/$(database)/documents/club_events/$(eventId)).data;
    }
    function eventClubId(eventId) {
      return eventData(eventId).club_id;
    }
    // Eventos antigos sem o campo `visibility` são tratados como públicos.
    function eventIsPublic(eventId) {
      return eventData(eventId).get('visibility', 'public') != 'private';
    }
    // Convidado/participante do evento (doc em event_invites com id determinístico).
    function isEventInvitee(eventId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/event_invites/$(eventId + '_' + me()));
    }
    // Quem pode ver/usar o evento: admin da plataforma, criador, admin do clube,
    // convidado/participante, ou — se público — qualquer membro do clube.
    function isEventParticipant(eventId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/club_events/$(eventId))
        && (isPlatformAdmin()
            || eventData(eventId).created_by == me()
            || isClubAdmin(eventClubId(eventId))
            || isEventInvitee(eventId)
            || (eventIsPublic(eventId) && isClubMember(eventClubId(eventId))));
    }
    function isEventClubMember(eventId) {
      return isEventParticipant(eventId);
    }
    function isEventClubModerator(eventId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/club_events/$(eventId))
        && (isClubAdmin(eventClubId(eventId)) || isPlatformAdmin()
            || eventData(eventId).created_by == me());
    }
    // Membro de uma conversa (validação pelo documento-pai para as mensagens).
    function isConversationMember(cid) {
      return isAuthed()
        && exists(/databases/$(database)/documents/conversations/$(cid))
        && me() in get(/databases/$(database)/documents/conversations/$(cid)).data.member_ids;
    }
    // Clube de um tópico de fórum (para validar comentários/votos pelo pai).
    function forumThreadClubId(tid) {
      return get(/databases/$(database)/documents/club_forum_threads/$(tid)).data.club_id;
    }
    function isForumThreadMember(tid) {
      return isAuthed()
        && exists(/databases/$(database)/documents/club_forum_threads/$(tid))
        && isClubMember(forumThreadClubId(tid));
    }
    function isForumThreadModerator(tid) {
      return isAuthed()
        && exists(/databases/$(database)/documents/club_forum_threads/$(tid))
        && (isClubAdmin(forumThreadClubId(tid)) || isPlatformAdmin());
    }
    // ---- P0-02: o contato do inscrito sai do documento público -----------
    // `tournament_registrations` é lido SEM login (quadro do torneio,
    // /imprimir, /telao) e isso é intencional. Por isso o e-mail não pode
    // morar nele: mora em `{rid}/private/contact`, e a prova de que alguém
    // é o dono de uma inscrição provisória mora em `provisional_claims`.
    function registrationExists(rid) {
      return exists(/databases/$(database)/documents/tournament_registrations/$(rid));
    }
    function registrationData(rid) {
      return get(/databases/$(database)/documents/tournament_registrations/$(rid)).data;
    }
    // Titular do dado: quem se inscreveu, a dupla, ou quem criou a inscrição.
    function isRegistrationParty(rid) {
      return isAuthed() && registrationExists(rid) && (
        registrationData(rid).get('player_a_user_id', '') == me()
        || registrationData(rid).get('player_b_user_id', '') == me()
        || registrationData(rid).get('created_by', '') == me()
      );
    }
    function isRegistrationOrganizer(rid) {
      return isAuthed() && registrationExists(rid)
        && isTournamentAdmin(registrationData(rid).get('tournament_id', ''));
    }
    // E-mail do TOKEN, minúsculo. Nunca campo gravável. Provedor sem e-mail
    // (telefone, anônimo) devolve '' — e '' não casa com nada, porque
    // `hasTokenEmail()` é exigido em toda regra que usa isto.
    function tokenEmailLc() {
      return request.auth.token.get('email', '').lower();
    }
    function hasTokenEmail() {
      return tokenEmailVerified() && tokenEmailLc() != '';
    }
    // Id determinístico: dá para conferir dentro da regra, sem hash.
    function claimIdFor(rid, slot) { return rid + '_' + slot; }
    // A pessoa é a dona da inscrição provisória daquele slot?
    function isProvisionalClaimOwner(rid, slot) {
      return hasTokenEmail()
        && exists(/databases/$(database)/documents/provisional_claims/$(claimIdFor(rid, slot)))
        && get(/databases/$(database)/documents/provisional_claims/$(claimIdFor(rid, slot)))
             .data.get('email_lc', '') == tokenEmailLc();
    }

    // Prova LEGADA: o e-mail ainda está no documento público (inscrições
    // anteriores ao P0-02). Continua valendo enquanto esses documentos
    // existirem — é o que impede a correção de quebrar quem já se inscreveu.
    function isPlayerARegistrationEmailOwner() {
      return isAuthed()
        && tokenEmailVerified()
        && request.auth.token.email is string
        && od().player_a_email_lc == request.auth.token.email.lower()
        && nd().player_a_email_lc == request.auth.token.email.lower()
        && nd().player_a_user_id == me();
    }
    function isPlayerBRegistrationEmailOwner() {
      return isAuthed()
        && tokenEmailVerified()
        && request.auth.token.email is string
        && od().player_b_email_lc == request.auth.token.email.lower()
        && nd().player_b_email_lc == request.auth.token.email.lower()
        && nd().player_b_user_id == me();
    }
    // Prova NOVA: o e-mail não está mais no documento público, então quem
    // reivindica se identifica por `provisional_claims/{rid}_a|b`. Exige, do
    // mesmo jeito, que o resultado da escrita vincule a inscrição a QUEM está
    // reivindicando — ninguém vincula inscrição no nome de outra pessoa.
    function isPlayerAProvisionalOwner(rid) {
      return isProvisionalClaimOwner(rid, 'a')
        && nd().player_a_user_id == me();
    }
    function isPlayerBProvisionalOwner(rid) {
      return isProvisionalClaimOwner(rid, 'b')
        && nd().player_b_user_id == me();
    }
    function isRegistrationEmailOwnerUpdate(rid) {
      return ((isPlayerARegistrationEmailOwner() || isPlayerAProvisionalOwner(rid))
          && chg().hasOnly([
            'user_id',
            'player_a_user_id',
            'player_a_name',
            'player_a_email',
            'player_a_email_lc',
            'player_a_level',
            'player_a_competition_gender',
            'player_a_photo',
            'player_a_provisional',
            'is_provisional',
            'label',
            'claimed_at',
            'updated_at',
          ]))
        || ((isPlayerBRegistrationEmailOwner() || isPlayerBProvisionalOwner(rid))
          && chg().hasOnly([
            'player_b_user_id',
            'player_b_name',
            'player_b_email',
            'player_b_email_lc',
            'player_b_level',
            'player_b_competition_gender',
            'player_b_photo',
            'player_b_provisional',
            'is_provisional',
            'label',
            'claimed_at',
            'updated_at',
          ]));
    }

    // ---- Platform settings (feature flags) -------------------------------
    // Documento único `platform_settings/global`. Leitura pública (as flags
    // governam a UI inclusive na visão de espectador). Escrita só do admin
    // master da plataforma.
    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // ---- Rankings da plataforma (ELO, 2.0–8.0 e duplas) ------------------
    // Materializados pelo SERVIDOR, e só por ele: `functions/platformRankings.js`
    // grava os três na mesma passada, a cada resultado publicado (gatilhos) e
    // pela recuperação agendada (`catchUpPlatformRankings`). A Cloud Function
    // usa o Admin SDK e não passa por estas regras — por isso a escrita do
    // cliente é recusada para TODO MUNDO, inclusive o admin da plataforma.
    //
    // 🐞 Por que fechar até para o admin (2026-09-24): o navegador do admin
    // recalculava o ELO e as duplas a cada visita, mas nunca o 2.0–8.0. Com as
    // funções apagadas por outro app do mesmo projeto Firebase, dois rankings
    // andavam e o terceiro não — três rankings discordando entre si. Uma aba
    // aberta numa versão antiga do aplicativo continuaria fazendo isso; a
    // regra é o que garante UM escritor só. Ver docs/18-RANKINGS.md §8.
    //
    // Leitura pública (as páginas /ranking e /ranking/duplas são abertas).
    // Nenhum dado pessoal além do que o ranking já expõe: nome público e foto.
    match /player_ratings/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /player_skill_ratings/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /skill_rating_history/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /doubles_rankings/{pairKey} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Wave C.3 — Ranking interno do clube (materializado) ----
    // Cada clube tem 4 coleções materializadas pelo Cloud Function
    // `recomputeClubInternalRankings`:
    //   - club_internal_ratings / club_internal_ratings_ext
    //   - club_internal_doubles_ratings / club_internal_doubles_ratings_ext
    // Cada documento tem `id = ${clubId}_${userId|pairKey}` e
    // `club_id` para queries. Read público (faz parte do clube
    // visível para os membros). Write só do admin do clube + platform
    // admin — o Cloud Function roda com service account (admin SDK,
    // ignora regras) e o `isPlatformAdmin()` cobre a escrita manual.
    match /club_internal_ratings/{docId} {
      allow read: if true;
      allow write: if isAuthed() && (
        isPlatformAdmin()
        || (resource != null && clubOd())
        || (request.resource != null && isClubAdmin(nd().club_id))
      );
    }
    match /club_internal_ratings_ext/{docId} {
      allow read: if true;
      allow write: if isAuthed() && (
        isPlatformAdmin()
        || (resource != null && clubOd())
        || (request.resource != null && isClubAdmin(nd().club_id))
      );
    }
    match /club_internal_doubles_ratings/{docId} {
      allow read: if true;
      allow write: if isAuthed() && (
        isPlatformAdmin()
        || (resource != null && clubOd())
        || (request.resource != null && isClubAdmin(nd().club_id))
      );
    }
    match /club_internal_doubles_ratings_ext/{docId} {
      allow read: if true;
      allow write: if isAuthed() && (
        isPlatformAdmin()
        || (resource != null && clubOd())
        || (request.resource != null && isClubAdmin(nd().club_id))
      );
    }

    // Histórico de rating ELO. Leitura pública; escrita só do SERVIDOR (ver
    // "Rankings da plataforma", acima).
    match /rating_history/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Metas pessoais do jogador (id uid_goalId). Apenas o próprio dono.
    match /player_goals/{id} {
      allow read: if isOwner(od().uid);
      allow create: if isOwner(nd().uid);
      allow update, delete: if isOwner(od().uid);
    }

    // ---- Galeria de fotos do torneio -------------------------------------
    // Leitura pública (aparece na visão de espectador). Envio/remoção só por
    // admin do torneio (ou admin master).
    match /tournament_photos/{id} {
      allow read: if true;
      allow create: if isTournamentAdmin(nd().tournament_id) || isPlatformAdmin();
      allow delete: if (od().tournament_id != null
        && isTournamentAdmin(od().tournament_id)) || isPlatformAdmin();
    }

    // ---- Seguir atletas --------------------------------------------------
    // Id determinista followerUid_targetUid. Leitura por autenticados; criar/
    // remover apenas o próprio seguidor.
    match /follows/{id} {
      allow read: if isAuthed();
      allow create: if isOwner(nd().follower_uid);
      allow delete: if isOwner(od().follower_uid);
    }

    // ---- Procura-se jogo (partidas sociais abertas) ----------------------
    // Mural de convites. Leitura por autenticados; criação pelo próprio autor;
    // edição/remoção só do autor (ou admin master).
    match /open_games/{gameId} {
      allow read: if isAuthed();
      allow create: if isOwner(nd().created_by);
      allow update, delete: if isAuthed()
        && (od().created_by == me() || isPlatformAdmin());
    }

    // ---- Consentimento aos documentos legais (legal_consents) -------------
    // Registro do aceite dos documentos jurídicos, id determinístico
    // `${uid}_${docKey}`. Cada usuário lê/grava apenas o próprio consentimento;
    // o platform admin pode ler (auditoria). ADITIVO.
    match /legal_consents/{consentId} {
      allow read: if isAuthed()
        && (od().user_id == me() || isPlatformAdmin());
      // A prova de aceite é de quem aceitou: o update confere o dono ATUAL.
      allow create: if isAuthed()
        && nd().user_id == me();
      allow update: if isAuthed()
        && od().user_id == me()
        && nd().user_id == me();
      allow delete: if isPlatformAdmin();
    }

    // ---- Tokens de push (push_tokens) ------------------------------------
    // Opt-in de notificações push (PWA/FCM). Cada usuário lê/grava/apaga
    // apenas os próprios tokens; o platform admin pode ler (suporte). O envio
    // é feito por Cloud Function (Admin SDK, ignora regras). ADITIVO.
    match /push_tokens/{tokenId} {
      allow read: if isAuthed()
        && (od().user_id == me() || isPlatformAdmin());
      allow create, update: if isAuthed()
        && nd().user_id == me();
      allow delete: if isAuthed()
        && od().user_id == me();
    }

    // ---- Dia de jogo do atleta (game_days) -------------------------------
    // Dia de jogo criado por um atleta (público ou privado por convite). O
    // criador gerencia tudo; membros (convidados/que entraram pelo convite) e
    // qualquer um (se público) podem ver. ADITIVO.
    match /game_days/{gdId} {
      allow read: if isAuthed() && (
        od().created_by == me()
        || (me() in od().member_uids)
        || od().visibility == 'public'
        // Dia de jogo de CLUBE: quem é do clube vê. Lê `resource.data` (o
        // próprio documento já carregado) em vez de `isClubGameDayMemberOf`,
        // que faria um `get` a mais do mesmo documento.
        || ('club_id' in od() && od().club_id is string
            && isClubMember(od().club_id))
        || isPlatformAdmin()
      );
      // Dia de ARENA só quem gere a arena cria, e dia de CLUBE só quem é do
      // clube: sem isso qualquer conta criava um dia "da arena X" com as
      // quadras do dia inteiro — o calendário da arena fechava (o dia de jogo
      // vira bloqueio derivado) e o dia aparecia na página dela.
      allow create: if isOwner(nd().created_by)
        && (nd().get('arena_id', null) == null
            || arenaNd() || isPlatformAdmin())
        && (nd().get('club_id', null) == null
            || isClubMember(nd().club_id) || isPlatformAdmin());
      // Edição plena pelo criador/admin. Um atleta pode se auto-incluir como
      // membro quando o dia de jogo é público (fluxo "participar"), sem alterar
      // o dono.
      allow update: if isAuthed() && (
        // O criador não troca a arena nem o clube do dia (pelo mesmo motivo
        // da criação).
        (od().created_by == me()
          && nd().get('arena_id', null) == od().get('arena_id', null)
          && nd().get('club_id', null) == od().get('club_id', null))
        || isPlatformAdmin()
        // Dia de jogo de ARENA: quem gerencia a arena configura o dia todo
        // (título, data, quadras, horários, limites, modo de gestão). A arena
        // é a dona do evento — amarrá-lo a uma pessoa deixaria o dia órfão
        // quando ela saísse da equipe.
        || isArenaGameDayManagerOf(gdId)
        // Dia de jogo de CLUBE: quem administra o clube configura o dia todo,
        // pela mesma razão da arena — o dia é do clube, não de quem agendou.
        || isClubGameDayManagerOf(gdId)
        // ENTRAR num dia de jogo público. A condição é EXATA: a lista nova
        // tem de ser a antiga MAIS quem está pedindo. Antes bastava "eu estou
        // na lista nova", o que deixava qualquer membro reescrever a lista e
        // remover os outros de tabela. Os fluxos legítimos que acrescentam
        // TERCEIROS (o dono inserindo, o administrador inserindo) passam pelas
        // outras condições deste mesmo `allow update`, então nada que
        // funcionava deixa de funcionar.
        || (
          od().visibility == 'public'
          && nd().created_by == od().created_by
          && chg()
              .hasOnly(['member_uids', 'invited_uids', 'updated_at', 'open_game_id'])
          && nd().member_uids.toSet()
              == od().member_uids.toSet().union([me()].toSet())
        )
        // ...e o caminho de VOLTA, que faltava: sair de um dia de jogo
        // público. Ao remover o participante, o serviço recalcula
        // `member_uids` — e a lista nova, naturalmente, não tem mais quem
        // saiu, o que reprovava na condição acima. Resultado: a inscrição
        // era removida e a associação ficava, com erro na tela.
        // A condição é EXATA: a lista nova tem de ser a antiga menos quem
        // está pedindo. Assim ninguém aproveita a brecha para esvaziar a
        // lista dos outros.
        || (
          od().visibility == 'public'
          && nd().created_by == od().created_by
          && chg()
              .hasOnly(['member_uids', 'updated_at'])
          && nd().member_uids.toSet()
              == od().member_uids.toSet().difference([me()].toSet())
        )
        // O MEMBRO DO CLUBE entrando e saindo do dia de jogo do seu clube. É o
        // mesmo par de condições EXATAS do dia público logo acima, e pela
        // mesma razão: a lista nova tem de ser a antiga mais (ou menos)
        // exatamente quem está pedindo, senão "entrar" viraria brecha para
        // reescrever a lista dos outros.
        || (
          'club_id' in od() && od().club_id is string
          && isClubMember(od().club_id)
          && nd().created_by == od().created_by
          && chg()
              .hasOnly(['member_uids', 'invited_uids', 'updated_at'])
          && nd().member_uids.toSet()
              == od().member_uids.toSet().union([me()].toSet())
        )
        || (
          'club_id' in od() && od().club_id is string
          && isClubMember(od().club_id)
          && nd().created_by == od().created_by
          && chg()
              .hasOnly(['member_uids', 'updated_at'])
          && nd().member_uids.toSet()
              == od().member_uids.toSet().difference([me()].toSet())
        )
        // Quem gerencia (admin nomeado, ou participante num dia aberto) mexe na
        // LISTA DE MEMBROS ao inserir/remover participante — e SÓ nela. A trava
        // por campo é o que impede alguém de, por tabela, virar dono, se
        // autonomear administrador ou reabrir a gestão do dia.
        || (
          canManageGameDayOf(gdId)
          && chg()
              .hasOnly(['member_uids', 'invited_uids', 'updated_at'])
        )
        // GRUPOS DO PLAY (flag `play_groups`): o administrador NOMEADO edita os
        // grupos como o criador — é a única configuração do dia que ele divide
        // com o criador, porque os grupos são parte de conduzir o dia (quem
        // joga com quem), não de defini-lo. A condição é ESTREITA de propósito:
        //  · só quem está em `admin_uids` (o participante de um dia aberto
        //    opera, mas não edita os grupos);
        //  · só no formato Play;
        //  · só as duas chaves dos grupos (e `updated_at`) — nada de `created_by`,
        //    `admin_uids`, `manage_mode`, `title` ou `status`;
        //  · com o tamanho e a política conferidos, para um nomeado nunca gravar
        //    lixo no documento (o criador continua livre, como sempre foi).
        // Sem `admin_uids`, ou fora do Play, a condição é sempre falsa e nenhum
        // dia de jogo já existente muda de comportamento.
        || (
          od().format == 'play'
          && 'admin_uids' in od()
          && od().admin_uids is list
          && (me() in od().admin_uids)
          && nd().created_by == od().created_by
          && chg()
              .hasOnly(['play_groups', 'play_groups_policy', 'updated_at'])
          && (!('play_groups' in nd())
              || (nd().play_groups is list
                  && nd().play_groups.size() <= 10))
          && (!('play_groups_policy' in nd())
              || nd().play_groups_policy in ['queue', 'rotate', 'priority'])
        )
      );
      allow delete: if isAuthed() && (
        od().created_by == me()
        || isArenaGameDayManagerOf(gdId)
        || isClubGameDayManagerOf(gdId)
        || isPlatformAdmin()
      );

      match /participants/{pid} {
        allow read: if canAccessGameDay(gdId);
        // O criador insere qualquer participante; um atleta pode se inserir
        // quando o dia de jogo é público (participar).
        allow create: if isAuthed() && (
          isGameDayOwnerOf(gdId)
          || canManageGameDayOf(gdId)
          || (gameDayIsPublic(gdId) && nd().user_id == me())
          // Dia de jogo de CLUBE: o membro do clube marca a PRÓPRIA presença.
          // É o que ele já podia no evento legado (a regra de
          // `club_events/{id}/participants` libera qualquer membro). Note o
          // `user_id == uid`: ele entra sozinho, não inscreve terceiros.
          || (isClubGameDayMemberOf(gdId) && nd().user_id == me())
        );
        // O criador atualiza qualquer participante; no Play, qualquer membro
        // também pode (controle de participação e substituição de ausentes);
        // e quem gerencia o dia, em qualquer formato.
        allow update: if isGameDayOwnerOf(gdId)
          || canManageGameDayOf(gdId)
          || isPlayGameDayMember(gdId);
        // O criador remove qualquer um; quem gerencia também; e o atleta pode
        // sempre remover a própria entrada.
        allow delete: if isAuthed() && (
          isGameDayOwnerOf(gdId)
          || canManageGameDayOf(gdId)
          || od().user_id == me()
        );
      }

      match /games/{gid} {
        allow read: if canAccessGameDay(gdId);
        // O criador gerencia os jogos; quem ele autorizou também (admin nomeado
        // ou participante, num dia aberto); e no Play qualquer membro, como já
        // era antes de existir o modo de gestão.
        allow create, update, delete: if isGameDayOwnerOf(gdId)
          || canManageGameDayOf(gdId)
          || isPlayGameDayMember(gdId);
      }
    }

    // ---- Afiliados e parcerias -------------------------------------------
    // Catálogo de links de afiliado/patrocinadores. Leitura pública (a página
    // de parceiros é aberta). Escrita só do admin master.
    match /affiliate_links/{linkId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // ---- Arenas -----------------------------------------------------------
    // Diretório de arenas/quadras. Leitura pública (a página da arena é
    // compartilhável por QR). Criação pelo próprio dono; edição/exclusão pelos
    // gestores (ou admin master).
    match /arenas/{arenaId} {
      allow read: if true;
      allow create: if isOwner(nd().owner_id);
      // O gestor edita a arena, mas o DONO só muda pelo próprio dono (senão o
      // gestor se tornava dono e passava a poder apagá-la).
      allow update: if isPlatformAdmin()
        || (isArenaManager(arenaId)
            && (nd().get('owner_id', null) == od().get('owner_id', null)
                || od().get('owner_id', null) == me()));
      allow delete: if (isOwner(od().owner_id)) || isPlatformAdmin();
    }
    // Gestores da arena (id determinístico arenaId_uid). O criador registra a si
    // mesmo como dono; gestores existentes adicionam outros; cada um pode sair.
    match /arena_managers/{docId} {
      allow read: if true;
      allow create: if isAuthed()
        && nd().arena_id is string
        && nd().user_id is string
        && docId == nd().arena_id + '_' + nd().user_id
        && (
          // Primeiro gestor: só o dono gravado no documento da arena registra a
          // si mesmo como OWNER. Sem isto, qualquer conta cria vínculo na arena
          // alheia e vira gestora.
          (
            nd().user_id == me()
            && nd().role == 'owner'
            && getAfter(/databases/$(database)/documents/arenas/$(nd().arena_id)).data.owner_id == me()
          )
          || arenaNd()
          || isPlatformAdmin()
        );
      allow update: if isPlatformAdmin()
        || (arenaOd()
            && nd().arena_id == od().arena_id
            && nd().user_id == od().user_id
            && (od().get('role', '') != 'owner'
                || nd().get('role', '') == 'owner'
                || od().user_id == me()));
      // O vínculo do DONO só sai pelo próprio dono (ou pelo admin): outro
      // gestor não o tira da arena.
      allow delete: if isAuthed() && (
        od().user_id == me()
        || (arenaOd() && od().get('role', '') != 'owner')
        || isPlatformAdmin());
    }
    // Reservas: legíveis/gerenciáveis pelo atleta solicitante e pelos gestores
    // da arena. Criação só pelo próprio atleta.
    // O que o lado do CLIENTE (titular, participante, professor) pode mudar
    // numa reserva. A arena é que confirma e recebe: o cliente não troca a
    // arena, não marca pagamento e só CONFIRMA aceitando a proposta da arena
    // (status "em negociação", proposta feita pela arena, valor = proposta).
    // Alterar o horário devolve a reserva a "pedida" (zera valor e pagamento).
    function bookingClientUpdateOk() {
      let antes = od();
      let depois = nd();
      return depois.arena_id == antes.arena_id
        && (depois.get('payment_status', 'none') == antes.get('payment_status', 'none')
            || depois.get('payment_status', 'none') == 'none')
        && depois.get('proposed_by', '') in [antes.get('proposed_by', ''), 'athlete']
        && (depois.get('proposed_price', null) == antes.get('proposed_price', null)
            || depois.get('proposed_by', '') == 'athlete')
        // Quem só está ENTRANDO numa reserva aberta mexe só na lista.
        && (me() == antes.get('athlete_id', null)
            || me() in antes.get('participant_ids', [])
            || me() in antes.get('invited_ids', [])
            || me() == antes.get('coach_id', null)
            || depois.diff(antes).affectedKeys()
                .hasOnly(['participants', 'participant_ids', 'invited_ids', 'updated_at']))
        && (
          (depois.get('status', '') == antes.get('status', '')
            && depois.get('agreed_price', null) == antes.get('agreed_price', null))
          || depois.status == 'cancelled'
          || (depois.status == 'negotiating'
            && antes.get('status', '') in ['requested', 'negotiating']
            && depois.get('proposed_by', '') == 'athlete'
            && depois.get('agreed_price', null) == antes.get('agreed_price', null))
          || (depois.status == 'requested'
            && antes.get('status', '') in ['requested', 'negotiating', 'confirmed']
            && depois.get('agreed_price', null) == null)
          || (depois.status == 'confirmed'
            && antes.get('status', '') == 'negotiating'
            && antes.get('proposed_by', 'arena') == 'arena'
            && depois.get('agreed_price', null) == antes.get('proposed_price', null))
        );
    }
    match /arena_bookings/{bookingId} {
      // Lê: dono original, participantes (aceitos e convidados), o professor
      // (coach_id), qualquer autenticado numa reserva ABERTA (para ingressar),
      // o gestor da arena e o admin.
      allow read: if isAuthed() && (
        od().athlete_id == me()
        || me() in od().get('participant_ids', [])
        || me() in od().get('invited_ids', [])
        || od().get('coach_id', null) == me()
        || od().get('open_join', false) == true
        || arenaOd()
        || isPlatformAdmin());
      // Cria: o próprio atleta, o professor (coach_id), o gestor (reserva
      // manual, athlete_id pode ser null) ou o admin.
      allow create: if isAuthed() && (
        nd().athlete_id == me()
        || nd().get('coach_id', null) == me()
        || arenaNd()
        || isPlatformAdmin())
        && bookingReferralOkOnCreate()
        // Quem não opera a arena só PEDE: nasce pedida (ou confirmada quando a
        // arena aceita reserva instantânea), sem valor acordado e sem
        // pagamento. Antes dava para gravar a reserva já confirmada e paga.
        && (arenaNd() || isPlatformAdmin()
          || (nd().get('agreed_price', null) == null
            && nd().get('payment_status', 'none') == 'none'
            && (nd().get('status', 'requested') == 'requested'
              || (nd().status == 'confirmed'
                && get(/databases/$(database)/documents/arenas/$(nd().arena_id)).data.get('allow_instant_booking', false) == true))));
      // Atualiza/exclui: dono original, participantes (aceitos e convidados —
      // o convidado aceita/recusa), o professor, quem está ingressando numa
      // reserva aberta (aparece nos novos participant_ids), o gestor e o admin.
      allow update: if isAuthed() && (
        od().athlete_id == me()
        || me() in od().get('participant_ids', [])
        || me() in od().get('invited_ids', [])
        || od().get('coach_id', null) == me()
        || (od().get('open_join', false) == true
            && me() in nd().get('participant_ids', []))
        || arenaOd()
        || isPlatformAdmin())
        // A indicação da reserva só a ARENA decide (Onda BY): ninguém mais
        // altera `referral` depois do pedido. (Só no update: num delete não há
        // `request.resource`, e a condição recusaria toda exclusão.)
        && (nd().get('referral', null) == od().get('referral', null)
            || arenaOd()
            || isPlatformAdmin())
        && (arenaOd() || isPlatformAdmin() || bookingClientUpdateOk());
      allow delete: if isAuthed() && (
        od().athlete_id == me()
        || me() in od().get('participant_ids', [])
        || me() in od().get('invited_ids', [])
        || od().get('coach_id', null) == me()
        || arenaOd()
        || isPlatformAdmin());
    }
    // Avaliações/reclamações/sugestões — leitura pública; cada um cria/edita as
    // suas; a própria arena e o admin podem remover.
    match /arena_reviews/{reviewId} {
      allow read: if true;
      allow create: if isOwner(nd().user_id);
      // O autor edita a SUA avaliação (antes bastava gravar `user_id: eu` para
      // reescrever a de outra pessoa). 🐞 E a arena responde: a regra só
      // olhava o autor, e "Responder avaliação" era recusado para o gestor.
      allow update: if isAuthed() && (
        (od().user_id == me()
          && nd().user_id == od().user_id
          && nd().arena_id == od().arena_id)
        || ((arenaOd() || isPlatformAdmin())
          && chg()
              .hasOnly(['response', 'responded_at', 'responded_by', 'updated_at']))
      );
      allow delete: if isAuthed() && (
        od().user_id == me()
        || arenaOd()
        || isPlatformAdmin());
    }
    // Favoritos do atleta (id determinístico uid_arenaId) — só o próprio dono.
    match /arena_favorites/{docId} {
      allow read: if isOwner(od().user_id);
      allow create: if isOwner(nd().user_id);
      allow delete: if isOwner(od().user_id);
    }
    // Lista de espera de reservas (flag booking_waitlist). Coleção própria,
    // separada do arena_waitlist do matchmaking (Arena V3). O atleta cria/remove
    // a própria entrada; o gestor da arena lê e pode remover (ao promover/atender).
    match /booking_waitlist/{docId} {
      allow read: if isAuthed() && (
        od().user_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
      allow create: if isOwner(nd().user_id);
      allow delete: if isAuthed() && (
        od().user_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
    }
    // Quadras da arena (Sprint 1, ARE-01). Leitura pública (atletas
    // precisam ver as quadras ativas pra reservar); escrita só por
    // gestores da arena + platform admin.
    match /arena_courts/{courtId} {
      allow read: if true;
      allow create: if isAuthed() && (
        arenaNd() || isPlatformAdmin()
      );
      // A arena do documento ATUAL decide, e ela não muda: conferir só a nova
      // deixava o gestor da arena A puxar o documento da arena B para a sua.
      allow update: if isAuthed() && (
        (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin()
      );
      allow delete: if isAuthed() && (
        arenaOd() || isPlatformAdmin()
      );
    }
    // Janelas de horário recorrentes (Sprint 1, ARE-04). Mesma regra
    // de leitura pública que quadras; escrita só por manager+admin.
    match /arena_court_schedules/{scheduleId} {
      allow read: if true;
      allow create: if isAuthed() && (
        arenaNd() || isPlatformAdmin()
      );
      // A arena do documento ATUAL decide, e ela não muda: conferir só a nova
      // deixava o gestor da arena A puxar o documento da arena B para a sua.
      allow update: if isAuthed() && (
        (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin()
      );
      allow delete: if isAuthed() && (
        arenaOd() || isPlatformAdmin()
      );
    }

    // ---- Arena V3 (sprint 0+) -------------------------------------------
    // Settings da arena (1:1 com arenas/{id}). Leitura/escrita só por
    // gestores da arena + platform admin.
    match /arena_settings/{arenaId} {
      allow read: if isAuthed() && (isArenaManager(arenaId) || isPlatformAdmin());
      allow create, update: if isAuthed() && (isArenaManager(arenaId) || isPlatformAdmin());
      allow delete: if isPlatformAdmin();
    }
    // Estado dos módulos opt-in por arena. Doc id: {arenaId}_{moduleId}.
    // Leitura pública (atletas precisam saber o que a arena oferece).
    // Escrita só por gestores da arena + platform admin.
    match /arena_module_states/{docId} {
      allow read: if true;
      allow create: if isAuthed() && (
        arenaNd() || isPlatformAdmin()
      )
        && docId == nd().arena_id + '_' + nd().module_id;
      // A arena do documento ATUAL decide, e ela não muda: conferir só a nova
      // deixava o gestor da arena A puxar o documento da arena B para a sua.
      allow update: if isAuthed() && (
        (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin()
      );
      allow delete: if isAuthed() && (
        arenaOd() || isPlatformAdmin()
      );
    }
    // Open Match slots (sprint 1) — vagas abertas publicadas pela arena.
    match /arena_open_slots/{slotId} {
      allow read: if true;
      allow create: if isAuthed() && (
        arenaNd() || isPlatformAdmin()
      );
      allow update: if isAuthed() && (
        (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin()
        || openSlotSelfJoinLeave()
      );
      allow delete: if isAuthed() && (
        arenaOd() || isPlatformAdmin()
      );

      // 🐞 O ATLETA entra e sai do jogo aberto (2026-09-24). Entrar grava
      // `participants` no próprio documento da vaga, e a atualização era só da
      // arena: o botão "Quero jogar" existia e NUNCA funcionou — nem entrar,
      // nem sair, nem aceitar a vaga da fila. Mesmo desenho do dia de jogo e
      // do torneio da casa: a pessoa só entra ou sai A SI MESMA, com a vaga de
      // pé, sem passar do número de lugares, e o que se grava tem de bater
      // (contagem = lista; "lotado" só quando lotou).
      function openSlotSelfJoinLeave() {
        return od().get('status', 'open') in ['open', 'full']
          && chg()
              .hasOnly(['participants', 'filled_spots', 'status', 'updated_at'])
          && nd().get('status', 'open') in ['open', 'full']
          && nd().get('filled_spots', 0) == nd().participants.size()
          && ((nd().get('status', 'open') == 'full')
              == (nd().participants.size() >= od().get('total_spots', 0)))
          && (
            (!(me() in od().get('participants', []))
              && nd().participants.toSet()
                  == od().get('participants', []).toSet().union([me()].toSet())
              && nd().participants.size() <= od().get('total_spots', 0))
            || ((me() in od().get('participants', []))
              && nd().participants.toSet()
                  == od().get('participants', []).toSet().difference([me()].toSet()))
          );
      }
    }
    // Waitlist (sprint 1) — fila de espera por slot.
    match /arena_waitlist/{waitlistId} {
      // Leitura por quem tem conta (2026-09-24). 🐞 Era só a própria entrada
      // e a arena: para entrar na fila o atleta precisa saber quantos estão
      // na frente, e a consulta da fila da vaga era recusada — ENTRAR NA FILA
      // NUNCA FUNCIONOU. A entrada guarda nome e posição (o mesmo nível de
      // exposição da lista de quem está na vaga, que é pública); nenhum
      // contato, nenhum dado pessoal sensível.
      allow read: if isAuthed();
      // Em nome próprio, no fim da fila — nunca já "chamado" (furar a fila) —,
      // uma entrada por pessoa por vaga, e na arena DA VAGA.
      allow create: if isAuthed()
        && nd().athlete_id == me()
        && nd().get('status', 'waiting') == 'waiting'
        && waitlistId == nd().slot_id + '_' + me()
        && get(/databases/$(database)/documents/arena_open_slots/$(nd().slot_id)).data.arena_id
            == nd().arena_id;
      // A arena mexe em tudo; o atleta só RESPONDE à própria chamada (aceitar
      // ou recusar) — antes nem isso, e a vaga ficava presa até o prazo.
      allow update: if isAuthed() && (
        arenaOd() || isPlatformAdmin()
        || (od().athlete_id == me()
          && od().get('status', 'waiting') == 'notified'
          && nd().get('status', '') in ['accepted', 'declined']
          && chg()
              .hasOnly(['status', 'accepted_at', 'declined_at', 'updated_at']))
      );
      allow delete: if isAuthed() && (
        od().athlete_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
    }
    // Members (sprint 2) — relação atleta-arena.
    match /arena_members/{docId} {
      allow read: if isAuthed() && (
        od().user_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
      allow get: if canGetMissingArenaUserDoc(docId);
      allow create: if isAuthed() && (
        arenaNd() || isPlatformAdmin()
      )
        && docId == nd().arena_id + '_' + nd().user_id;
      // A arena do documento ATUAL decide, e ela não muda: conferir só a nova
      // deixava o gestor da arena A puxar o documento da arena B para a sua.
      allow update: if isAuthed() && (
        (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin()
      );
      allow delete: if isAuthed() && (
        od().user_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
    }
    // Packages (sprint 2) — pacotes pré-pagos. Leitura pública (catálogo).
    match /arena_packages/{pkgId} {
      allow read: if true;
      allow create: if isAuthed() && (
        arenaNd() || isPlatformAdmin()
      );
      // A arena do documento ATUAL decide, e ela não muda: conferir só a nova
      // deixava o gestor da arena A puxar o documento da arena B para a sua.
      allow update: if isAuthed() && (
        (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin()
      );
      allow delete: if isAuthed() && (
        arenaOd() || isPlatformAdmin()
      );
    }
    // Wallets (sprint 2) — wallet do atleta na arena.
    match /arena_wallets/{docId} {
      allow read: if isAuthed() && (
        od().user_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
      allow get: if canGetMissingArenaUserDoc(docId);
      allow create: if isAuthed() && (
        arenaNd() || isPlatformAdmin()
      )
        && docId == nd().arena_id + '_' + nd().user_id;
      // A arena do documento ATUAL decide, e ela não muda: conferir só a nova
      // deixava o gestor da arena A puxar o documento da arena B para a sua.
      allow update: if isAuthed() && (
        (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin()
      );
      allow delete: if isPlatformAdmin();
    }
    // Subscriptions (sprint 2) — mensalidades.
    match /arena_subscriptions/{subId} {
      allow read: if isAuthed() && (
        od().user_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
      allow get: if canGetMissingArenaUserDoc(subId);
      allow create: if isAuthed() && (
        arenaNd() || isPlatformAdmin()
      )
        && subId == nd().arena_id + '_' + nd().user_id;
      // A arena do documento ATUAL decide, e ela não muda: conferir só a nova
      // deixava o gestor da arena A puxar o documento da arena B para a sua.
      allow update: if isAuthed() && (
        (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin()
      );
      allow delete: if isPlatformAdmin();
    }
    // Products (sprint 3) — catálogo PDV.
    match /arena_products/{prodId} {
      allow read: if true;
      allow create: if isAuthed() && (
        arenaNd() || isPlatformAdmin()
      );
      // A arena do documento ATUAL decide, e ela não muda: conferir só a nova
      // deixava o gestor da arena A puxar o documento da arena B para a sua.
      allow update: if isAuthed() && (
        (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin()
      );
      allow delete: if isAuthed() && (
        arenaOd() || isPlatformAdmin()
      );
    }
    // Sales (sprint 3) — vendas / pedidos da loja do app.
    match /arena_sales/{saleId} {
      // 🐞 Quem DIVIDE a conta sem ser o comprador não lia a venda: não via
      // a própria parte e `payMyShare` quebrava no primeiro `getDoc`. Agora
      // lê quem está em `split_with` (e a consulta `array-contains` por esse
      // campo é provável pela regra).
      allow read: if isAuthed() && (
        od().buyer_id == me()
        || arenaOd()
        || isPlatformAdmin()
        || me() in od().get('split_with', [])
      );
      // Antes: `if isAuthed()` — qualquer conta forjava venda em QUALQUER
      // arena, com qualquer valor. Agora a venda é do próprio comprador ou de
      // quem opera a arena. E o comprador só cria o pedido como PEDIDO: em
      // aberto e não entregue — antes dava para gravar a venda já "paga" e
      // "entregue", e ela entrava no caixa e nos números da arena assim.
      allow create: if isAuthed() && (
        arenaNd()
        || isPlatformAdmin()
        || (nd().buyer_id == me()
            && nd().get('status', 'pending') == 'pending'
            && nd().get('stock_applied', false) == false)
      );
      // Quem pediu pode DESISTIR — só isso, e só enquanto o pedido está em
      // aberto, não foi entregue e não é dividido (conta dividida pode ter
      // parte paga por outra pessoa: essa se cancela no balcão).
      allow update: if isAuthed() && (
        arenaOd()
        || isPlatformAdmin()
        || (od().buyer_id == me()
            && od().get('status', 'pending') == 'pending'
            && od().get('stock_applied', false) == false
            && od().get('split_with', []).size() <= 1
            && nd().status == 'cancelled'
            && nd().get('cancelled_by', me()) == me()
            && chg()
                 .hasOnly(['status', 'cancel_reason', 'cancelled_by', 'updated_at']))
      );
      allow delete: if isAuthed() && (
        arenaOd() || isPlatformAdmin()
      );
    }
    // Payments (sprint 3).
    match /arena_payments/{paymentId} {
      allow read: if isAuthed() && (
        od().payer_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
      // Idem `arena_sales`: o pagamento é de quem paga, ou da arena. Quem paga
      // registra a parte como PENDENTE (quem confirma o recebimento é a
      // arena) e só numa venda de que faz parte, da MESMA arena — senão
      // qualquer conta semeava "pagamentos" na lista de qualquer arena.
      allow create: if isAuthed() && (
        arenaNd()
        || isPlatformAdmin()
        || (nd().payer_id == me()
            && nd().get('status', 'pending') == 'pending'
            && paymentBelongsToSale(nd()))
      );
      // 🐞 Quem paga podia atualizar o próprio pagamento para "pago" — o
      // registro que a arena usa para saber se recebeu. Agora ele só troca a
      // forma de pagamento ou desiste (cancela) enquanto o pagamento não foi
      // confirmado; "pago" é a arena quem marca.
      allow update: if isAuthed() && (
        arenaOd()
        || isPlatformAdmin()
        || (od().payer_id == me()
            && od().get('status', 'pending') != 'paid'
            && nd().get('status', 'pending') in ['pending', 'cancelled']
            && chg()
                 .hasOnly(['payment_method', 'status', 'updated_at']))
      );
      allow delete: if isPlatformAdmin();
    }

    // ---- Users -----------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isPlatformAdmin();

      // ⚠️ SEGURANÇA — CAMPOS DE PODER (`role`, `can_create_pools`) e de
      // MODERAÇÃO (`hidden*`) NUNCA podem ser escritos pelo próprio usuário.
      // `isPlatformAdmin()` é decidido lendo `users/{uid}.role`; se o dono do
      // documento pudesse escrever esse campo, qualquer conta se promoveria a
      // platform_admin e leria/apagaria a base inteira. O dono da plataforma é
      // reconhecido pelo e-mail do TOKEN de autenticação (não por dado
      // gravável), o que preserva o bootstrap do admin em FirebaseAuthContext
      // e a restauração em V2AdminOwnerRestore.

      // Criação no primeiro login: nasce sempre como usuário comum.
      allow create: if isOwner(userId) && (
        isPlatformOwnerEmail()
        || (
          nd().get('role', 'user') == 'user'
          && nd().get('can_create_pools', false) == false
          && !nd().keys().hasAny(['hidden', 'hidden_at', 'hidden_by'])
          // Ninguém nasce suspenso nem "se reativa" criando o documento de novo.
          && !nd().keys().hasAny(['account_status', 'status_reason', 'status_until', 'status_set_at', 'status_set_by'])
          // O número CONFIRMADO do celular só o servidor grava (código por SMS).
          && !nd().keys().hasAny(['phone_verified_number', 'phone_verified_at'])
          // O SELO "DUPR verificado" só o servidor concede (`duprIntegration`).
          && !nd().keys().hasAny(['dupr_verified', 'dupr_verified_at_ms'])
        )
      );

      // Atualização:
      //  1) o dono edita o próprio perfil, SEM tocar em poder nem moderação;
      //  2) o dono da plataforma (e-mail do token) faz bootstrap/restauração;
      //  3) o platform_admin altera SOMENTE os campos de ocultar/reexibir
      //     atleta (moderação), sem tocar em nenhum outro dado do usuário.
      allow update: if
        (
          isOwner(userId)
          && nd().get('role', 'user')
               == od().get('role', 'user')
          && nd().get('can_create_pools', false)
               == od().get('can_create_pools', false)
          && !chg()
                .hasAny(['hidden', 'hidden_at', 'hidden_by'])
          // SUSPENSÃO/BLOQUEIO (`account_status*`): só o servidor escreve
          // (`adminSetAccountStatus`). O titular suspenso não se reativa.
          && !chg()
                .hasAny(['account_status', 'status_reason', 'status_until', 'status_set_at', 'status_set_by'])
          // CELULAR CONFIRMADO: só o servidor (`messagingUser`, código por
          // SMS/WhatsApp). Gravado pelo dono, mandaria mensagem paga para o
          // número de outra pessoa.
          && !chg()
                .hasAny(['phone_verified_number', 'phone_verified_at'])
          // DUPR VERIFICADO: o selo é do servidor, e com ele o ID e os ratings
          // vêm do DUPR — o dono não os reescreve à mão (desvincular libera).
          && duprSeloIntacto()
        )
        || (isOwner(userId) && isPlatformOwnerEmail())
        || (isPlatformAdmin()
            && chg()
                 .hasOnly(['hidden', 'hidden_at', 'hidden_by', 'updated_at']))
        // CORREÇÃO DE CADASTRO pelo admin (aba Cadastros).
        //
        // O admin corrige dado ERRADO ou preenche o que FALTA. Lista fechada,
        // espelhada em `src/modules/admin/domain/adminUserEdit.js`. Três grupos
        // ficam de fora de propósito, e o `hasOnly` é o que garante isso:
        //
        //  · PODER (`role`, `can_create_pools`) — é o que a correção do P0-01
        //    fechou. Revogar tem caminho próprio; conceder é só pelo console.
        //  · PRIVACIDADE (`email_public`, `phone_public`, `address_public`,
        //    `directory_listed`) — é escolha do TITULAR. Admin corrigir um dado
        //    é uma coisa; decidir quem o vê é outra, e não é dele.
        //  · `email` — identidade de login, mora no Firebase Authentication.
        //
        // Uma escrita que misture campo permitido com proibido é recusada
        // INTEIRA (hasOnly), não parcialmente aplicada.
        || (isPlatformAdmin()
            && chg().hasOnly([
              'platform_name', 'full_name', 'birth_date', 'birth_date_at',
              'phone', 'gender', 'city', 'state', 'address',
              'pickleball_experience', 'competition_gender', 'court_side',
              'leveling_level', 'dupr_id', 'dupr_rating', 'photo_url',
              // Irmãos do nível: o formulário normal grava os quatro juntos.
              // Gravar só o código deixaria o texto exibido apontando para o
              // nível antigo — inclusive no espelho público.
              'level', 'leveling_method', 'leveling_manual_level',
              'updated_at', 'admin_edited_at', 'admin_edited_by',
            ]))
        // REVOGAÇÃO DE PODER — assimétrica de propósito.
        //
        // O dono da plataforma (e-mail do TOKEN, não dado gravável) pode
        // REMOVER o poder de outra conta pela própria aplicação. Nunca
        // CONCEDER: o resultado da escrita tem de ser obrigatoriamente
        // `role: 'user'` e `can_create_pools: false`. Não existe caminho, em
        // regra nenhuma, para promover alguém a platform_admin pelo cliente —
        // promover continua sendo só pelo console, de propósito.
        //
        // Por que abrir isto: sem ele, tirar o poder de uma conta indevida só
        // acontece no console do Firebase, onde a ação NÃO gera `audit_logs`.
        // Aqui gera. E como a permissão só reduz privilégio, uma conta de dono
        // comprometida não ganha nada que já não pudesse fazer.
        //
        // `request.auth.uid != userId` impede o dono de se auto-rebaixar sem
        // querer por este caminho (para isso existe o fluxo de restauração).
        || (isPlatformOwnerEmail()
            && me() != userId
            && nd().role == 'user'
            && nd().get('can_create_pools', false) == false
            && chg().hasOnly([
              'role', 'can_create_pools', 'updated_at',
              'role_revoked_at', 'role_revoked_by', 'role_previous',
            ]));

      allow delete: if isPlatformAdmin();
    }

    // ---- Tournaments -----------------------------------------------------
    match /tournaments/{tid} {
      // Leitura: pública se NÃO arquivado; se arquivado, só platform_admin
      // e criador continuam vendo (preserva histórico pra eles, esconde
      // da UI pública, das listas de torneio e da visão de espectador).
      allow read: if od().get('archived', false) != true
        || isPlatformAdmin()
        || isTournamentCreator(tid);
      // Sede: quem não gere a arena cria o torneio com a sede PENDENTE
      // (`arena_confirmed: false`) — a arena confirma ou recusa. Antes qualquer
      // conta punha o torneio na página e no ranking da casa de qualquer arena.
      allow create: if isOwner(nd().creator_uid)
        && tournamentArenaOk()
        && tournamentFederationOk();
      // Update: a regra antiga (platform_admin / tournament_admin / criador)
      // continua valendo para todos os campos. Para o campo 'archived'
      // especificamente:
      //  - só platform_admin ou criador podem alterá-lo (NÃO tournament_admin);
      //  - arquivar (archived: true) só é permitido se o status atual for
      //    'cancelled' (validação servidor — o service valida cliente-side).
      allow update: if (isPlatformAdmin() || isTournamentAdmin(tid)
        || (isOwner(od().creator_uid)))
        && (
          !chg().hasAny(['archived'])
          || (
            (isPlatformAdmin() || (isOwner(od().creator_uid)))
            && (!nd().archived || od().status == 'cancelled')
          )
        )
        // O co-administrador não se torna criador (que arquiva e apaga).
        && (isPlatformAdmin()
          || nd().get('creator_uid', null) == od().get('creator_uid', null))
        && (!chg().hasAny(['arena_id', 'arena_confirmed'])
          || tournamentArenaOk())
        // A chancela: o organizador só PEDE (pendente) ou retira — nunca se aprova.
        && (!chg().hasAny(['federation_id', 'federation_sanction'])
          || (tournamentFederationOk()
            // Aprovada, a chancela é decisão da federação: o organizador não a
            // retira nem a reabre como pendente (só a federação revoga).
            && (od().get('federation_sanction', null) == null
              || od().federation_sanction.get('status', '') != 'approved')))
        // A federação (competições) decide a chancela: aprova, recusa, revoga — e só ela.
        || (od().get('federation_id', null) is string
          && fedOn()
          && fedHas(od().federation_id, 'competitions')
          && chg().hasOnly(['federation_sanction', 'updated_at'])
          && nd().get('federation_id', null) == od().federation_id
          && nd().federation_sanction.status in ['approved', 'rejected', 'revoked'])
        // A arena decide sobre a sede: confirma, ou recusa (o torneio sai dela).
        || (od().get('arena_id', null) is string
          && arenaOd()
          && chg().hasOnly(['arena_id', 'arena_confirmed', 'updated_at'])
          && ((nd().get('arena_id', null) == od().arena_id
                && nd().get('arena_confirmed', false) == true)
            || (nd().get('arena_id', null) == null
                && nd().get('arena_confirmed', false) == false)));
      allow delete: if isPlatformAdmin()
        || (isOwner(od().creator_uid));
    }
    // Sem federação, ou o PEDIDO de chancela (pendente, por quem pede) a uma
    // federação aprovada com o módulo de torneios ligado. Aprovar é da federação.
    function tournamentFederationOk() {
      return isPlatformAdmin()
        || (nd().get('federation_id', null) == null
          && nd().get('federation_sanction', null) == null)
        || (nd().federation_id is string
          && fedOn()
          && fedModuleOn(nd().federation_id, 'tournaments')
          && fedPublic(nd().federation_id)
          && nd().federation_sanction.status == 'pending'
          && nd().federation_sanction.requested_by == me()
          // O que o servidor confere (prazo, diretor, taxa) o organizador não escreve.
          && !nd().federation_sanction.keys().hasAny(['checked_at_ms', 'director_uid', 'director_verified', 'fee_charge_id', 'fee_cents', 'fee_paid_at_ms', 'fee_cancelled_at_ms', 'director_name', 'director_credential_id', 'days_ahead']));
    }
    // Filiação ativa e sem suspensão DISCIPLINAR em vigor (PR 3) na federação.
    // Ativo, sem suspensão em vigor e — se a federação trava (`rules.block_expired_docs`) —
    // sem documento exigido vencido (`docs_block`, só o servidor grava).
    function fedMemberOk(fid, uid) {
      let p = /databases/$(database)/documents/federation_members/$(fid + '_' + uid);
      return exists(p) && get(p).data.status == 'active'
        && get(p).data.get('discipline_until_ms', 0) < request.time.toMillis()
        && get(p).data.get('docs_block', false) != true;
    }
    // O torneio exige filiação? Então a DUPLA inteira está em dia na federação dele:
    // quem se inscreve e o parceiro com conta. Parceiro sem conta não se prova
    // filiado — num torneio "só para filiados" ele não entra pela auto-inscrição
    // (o organizador inscreve quem quiser).
    function tournamentMembershipOk(tid) {
      let tdoc = get(/databases/$(database)/documents/tournaments/$(tid)).data;
      return tdoc.get('federation_id', null) == null
        || tdoc.get('federation_sanction', {}).get('status', '') != 'approved'
        || tdoc.get('federation_sanction', {}).get('requires_membership', false) != true
        || (fedMemberOk(tdoc.federation_id, me())
          && (nd().get('player_b_user_id', null) == null
            ? nd().get('player_b_name', '') == ''
            : (nd().player_b_user_id == me() || fedMemberOk(tdoc.federation_id, nd().player_b_user_id))));
    }
    // Sem sede, sede pendente, ou gerir a arena (o admin da plataforma também).
    function tournamentArenaOk() {
      return nd().get('arena_id', null) == null
        || nd().get('arena_confirmed', null) == false
        || isPlatformAdmin()
        || (nd().arena_id is string && arenaNd());
    }

    match /tournament_admins/{docId} {
      allow read: if isAuthed();
      // Owner cria o registro inicial dele próprio durante createTournament.
      allow create: if isAuthed()
        && nd().tournament_id is string
        && nd().user_id is string
        && docId == nd().tournament_id + '_' + nd().user_id
        && (
          // Primeiro admin: só o creator_uid gravado no torneio registra a si
          // mesmo como owner. Um usuário comum não pode criar o próprio doc de
          // admin em torneio alheio.
          (
            nd().user_id == me()
            && nd().role == 'owner'
            && getAfter(/databases/$(database)/documents/tournaments/$(nd().tournament_id)).data.creator_uid == me()
          )
          || isTournamentAdmin(nd().tournament_id)
          || isPlatformAdmin()
        );
      allow update, delete: if isPlatformAdmin()
        || isTournamentAdmin(od().tournament_id);
    }

    match /tournament_modalities/{mid} {
      // Leitura pública (modalidades integram o quadro do torneio).
      // O flag 'archived' do torneio-pai já é filtrado pela rule de
      // /tournaments/{tid} — público que não tem acesso ao torneio
      // não chega aqui. Usar isTournamentVisibleByTid aqui estoura
      // o limite de lookups do Firestore (4 lookups × N docs/query)
      // e causa permission-denied pra todo mundo.
      allow read: if true;
      allow create: if isPlatformAdmin() || isTournamentAdmin(nd().tournament_id);
      allow update: if isPlatformAdmin()
        || (isTournamentAdmin(od().tournament_id)
            && nd().tournament_id == od().tournament_id);
      allow delete: if isPlatformAdmin() || isTournamentAdmin(od().tournament_id);
    }

    match /tournament_registrations/{rid} {
      // Inscritos: leitura pública (quadro do torneio inclui nomes).
      // O flag 'archived' do torneio-pai já é filtrado pela rule de
      // /tournaments/{tid} — público que não tem acesso ao torneio
      // arquivado não chega aqui. Manter como pública evita o estouro
      // de lookups do Firestore (CRÍTICO: listMyRegistrations faz 3
      // queries paralelas com where(user_id|player_a_user_id|player_b_user_id)
      // — cada doc disparava isTournamentVisibleByTid e batia o limite
      // de 20 lookups/query → permission-denied → useMyTournaments
      // quebrava silenciosamente e o admin via "como se nunca tivesse
      // criado torneios"). Bug introduzido em #33, corrigido em #37.
      allow read: if true;
      // Próprio jogador inscreve-se, OU admin do torneio inscreve.
      // O inscrito não se dá vaga: nasce na fila, aguardando pagamento ou —
      // só em modalidade sem taxa — confirmado, e sem cabeça de chave.
      allow create: if isAuthed()
        && (isTournamentAdmin(nd().tournament_id)
            || isPlatformAdmin()
            || (nd().created_by == me()
                && nd().get('seed', null) == null
                && tournamentMembershipOk(nd().tournament_id)
                && (nd().get('status', '') in ['waitlist', 'pending_payment']
                    || (nd().get('status', '') == 'confirmed'
                        && get(/databases/$(database)/documents/tournament_modalities/$(nd().modality_id)).data.get('entry_fee_cents', 0) == 0))));
      // Quem criou a inscrição edita os dados dela, faz/desfaz o check-in e
      // desiste — mas não confirma a si mesmo (pagamento e lista de espera são
      // da organização), não muda de torneio/modalidade nem de cabeça de chave.
      allow update: if isPlatformAdmin()
        || isTournamentAdmin(od().tournament_id)
        || (isOwner(od().created_by)
            && nd().tournament_id == od().tournament_id
            && nd().get('modality_id', null) == od().get('modality_id', null)
            && nd().get('seed', null) == od().get('seed', null)
            && (nd().get('status', '') == od().get('status', '')
                || nd().get('status', '') in ['cancelled', 'withdrawn']
                || (nd().get('status', '') == 'checked_in' && od().get('status', '') == 'confirmed')
                || (nd().get('status', '') == 'confirmed' && od().get('status', '') == 'checked_in')))
        || isRegistrationEmailOwnerUpdate(rid)
        // Convite de dupla (flag partner_invites): o convidado responde ao
        // convite alterando SOMENTE os campos do convite.
        || (isAuthed()
          && od().partner_invite_uid == me()
          && chg().hasOnly([
            'partner_invite_status',
            'partner_invite_responded_at',
            'updated_at',
          ]));
      allow delete: if isPlatformAdmin() || isTournamentAdmin(od().tournament_id);

      // ---- P0-02 · contato do inscrito (NÃO público) ----------------------
      // O e-mail do inscrito vive AQUI, não no documento acima. Quem lê:
      // o titular, a dupla, quem criou a inscrição, o organizador do torneio
      // e o admin da plataforma. Nunca alguém sem login.
      match /private/{docId} {
        allow read: if isPlatformAdmin()
          || isRegistrationOrganizer(rid)
          || isRegistrationParty(rid);
        allow write: if isPlatformAdmin()
          || isRegistrationOrganizer(rid)
          || isRegistrationParty(rid);
      }
    }

    // ---- P0-02 · prova de inscrição provisória ----------------------------
    // Quando o organizador inscreve alguém que ainda não tem conta, o e-mail
    // não pode ficar no documento público. Esta coleção é o índice que
    // permite à pessoa ACHAR a própria inscrição ao criar a conta — e só a
    // dela: a leitura exige que o e-mail do TOKEN case com `email_lc`, então
    // a consulta obrigatoriamente é `where('email_lc','==', <o meu>)`.
    // Não há varredura possível da base.
    // Id determinístico `{rid}_a` / `{rid}_b` para que a regra de
    // `tournament_registrations` possa conferir a posse sem hash.
    match /provisional_claims/{claimId} {
      allow read: if isPlatformAdmin()
        || (hasTokenEmail() && od().get('email_lc', '') == tokenEmailLc());
      // Cria/ajusta quem pode mexer na inscrição de origem.
      // O id é a prova (`isProvisionalClaimOwner` lê `{rid}_{slot}`): amarrado
      // à inscrição citada, senão uma prova gravada com o id da inscrição de
      // OUTRA pessoa e `registration_id` da minha me dava a inscrição dela.
      allow create: if (claimId == nd().get('registration_id', '') + '_' + nd().get('slot', '')
          && nd().get('slot', '') in ['a', 'b'])
        && (isPlatformAdmin()
          || isRegistrationOrganizer(nd().get('registration_id', ''))
          || isRegistrationParty(nd().get('registration_id', '')));
      allow update: if (isPlatformAdmin()
        || ((isRegistrationOrganizer(od().get('registration_id', ''))
            || isRegistrationParty(od().get('registration_id', '')))
          && nd().get('registration_id', '') == od().get('registration_id', '')
          && nd().get('slot', '') == od().get('slot', '')))
        // O titular apenas MARCA como reivindicada — não reescreve o e-mail
        // nem aponta a entrada para outra inscrição.
        || (hasTokenEmail()
            && od().get('email_lc', '') == tokenEmailLc()
            && chg()
                 .hasOnly(['claimed', 'claimed_by', 'claimed_at', 'updated_at'])
            && nd().get('claimed_by', '') == me());
      allow delete: if isPlatformAdmin()
        || isRegistrationOrganizer(od().get('registration_id', ''));
    }

    match /tournament_announcements/{aid} {
      // Avisos do organizador (flag tournament_announcements): histórico
      // legível por autenticados; escrita apenas por admins do torneio.
      allow read: if isAuthed();
      allow create: if isPlatformAdmin()
        || isTournamentAdmin(nd().tournament_id);
      allow update, delete: if isPlatformAdmin()
        || isTournamentAdmin(od().tournament_id);
    }

    match /tournament_matches/{mid} {
      // Jogos: leitura pública (quadro do torneio é público).
      // O flag 'archived' do torneio-pai já é filtrado pela rule de
      // /tournaments/{tid} — público não chega num torneio arquivado.
      // Usar isTournamentVisibleByTid aqui causa o mesmo estouro de
      // lookups documentado em /tournament_registrations.
      allow read: if true;
      // Null-safe: create usa request.resource (doc novo); update/delete usam
      // resource (doc existente) — evita desreferenciar null no delete do re-sorteio.
      allow create: if isPlatformAdmin() || isTournamentAdmin(nd().tournament_id);
      // Quem manda é o torneio do documento ATUAL, e ele não muda: conferir o
      // `tournament_id` NOVO deixava o dono de um torneio qualquer reescrever
      // o placar de um jogo alheio gravando o id do próprio torneio.
      allow update: if isPlatformAdmin()
        || (isTournamentAdmin(od().tournament_id)
            && nd().tournament_id == od().tournament_id);
      allow delete: if isPlatformAdmin() || isTournamentAdmin(od().tournament_id);
    }

    match /tournament_groups/{gid} {
      // Grupos: leitura pública (estrutura do torneio é pública, exibida na
      // classificação e no quadro público) — igual a tournament_matches e
      // tournament_courts. Usar isTournamentVisibleByTid aqui (que faz get())
      // fazia as CONSULTAS por coleção (list) serem negadas com
      // "Missing or insufficient permissions", quebrando o sorteio da fase de
      // grupos (deletePhaseGroups) e forçando o ranking a cair em "grupo único".
      // O flag 'archived' do torneio-pai já é filtrado pela rule de /tournaments/{tid}.
      allow read: if true;
      // Null-safe: create usa request.resource (doc novo); update/delete usam
      // resource (doc existente) — evita desreferenciar null no delete do re-sorteio.
      allow create: if isPlatformAdmin() || isTournamentAdmin(nd().tournament_id);
      // Quem manda é o torneio do documento ATUAL, e ele não muda: conferir o
      // `tournament_id` NOVO deixava o dono de um torneio qualquer reescrever
      // o placar de um jogo alheio gravando o id do próprio torneio.
      allow update: if isPlatformAdmin()
        || (isTournamentAdmin(od().tournament_id)
            && nd().tournament_id == od().tournament_id);
      allow delete: if isPlatformAdmin() || isTournamentAdmin(od().tournament_id);
    }

    match /tournament_rankings/{rid} {
      // Ranking materializado: leitura respeita o flag 'archived' do torneio-pai.
      allow read: if isTournamentVisibleByTid(od().tournament_id);
      allow create: if isPlatformAdmin() || isTournamentAdmin(nd().tournament_id);
      allow update: if isPlatformAdmin()
        || (isTournamentAdmin(od().tournament_id)
            && nd().tournament_id == od().tournament_id);
      allow delete: if isPlatformAdmin() || isTournamentAdmin(od().tournament_id);
    }

    match /tournament_courts/{cid} {
      // Quadras: leitura pública (info do torneio).
      // O flag 'archived' do torneio-pai já é filtrado pela rule de
      // /tournaments/{tid} — público não chega num torneio arquivado.
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin()
        || isTournamentAdmin(nd().tournament_id)
        || isTournamentAdmin(od().tournament_id);
    }

    // ---- Notifications ---------------------------------------------------
    // ---- P1-06 · notificações -------------------------------------------
    // O sino tem a credibilidade da interface oficial. `allow create: if
    // isAuthed()` deixava qualquer conta escrever nele com texto e LINK
    // arbitrários — phishing com a cara do produto. O link é o que fazia o
    // estrago: agora só rota interna passa.
    //
    // HONESTIDADE SOBRE O QUE ISTO **NÃO** RESOLVE: continua sendo possível
    // escrever uma notificação de texto no sino de outra pessoa. Fechar isso
    // exigiria provar, na regra, a relação entre quem escreve e quem recebe —
    // e são 48 pontos de chamada legítimos (convite de dupla, mensagem, tópico
    // de fórum, inscrição em clube), sem uma relação única e barata de provar.
    // Também não exigimos `actor_id == uid`: em vários fluxos legítimos o ator
    // NÃO é quem está logado (o admin do torneio age em nome do criador). Ver
    // `docs/20-SEGURANCA-E-PRIVACIDADE/01-AUDITORIA-ACHADOS.md` § P1-06.
    function isKnownNotificationType(t) {
      return t in [
        'chat_message', 'chat_invite', 'forum_reply', 'forum_mention',
        'event_invite', 'club_join_request', 'club_join_approved',
        'club_join_rejected', 'club_invite', 'club_invite_accepted',
        'club_event_published', 'tournament_open', 'tournament_announcement',
        'partner_invite', 'partner_response', 'profile_reminder',
        'leveling_reminder', 'profile_admin_edit', 'gamification', 'generic',
        // Centro de Treino (flag training_center).
        'training_share', 'training_review', 'training_comment',
        'training_question', 'training_answer',
        // Mercado (flag marketplace).
        'market',
        // Federações (flag federations).
        'federation',
      ];
    }
    function isInternalLink(l) {
      // Só caminho interno da própria aplicação. Sem http(s):, sem
      // javascript:, e — o caso que o teste pegou — sem '//' no início: uma
      // URL relativa a protocolo (`//site-falso.com`) começa com '/' e o
      // navegador a trata como OUTRO DOMÍNIO. Por isso o primeiro caractere
      // depois da barra não pode ser outra barra.
      return l == null || (
        l is string && l.size() <= 600
        && l.matches('^/([A-Za-z0-9_?=&%.:-][A-Za-z0-9/_?=&%.:-]*)?$')
      );
    }
    match /notifications/{nid} {
      allow read: if isOwner(od().user_id);
      // O titular marca lida/não lida. Os campos que decidem se o aviso sai
      // por e-mail ou celular (e para quem) não mudam depois de criados.
      allow update: if isOwner(od().user_id)
        && !chg()
              .hasAny(['user_id', 'origin', 'essential', 'sent_by', 'broadcast']);
      allow create: if isAuthed()
        && nd().user_id is string
        && nd().user_id.size() > 0
        && isKnownNotificationType(nd().get('type', 'generic'))
        // FOLGA PROPOSITAL: o serviço corta em 140/300, mas ele conta em
        // unidades UTF-16 do JavaScript e a regra conta caracteres. Com emoji
        // os dois números divergem, e uma notificação legítima seria recusada
        // em silêncio. O limite aqui existe para barrar payload gigante, não
        // para repetir a validação do cliente — então vai com margem.
        && nd().get('title', '').size() <= 300
        && nd().get('message', '').size() <= 600
        && isInternalLink(nd().get('link', null))
        // Nasce sempre não lida — ninguém cria já marcada para escapar do sino.
        && nd().get('read', false) == false
        // E-MAIL E CELULAR (docs/49): o servidor decide se o aviso sai da
        // plataforma pela ORIGEM. `origin`/`essential` só o servidor grava
        // (Admin SDK, fora destas regras); `sent_by` é sempre quem escreve —
        // é ele que leva "Enviado por" e o botão de denunciar ao e-mail; e os
        // canais do aviso em massa (`broadcast`) só valem do admin.
        && nd().get('sent_by', me()) == me()
        && !nd().keys().hasAny(['origin', 'essential'])
        && (!('broadcast' in nd()) || isPlatformAdmin());
      allow delete: if isPlatformAdmin();
    }

    // ---- Avisos por e-mail e celular (docs/49) ---------------------------
    // Chaves dos provedores e estado interno do envio: SÓ o servidor.
    match /platform_secrets/{docId} {
      allow read, write: if false;
    }
    // O registro do que saiu (e-mail, WhatsApp, SMS): fila, contagem e prova.
    // A pessoa lê o dela (exportação); o admin lê tudo. Só o servidor escreve.
    match /message_outbox/{oid} {
      allow read: if (isOwner(od().user_id) || isPlatformAdmin());
      allow write: if false;
    }
    // Endereços bloqueados (devolução, reclamação, PARAR) e o código do
    // celular em andamento (hash): ninguém lê pelo cliente.
    match /message_suppressions/{sid} {
      allow read, write: if false;
    }
    match /phone_verifications/{uid} {
      allow read, write: if false;
    }
    // Denúncia de e-mail pelo link do rodapé: o admin lê; o servidor escreve.
    match /message_reports/{rid} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // ---- Acessos do suporte (05-ADMIN-SUPORTE §7) ------------------------
    // Escrito SÓ pelo servidor (`adminSupportReveal`), imutável. O TITULAR lê
    // Registro INTERNO: só o admin lê (decisão do dono, 2026-10-11 — o titular
    // não é avisado nem vê o registro). Guarda hash do valor, nunca o valor.
    match /admin_access_logs/{aid} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // ---- Audit logs (read by platform admin only) ------------------------
    match /audit_logs/{lid} {
      allow read: if isPlatformAdmin();
      // ⚠️ INTEGRIDADE — o ator registrado tem de ser quem está escrevendo.
      // Sem isso a trilha pode ser atribuída a terceiros, e ela é justamente
      // a prova em caso de incidente. `auditService.createAuditLog` já grava
      // `actor_id: actor.uid` e retorna cedo quando não há ator, e é
      // best-effort (try/catch) — nenhum fluxo quebra se uma escrita for
      // recusada. Achado P1-07.
      allow create: if isAuthed()
        && nd().actor_id == me();
      allow update, delete: if false;
    }

    // ---- Athlete directory (public projection of users) ------------------
    // Documento público (qualquer conta logada lê): telefone, e-mail e
    // endereço só ficam aqui com a permissão da pessoa. A REGRA impõe isso
    // (princípio 10) — esconder na tela não basta, quem lê o documento vê tudo.
    //  - todo escritor: contato gravado exige a própria marca `*_public` true;
    //  - o dono: exige também a marca no `users/{uid}`, onde mora a escolha
    //    (o app grava `users` antes do espelho; o `get` só roda com contato);
    //  - o admin grava em lote (re-sincronização, até 400 por vez), e um `get`
    //    por documento estouraria o limite de 20 do lote: para ele vale a
    //    coerência do próprio documento, e só quando a escrita mexe em contato
    //    ou marca — ocultar um perfil antigo com contato velho segue possível.
    function contatoMarcado(d, campo, marca) {
      return d.get(campo, '') == '' || d.get(marca, false) == true;
    }
    function contatosMarcados(d) {
      return contatoMarcado(d, 'phone', 'phone_public')
        && contatoMarcado(d, 'email', 'email_public')
        && contatoMarcado(d, 'address', 'address_public');
    }
    function contatoPermitidoNoCadastro(uid, d, campo, marca) {
      return d.get(campo, '') == ''
        || get(/databases/$(database)/documents/users/$(uid)).data.get(marca, false) == true;
    }
    function contatosDoDonoPermitidos(uid, d) {
      return contatosMarcados(d)
        && contatoPermitidoNoCadastro(uid, d, 'phone', 'phone_public')
        && contatoPermitidoNoCadastro(uid, d, 'email', 'email_public')
        && contatoPermitidoNoCadastro(uid, d, 'address', 'address_public');
    }
    function mexeEmContato() {
      return chg().hasAny([
        'phone', 'phone_public', 'email', 'email_public', 'address', 'address_public']);
    }
    match /athlete_profiles/{uid} {
      allow read: if isAuthed();
      // platform_admin também pode escrever — usado por
      // `restoreAthleteProfileFromUserDoc` e pela re-sincronização em lote.
      // A ocultação pela moderação (`hidden*`) é do admin: o dono não a
      // desfaz — nem gravando `hidden: false`, nem apagando e recriando.
      allow create: if (isPlatformAdmin() && contatosMarcados(nd()))
        || (isOwner(uid) && nd().get('hidden', false) == false
            && !nd().keys().hasAny(['dupr_verified', 'dupr_verified_at_ms'])
            && contatosDoDonoPermitidos(uid, nd()));
      allow update: if (isPlatformAdmin()
            && (!mexeEmContato() || contatosMarcados(nd())))
        || (isOwner(uid) && !chg()
              .hasAny(['hidden', 'hidden_at', 'hidden_by'])
            && duprSeloIntacto()
            && contatosDoDonoPermitidos(uid, nd()));
      allow delete: if isPlatformAdmin()
        || (isOwner(uid) && od().get('hidden', false) != true);
    }

    // ---- DUPR oficial (flag `dupr_official_sync`) ------------------------
    // Escrita SÓ do servidor (`duprIntegration` / `duprWebhook`, Admin SDK).
    // `dupr_links`: resumo do vínculo (sem token) — o dono e o admin leem.
    // `dupr_link_tokens` (tokens do login no DUPR) e `dupr_ids` (um ID, uma
    // conta) ficam fechados ao navegador.
    match /dupr_links/{uid} {
      allow read: if isOwner(uid) || isPlatformAdmin();
      allow write: if false;
    }
    match /dupr_link_tokens/{uid} {
      allow read, write: if false;
    }
    match /dupr_ids/{duprId} {
      allow read, write: if false;
    }
    // Piloto do DUPR (Painel admin → DUPR): jogadores e partidas de teste que
    // existem só ali. Só o admin lê; só o servidor escreve (`pilot_*`).
    match /dupr_pilot_players/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /dupr_pilot_matches/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // ---- Clubs -----------------------------------------------------------
    match /clubs/{clubId} {
      // Leitura autenticada, OU pública quando o clube foi marcado como público
      // (flag club_public_page — vitrine sem login).
      allow read: if isAuthed() || od().is_public == true;
      allow create: if isOwner(nd().created_by);
      // Admins editam tudo; qualquer membro pode atualizar apenas o contador
      // cosmético de membros (entrar/sair do clube).
      allow update: if isClubAdmin(clubId) || isPlatformAdmin()
        || (isAuthed()
            && chg().hasOnly(['member_count', 'updated_at']));
      allow delete: if isPlatformAdmin()
        || (isOwner(od().created_by));
    }

    // ---- Convite de clube: as provas de entrada --------------------------
    function hasPendingClubInvite(docId) {
      return exists(/databases/$(database)/documents/club_member_invites/$(docId))
        && get(/databases/$(database)/documents/club_member_invites/$(docId)).data.get('status', '') == 'pending';
    }
    // O código vale se é o código atual do clube (`club_invite_codes`) ou,
    // no clube ainda não migrado, o que mora no próprio documento do clube.
    function validClubCode(clubId, code) {
      return code is string && code.matches('^[A-Z0-9]{4,12}$')
        && ((exists(/databases/$(database)/documents/club_invite_codes/$(code))
              && get(/databases/$(database)/documents/club_invite_codes/$(code)).data.club_id == clubId)
          || get(/databases/$(database)/documents/clubs/$(clubId)).data.get('invite_code', '') == code);
    }
    function hasClubCodeJoin(docId, clubId) {
      return existsAfter(/databases/$(database)/documents/club_code_joins/$(docId))
        && validClubCode(clubId, getAfter(/databases/$(database)/documents/club_code_joins/$(docId)).data.code);
    }

    // id = o próprio código: quem sabe o código lê (é assim que o código leva
    // ao clube). Listar é só dos admins do clube — o código não pode ser
    // descoberto varrendo a coleção.
    match /club_invite_codes/{code} {
      allow get: if isAuthed();
      allow list: if isAuthed() && (clubOd() || isPlatformAdmin());
      allow create: if isAuthed()
        && code.matches('^[A-Z0-9]{4,12}$')
        && nd().code == code
        && (isClubAdmin(nd().club_id) || isPlatformAdmin());
      allow update: if false;
      allow delete: if isAuthed() && (clubOd() || isPlatformAdmin());
    }

    // A prova de quem entrou pelo código (`{clube}_{uid}`). Só o dono e os
    // admins do clube leem — o código não vai para club_members, que é público.
    match /club_code_joins/{docId} {
      allow read: if (isOwner(od().user_id)
        || clubOd() || isPlatformAdmin());
      allow create: if isAuthed()
        && nd().user_id == me()
        && docId == nd().club_id + '_' + me()
        && validClubCode(nd().club_id, nd().code);
      allow update: if false;
      allow delete: if (isOwner(od().user_id)
        || clubOd() || isPlatformAdmin());
    }

    match /club_members/{docId} {
      allow read: if isAuthed();
      // Auto-ingresso como membro, criador registrando-se como admin, ou um
      // admin adicionando alguém.
      // O id É a credencial: `isClubMember`/`isClubAdmin` só procuram
      // `{clubId}_{uid}`. Sem amarrar o id aos campos, quem cria o próprio
      // clube A gravava `{CLUBE_ALHEIO}_{eu}` com `club_id: A, role: admin` e
      // virava admin do clube alheio.
      // Entrar SOZINHO exige um dos três: ter criado o clube (o admin
      // fundador), um convite pendente do admin (`club_member_invites`, mesmo
      // id) ou o código de convite (a prova em `club_code_joins`, gravada no
      // mesmo lote). Antes bastava querer: o código era decorativo e qualquer
      // conta virava membro de qualquer clube — e via os eventos privados e os
      // dias de jogo do clube.
      allow create: if isAuthed()
        && docId == nd().club_id + '_' + nd().user_id
        && (
          (nd().user_id == me()
            && (isClubCreator(nd().club_id)
              || (nd().role == 'member'
                && (hasPendingClubInvite(docId) || hasClubCodeJoin(docId, nd().club_id)))))
          || isClubAdmin(nd().club_id)
          || isPlatformAdmin()
        );
      allow update: if (clubOd() || isPlatformAdmin())
        && nd().club_id == od().club_id
        && nd().user_id == od().user_id;
      // Admin remove membros; qualquer um remove a própria associação (sair).
      allow delete: if clubOd() || isPlatformAdmin()
        || (isOwner(od().user_id));
    }

    // Pedidos de ingresso: não-membro pede para entrar; admin aprova/recusa.
    match /club_join_requests/{docId} {
      allow read: if isAuthed() && (
        resource == null
        || od().user_id == me()
        || clubOd()
        || isPlatformAdmin()
      );
      allow create: if isAuthed()
        && nd().user_id == me()
        && nd().status == 'pending'
        && !isClubMember(nd().club_id);
      allow update: if isAuthed() && (
        clubOd() || isPlatformAdmin()
        || od().user_id == me()
      );
      allow delete: if isAuthed() && (
        clubOd() || isPlatformAdmin()
        || od().user_id == me()
      );
    }

    // Convites de associação: admin convida atleta; o convidado aceita/recusa.
    match /club_member_invites/{docId} {
      allow read: if isAuthed() && (
        resource == null
        || od().user_id == me()
        || clubOd()
        || isPlatformAdmin()
      );
      allow create: if isAuthed()
        && (isClubAdmin(nd().club_id) || isPlatformAdmin());
      allow update: if isAuthed() && (
        od().user_id == me()
        || clubOd() || isPlatformAdmin()
      );
      allow delete: if isAuthed() && (
        od().user_id == me()
        || clubOd() || isPlatformAdmin()
      );
    }

    match /club_events/{eventId} {
      // Público (ou legado sem o campo): qualquer membro do clube lê.
      // Privado: apenas criador, admin do clube, plataforma ou convidado.
      allow read: if isPlatformAdmin()
        || (isOwner(od().created_by))
        || clubOd()
        || isEventInvitee(eventId)
        || (od().get('visibility', 'public') != 'private' && isClubMember(od().club_id));
      allow create: if isClubMember(nd().club_id)
        && nd().created_by == me();
      // Criador, admin e participantes (incluindo convidados) editam livremente.
      allow update: if isPlatformAdmin()
        || (isOwner(od().created_by))
        || clubOd()
        || isEventInvitee(eventId)
        || (od().get('visibility', 'public') != 'private' && isClubMember(od().club_id));
      allow delete: if clubOd() || isPlatformAdmin()
        || (isOwner(od().created_by));

      // Datas do evento (data, local, horário) — editáveis pelos participantes.
      match /dates/{dateId} {
        allow read: if isEventClubMember(eventId) || isPlatformAdmin();
        allow create, update, delete: if isEventClubMember(eventId) || isPlatformAdmin();
      }

      // Resposta por data (vou/talvez/não vou). Cada um grava a própria resposta.
      match /date_rsvps/{docId} {
        allow read: if isEventClubMember(eventId) || isPlatformAdmin();
        allow create: if isAuthed()
          && nd().user_id == me()
          && isEventClubMember(eventId);
        allow update: if isAuthed()
          && od().user_id == me()
          && nd().user_id == me()
          && isEventClubMember(eventId);
        allow delete: if (isOwner(od().user_id))
          || isEventClubModerator(eventId);
      }

      // Chat cronológico do evento.
      match /messages/{messageId} {
        allow read: if isEventClubMember(eventId) || isPlatformAdmin();
        allow create: if isEventClubMember(eventId)
          && nd().sender_id == me();
        allow update, delete: if (isOwner(od().sender_id))
          || isEventClubModerator(eventId);
      }

      // Participantes do dia de jogo (edição livre pelos participantes).
      match /participants/{participantId} {
        allow read: if isEventClubMember(eventId) || isPlatformAdmin();
        allow create, update, delete: if isEventClubMember(eventId) || isPlatformAdmin();
      }

      // Jogos organizados/sorteados (edição livre pelos participantes).
      match /games/{gameId} {
        allow read: if isEventClubMember(eventId) || isPlatformAdmin();
        allow create, update, delete: if isEventClubMember(eventId) || isPlatformAdmin();
      }
    }

    // ---- Convites/participações em eventos (coleção de nível superior) -----
    // Id determinístico `${eventId}_${uid}`. Permite ao usuário listar seus
    // próprios convites (início) e aos participantes verem a lista do evento.
    match /event_invites/{docId} {
      // `resource == null` cobre o `get` de um convite ainda inexistente (ex.:
      // verificação antes de criar) — sem isso o acesso a resource.data falha.
      allow read: if isAuthed() && (
        resource == null
        || od().user_id == me()
        || isEventParticipant(od().event_id)
      );
      // Auto-resposta a evento público, aceite de convite, ou um participante
      // convidando outro atleta.
      // O id é a credencial de `isEventInvitee`: amarrado aos campos, senão um
      // convite gravado com o id de um evento PRIVADO e `event_id` de um
      // público abria o privado.
      allow create: if isAuthed()
        && docId == nd().event_id + '_' + nd().user_id
        && (
          (nd().user_id == me()
            && (eventIsPublic(nd().event_id) || isEventInvitee(nd().event_id)))
          || isEventParticipant(nd().event_id)
        );
      allow update: if isAuthed()
        && (od().user_id == me() || isEventParticipant(od().event_id))
        && nd().event_id == od().event_id
        && nd().user_id == od().user_id;
      allow delete: if isAuthed()
        && (od().user_id == me()
            || isEventClubModerator(od().event_id)
            || isEventParticipant(od().event_id));
    }

    // ---- Lançamento de resultados de dias de jogo no ranking (Wave C) ----
    // Coleção top-level materializada a partir dos jogos com resultado
    // (`score_a` e `score_b`) dos dias de jogo de eventos de clubes
    // (`club_events/{id}/dates/{dateId}`). O criador do evento ou um admin
    // do clube liga `publish_to_ranking` no dia de jogo; o serviço
    // `rankingPublishingService` espelha os jogos decididos nesta coleção
    // e dispara o recálculo do rating nacional.
    //
    // Schema (mirrored de `tournament_matches` + extras):
    //   id = `${eventId}_${dateId}_${gameId}` (id determinístico para idempotência)
    //   event_id, date_id, club_id, source='club_event_game',
    //   side_a_ids, side_b_ids, side_a, side_b,
    //   score_a, score_b, winner_side ('a'|'b'),
    //   status='finished', kind ('doubles'|'singles'),
    //   result_recorded_at, created_at, published_by
    //
    // Jogos SEM resultado (score null) NÃO são publicados. Apenas jogadores
    // com `user_id` válido (não guests) entram no ranking.
    match /club_event_games/{gameId} {
      // Leitura pública: faz parte do ranking oficial da plataforma.
      allow read: if true;
      // Criação: apenas criadores do evento, admins do clube vinculado ou
      // admin da plataforma. Validação de schema: side_a_ids/side_b_ids
      // paralelos ao tamanho do `kind` (singles=1, doubles=2).
      allow create: if isAuthed() && (
        isPlatformAdmin()
        || isGameDayOwnerOf(nd().event_id)
        // Dia de jogo de ARENA: quem gerencia a arena publica os resultados.
        // Sem isto, só quem clicou em "criar" conseguiria — e um dia de jogo
        // da arena ficaria sem poder entrar no ranking assim que essa pessoa
        // saísse da equipe. Falsa para qualquer evento que não seja um dia de
        // jogo com `arena_id` (a função confere as duas coisas).
        || isArenaGameDayManagerOf(nd().event_id)
        || isClubEventCreator(nd().event_id)
        || isClubAdmin(nd().club_id)
        // Espelho de CONFRONTO DE EQUIPES: o admin do torneio grava os
        // resultados das etapas no ranking individual (flag team_tournaments).
        || (nd().source == 'team_confrontation'
            && isTournamentAdmin(nd().tournament_id))
      ) && nd().keys().hasAll([
        'event_id', 'date_id', 'club_id', 'side_a_ids', 'side_b_ids',
        'score_a', 'score_b', 'winner_side', 'status'
      ]) && (
        (nd().kind == 'singles'
          && nd().side_a_ids.size() == 1
          && nd().side_b_ids.size() == 1)
        || (nd().kind == 'doubles'
          && nd().side_a_ids.size() == 2
          && nd().side_b_ids.size() == 2)
      );
      // Atualização: mesmos perfis. Imutável em `event_id`/`date_id`/`club_id`.
      allow update: if isAuthed() && (
        isPlatformAdmin()
        || isGameDayOwnerOf(nd().event_id)
        || isArenaGameDayManagerOf(nd().event_id)
        || isClubEventCreator(nd().event_id)
        || isClubAdmin(nd().club_id)
        || (nd().source == 'team_confrontation'
            && isTournamentAdmin(nd().tournament_id))
      ) && nd().event_id == od().event_id
        && nd().date_id == od().date_id
        && nd().club_id == od().club_id;
      // Exclusão: despublicar um dia de jogo. Admin da plataforma, criador do
      // dia de jogo do atleta, criador do evento ou admin do clube vinculado.
      allow delete: if isAuthed() && (
        isPlatformAdmin()
        || isGameDayOwnerOf(od().event_id)
        || isArenaGameDayManagerOf(od().event_id)
        || isClubEventCreator(od().event_id)
        || clubOd()
        || (od().source == 'team_confrontation'
            && isTournamentAdmin(od().tournament_id))
      );
    }
    // Helper: criador do evento `club_events/{id}`.
    function isClubEventCreator(eventId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/club_events/$(eventId))
        && get(/databases/$(database)/documents/club_events/$(eventId)).data.created_by == me();
    }

    match /club_event_rsvps/{docId} {
      allow read: if isClubMember(od().club_id) || isPlatformAdmin();
      allow create: if isAuthed()
        && nd().user_id == me()
        && isClubMember(nd().club_id);
      allow update: if isOwner(od().user_id);
      allow delete: if (isOwner(od().user_id))
        || clubOd() || isPlatformAdmin();
    }

    match /club_posts/{postId} {
      allow read: if isClubMember(od().club_id) || isPlatformAdmin();
      allow create: if isClubMember(nd().club_id)
        && nd().author_id == me();
      allow update: if isOwner(od().author_id);
      allow delete: if (isOwner(od().author_id))
        || clubOd() || isPlatformAdmin();
    }

    // ---- Club forum: threads, comments and poll votes --------------------
    // Comentários e votos ficam em subcoleções do tópico, validados pelo clube
    // do tópico-pai. Isso evita índices compostos e mantém o acesso restrito
    // aos membros do clube.
    match /club_forum_threads/{threadId} {
      allow read: if isClubMember(od().club_id) || isPlatformAdmin();
      allow create: if isClubMember(nd().club_id)
        && nd().author_id == me();
      // Autor edita o próprio tópico; admins moderam; qualquer membro pode
      // apenas atualizar os campos cosméticos ao comentar (contador/atividade).
      allow update: if clubOd() || isPlatformAdmin()
        || (isOwner(od().author_id))
        || (isClubMember(od().club_id)
            && chg()
                 .hasOnly(['comment_count', 'last_activity_ms', 'participant_ids', 'updated_at']));
      allow delete: if clubOd() || isPlatformAdmin()
        || (isOwner(od().author_id));

      match /comments/{commentId} {
        allow read: if isForumThreadMember(threadId) || isPlatformAdmin();
        allow create: if isForumThreadMember(threadId)
          && nd().author_id == me();
        allow update: if isOwner(od().author_id);
        allow delete: if (isOwner(od().author_id))
          || isForumThreadModerator(threadId);
      }

      match /poll_votes/{voterId} {
        allow read: if isForumThreadMember(threadId) || isPlatformAdmin();
        // O id do documento é o uid do votante: cada um só grava o próprio voto.
        allow create, update: if isAuthed()
          && voterId == me()
          && isForumThreadMember(threadId);
        allow delete: if isOwner(voterId);
      }
    }

    // ---- Chat: conversations and messages --------------------------------
    // Mensagens ficam na subcoleção `conversations/{id}/messages`: o acesso é
    // validado pelo documento-pai (membros da conversa), sem denormalizar
    // membros em cada mensagem nem exigir índices compostos.
    match /conversations/{conversationId} {
      // get permite ler um documento inexistente (resource == null) para que o
      // cliente verifique/abra conversas diretas de id determinístico.
      allow get: if isAuthed()
        && (resource == null || me() in od().member_ids);
      allow list: if isAuthed() && me() in od().member_ids;
      // A conversa direta tem id previsível (`dm_<a>__<b>`): sem amarrar o id
      // aos DOIS membros, um terceiro criava antes `dm_alice__bob` com ele
      // mesmo dentro e lia tudo o que os dois trocassem depois.
      allow create: if isAuthed()
        && me() in nd().member_ids
        && nd().created_by == me()
        && (!conversationId.matches('dm_.*')
            || (nd().member_ids.size() == 2
                && conversationId in [
                  'dm_' + nd().member_ids[0] + '__' + nd().member_ids[1],
                  'dm_' + nd().member_ids[1] + '__' + nd().member_ids[0]
                ]));
      // Um participante atualiza o resumo, o título e a ocultação — e só pode
      // tirar a SI MESMO da lista (sair). Incluir alguém ou tirar outra pessoa
      // não passa: no DM, incluir um terceiro entregaria o histórico.
      allow update: if isAuthed() && me() in od().member_ids && (
        (chg()
            .hasOnly(['hidden_for', 'last_message', 'last_message_at_ms', 'title', 'updated_at']))
        || (chg().hasOnly(['member_ids', 'members', 'updated_at'])
            && nd().member_ids == od().member_ids.removeAll([me()]))
      );
      // Excluir é do último que sobrou (sair de um grupo vazio).
      allow delete: if isAuthed()
        && od().member_ids.size() == 1
        && me() in od().member_ids;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && nd().sender_id == me();
        // Editar é só o texto: trocar `sender_id`/`sender_name` faria a
        // mensagem parecer de outra pessoa.
        allow update: if isOwner(od().sender_id)
          && chg().hasOnly(['text', 'edited', 'edited_at']);
        allow delete: if isOwner(od().sender_id);
      }
    }

    // ============================================================
    // ARENA V3 — Sprints 1-11 (regras adicionadas em 2026-07-21)
    // ============================================================

    // Sprint 1: Matches entre atletas (parceria encontrada via matchmaking)
    match /arena_matches/{matchId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && (
        nd().user_a == me() ||
        nd().user_b == me()
      );
      // `resource.data` (o que ESTÁ gravado), nunca `request.resource.data`:
      // em `delete` não existe request.resource, e a regra recusava sempre.
      allow update, delete: if isAuthed() && (
        arenaOd() ||
        od().user_a == me() ||
        od().user_b == me()
      );
    }

    // Sprint 4: Aulas, instrutores e reservas de aulas
    match /arena_coaches/{coachId} {
      allow read: if isAuthed();
      allow create: if arenaNd() || isPlatformAdmin();
      allow update: if arenaOd() || isPlatformAdmin();
      allow delete: if arenaOd() || isPlatformAdmin();
    }

    match /arena_classes/{classId} {
      allow read: if isAuthed();
      allow create: if arenaNd() || isPlatformAdmin();
      allow update: if arenaOd() || isPlatformAdmin();
      allow delete: if arenaOd() || isPlatformAdmin();
    }

    match /arena_class_bookings/{bookingId} {
      allow read: if isAuthed() && (
        od().user_id == me() ||
        arenaOd() ||
        isPlatformAdmin() ||
        // O PROFESSOR da aula lê as matrículas dela (2026-09-24). 🐞 Antes
        // só o aluno e a arena liam: o professor abria a própria aula e via
        // "ninguém matriculado" com a turma cheia. Quem é professor é o
        // cadastro que a ARENA fez (`arena_coaches`, que só a arena escreve)
        // com a conta da pessoa em `user_id` — ninguém se faz professor.
        // A consulta do professor filtra por `coach_id`, que é o que deixa o
        // Firestore provar esta condição para a lista inteira.
        (od().get('coach_id', null) is string &&
          get(/databases/$(database)/documents/arena_coaches/$(od().coach_id)).data.get('user_id', null) == me())
      );
      // O aluno se matricula em nome próprio, sem se declarar PAGO (2026-09-24)
      // e na arena DA AULA — sem isto dava para plantar uma matrícula "paga"
      // na lista de alunos de outra arena.
      allow create: if isAuthed()
        && nd().user_id == me()
        && nd().get('paid', false) == false
        && get(/databases/$(database)/documents/arena_classes/$(nd().class_id)).data.arena_id == nd().arena_id;
      // A arena também cancela/remarca: era só do aluno, e a arena ficava sem
      // como desfazer uma aula na própria agenda. O aluno continua podendo
      // mexer na própria matrícula, MENOS no que é da arena decidir: pagamento,
      // valores e a que aula/arena/professor ela pertence (2026-09-24).
      allow update: if isAuthed() && (
        arenaOd()
        || isPlatformAdmin()
        || (od().user_id == me()
          && !chg().hasAny([
            'paid', 'paid_at', 'amount', 'arena_amount', 'coach_amount',
            'commission_pct', 'arena_id', 'class_id', 'user_id', 'coach_id'
          ]))
      );
      allow delete: if isAuthed() && (
        od().user_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
    }

    // Sprint 5: Torneios internos e ladder
    match /arena_internal_tournaments/{tournamentId} {
      allow read: if isAuthed();
      allow create: if arenaNd() || isPlatformAdmin();
      allow update: if arenaOd() || isPlatformAdmin()
        || internalTournamentSelfSignup();
      allow delete: if arenaOd() || isPlatformAdmin();

      // 🐞 O ATLETA se inscreve e sai (2026-09-24). A inscrição grava no
      // próprio documento do torneio (`participants`, `roster`, `enrolled`) e
      // a atualização era só da arena: TODA inscrição era recusada — o botão
      // "Quero jogar" existia e nunca funcionou. Aqui, o mesmo desenho do dia
      // de jogo: a pessoa só entra ou sai A SI MESMA, só enquanto as
      // inscrições estão abertas (antes de o torneio virar dia de jogo), e não
      // toca em mais nada do documento.
      function internalTournamentSelfSignup() {
        return isAuthed()
          && od().get('status', 'scheduled') == 'scheduled'
          && od().get('game_day_id', null) == null
          && chg()
              .hasOnly(['participants', 'roster', 'enrolled', 'updated_at'])
          && (internalTournamentJoin() || internalTournamentLeave());
      }
      function internalTournamentJoin() {
        return !(me() in od().get('participants', []))
          && nd().participants.toSet()
              == od().get('participants', []).toSet().union([me()].toSet())
          && nd().get('enrolled', 0) == od().get('enrolled', 0) + 1
          && (od().get('max_participants', 0) <= 0
              || nd().get('enrolled', 0) <= od().max_participants)
          && nd().get('roster', []).size() == od().get('roster', []).size() + 1
          && nd().get('roster', []).hasAll(od().get('roster', []));
      }
      function internalTournamentLeave() {
        return (me() in od().get('participants', []))
          && nd().participants.toSet()
              == od().get('participants', []).toSet().difference([me()].toSet())
          && od().get('roster', []).hasAll(nd().get('roster', []))
          && ((od().get('enrolled', 0) > 0
                && nd().get('enrolled', 0) == od().get('enrolled', 0) - 1)
              || (od().get('enrolled', 0) <= 0 && nd().get('enrolled', 0) == 0));
      }
    }

    match /arena_ladders/{ladderId} {
      allow read: if isAuthed();
      allow create: if arenaNd() || isPlatformAdmin();
      allow update, delete: if arenaOd() || isPlatformAdmin();
    }

    // Sprint 6: Marketing (cupons, campanhas, NPS, referral)
    // O cupom é legível por qualquer conta logada (o atleta confere o código e
    // vê as promoções). Por isso o CUSTO que a arena paga por um vale NÃO mora
    // aqui: fica em `arena_settings.coupon_costs`, que só o gestor lê.
    match /arena_coupons/{couponId} {
      allow read: if isAuthed();
      allow create: if arenaNd() || isPlatformAdmin();
      // A arena dona edita — mas não MUDA O CUPOM DE ARENA (2026-09-25). 🐞
      // Antes o gestor de A podia trocar o `arena_id` para B: o cupom virava
      // promoção na página de B e desconto nas reservas de B, sem B saber.
      allow update: if (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin();
      allow delete: if arenaOd() || isPlatformAdmin();
    }

    match /arena_campaigns/{campaignId} {
      allow read: if isAuthed();
      allow create: if arenaNd() || isPlatformAdmin();
      // Mesma trava do cupom: a campanha não muda de arena (2026-09-25).
      allow update: if (arenaOd()
          && nd().arena_id == od().arena_id)
        || isPlatformAdmin();
      allow delete: if arenaOd() || isPlatformAdmin();
    }

    // A leitura olhava `request.resource.data`, que em leitura é NULO: a arena
    // nunca conseguiu ler o próprio NPS. O respondente também vê o que enviou.
    match /arena_nps_responses/{responseId} {
      allow read: if isAuthed() && (
        od().user_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
      allow create: if isOwner(nd().user_id);
      allow update, delete: if isPlatformAdmin();
    }

    match /arena_referrals/{referralId} {
      // A ARENA também lê as indicações dela (2026-09-24). 🐞 Sem isto o
      // resgate ("fulano chegou pelo código X") procurava o código com uma
      // consulta que a regra recusava — a arena nunca conseguiu registrar uma
      // indicação. O documento tem só o código e os dois uids.
      allow read: if isAuthed() && (
        od().referrer_id == me() ||
        od().referred_id == me() ||
        arenaOd() ||
        isPlatformAdmin()
      );
      allow get: if canGetMissingArenaUserDoc(referralId);
      // Só se pode indicar EM NOME PRÓPRIO. Antes bastava estar logado, e dava
      // para criar indicação apontando outra pessoa como indicadora.
      //
      // E o documento tem de ser o DA PRÓPRIA PESSOA (2026-09-25): id
      // `{arena}_{uid}`. 🐞 O id era livre, e dava para criar o documento
      // `{arena}_{uid da vítima}` com o próprio uid como indicador: o "Meu
      // código" da vítima passava a mostrar o código do atacante, e toda
      // indicação que ela fizesse creditava o atacante. O código também nasce
      // zerado — contagem e crédito são escritos só pela arena, no resgate.
      allow create: if isAuthed()
        && nd().referrer_id == me()
        && referralId == nd().arena_id + '_' + me()
        && nd().get('redeemed_count', 0) == 0
        && !('redeemed_by' in nd())
        && !('reward_total' in nd());
      // Quem atualiza é a ARENA (resgate: contagem, quem foi creditado, quanto
      // foi creditado) — e sem trocar a arena, o dono nem o código. Antes o
      // próprio indicador podia reescrever a contagem e o código dele.
      allow update: if isAuthed() && (
        (arenaOd()
          && nd().arena_id == od().arena_id
          && nd().referrer_id == od().referrer_id
          && nd().get('code', null) == od().get('code', null))
        || isPlatformAdmin()
      );
      allow delete: if isAuthed() && (
        od().referrer_id == me()
        || arenaOd()
        || isPlatformAdmin()
      );
    }

    // Sprint 7: Operações (checklists, manutenção)
    match /arena_checklists/{checklistId} {
      allow read: if isAuthed();
      allow create: if arenaNd() || isPlatformAdmin();
      allow update: if arenaOd() || isPlatformAdmin();
      allow delete: if arenaOd() || isPlatformAdmin();
    }

    match /arena_maintenance_orders/{orderId} {
      allow read: if arenaOd() || isPlatformAdmin();
      allow create: if arenaNd() || isPlatformAdmin();
      allow update: if arenaOd() || isPlatformAdmin();
      allow delete: if arenaOd() || isPlatformAdmin();
    }

    // Sprints 8-11: IoT, Multi-unit (network)
    match /arena_devices/{deviceId} {
      allow read: if isAuthed();
      allow create: if arenaNd() || isPlatformAdmin();
      allow update: if arenaOd() || isPlatformAdmin();
      allow delete: if arenaOd() || isPlatformAdmin();
    }

    match /arena_networks/{networkId} {
      allow read: if isAuthed();
      // 🐞 Era `if isPlatformAdmin()` para tudo — e o módulo "multi-unidade" é
      // oferecido À ARENA, em Gestão → Configurações → Módulos. A arena
      // ligava o módulo, abria a tela, clicava em "Criar rede" e recebia
      // permissão negada: o módulo não tinha como funcionar para ninguém.
      //
      // Agora quem toca uma arena cria a PRÓPRIA rede. O dono da rede é quem
      // a criou, e ele precisa gerir a arena fundadora — sem isso qualquer
      // conta criaria redes em nome de arenas alheias.
      allow create: if isAuthed() && (
        isPlatformAdmin() || (
          nd().owner_id == me()
          && isArenaManager(nd().owner_arena_id)
        )
      );
      // O dono não muda de mãos por edição: quem edita continua sendo o dono.
      allow update: if isAuthed() && (
        isPlatformAdmin() || (
          od().owner_id == me()
          && nd().owner_id == me()
        )
      );
      allow delete: if isAuthed() && (
        isPlatformAdmin() || od().owner_id == me()
      );
    }

    match /arena_network_memberships/{membershipId} {
      allow read: if isAuthed();
      // Duas condições, as duas necessárias: só entra na rede a arena que EU
      // administro (senão eu colocaria a arena dos outros na minha rede e
      // passaria a ver os números dela), e só na rede que EU sou dono (senão
      // eu poluiria a rede alheia com uma unidade que ninguém convidou).
      //
      // Rede entre donos diferentes continua sendo caso do admin da
      // plataforma — é uma decisão comercial, não uma operação de tela.
      allow create: if isAuthed() && (
        isPlatformAdmin() || (
          arenaNd()
          && exists(/databases/$(database)/documents/arena_networks/$(nd().network_id))
          && get(/databases/$(database)/documents/arena_networks/$(nd().network_id)).data.owner_id == me()
        )
      );
      allow update: if isPlatformAdmin();
      // Sair da rede é direito de quem administra a unidade, e também do dono
      // da rede: prender uma arena numa rede seria a pior parte do módulo.
      allow delete: if isAuthed() && (
        isPlatformAdmin()
        || arenaOd()
        || (
          exists(/databases/$(database)/documents/arena_networks/$(od().network_id))
          && get(/databases/$(database)/documents/arena_networks/$(od().network_id)).data.owner_id == me()
        )
      );
    }

    // Sprint 2: Configuração de tiers (apenas platform admin)
    match /arena_tier_configs/{configId} {
      allow read: if isAuthed();
      allow write: if isPlatformAdmin();
    }

    // ---- Sprint 4 ORG-20: Circuitos (séries de torneios) ----
    // Sprint 4 ORG-20: admin de circuito
    function isCircuitAdmin(circuitId) {
      return isAuthed() && (
        isPlatformAdmin() ||
        (circuitId != null && exists(/databases/$(database)/documents/circuit_admins/$(circuitId + '_' + me())))
      );
    }
    match /circuits/{circuitId} {
      allow read: if true;
      allow create: if isAuthed();
      allow update, delete: if isCircuitAdmin(circuitId) || isPlatformAdmin();
    }
    match /circuit_admins/{adminId} {
      allow read: if isAuthed() && (isPlatformAdmin() || od().user_id == me());
      allow create, update, delete: if isPlatformAdmin() || (
        isAuthed() && get(/databases/$(database)/documents/circuits/$(adminId.split('_')[0])).data.created_by == me()
      );
    }
    match /circuit_tournaments/{linkId} {
      allow read: if true;
      allow create, delete: if isCircuitAdmin(linkId.split('_')[0]) || isPlatformAdmin();
    }
    match /circuit_results/{resultId} {
      allow read: if true;
      allow create, update, delete: if isCircuitAdmin(resultId.split('_')[0]) || isPlatformAdmin();
    }


    // ---- Sprint 5: Unavailabilities (admin marca slots como indisponíveis) ----
    // CORREÇÃO: a regra antiga era uma só para create/update/delete e olhava
    // `request.resource.data.arena_id` — que NÃO EXISTE num delete. Na prática,
    // nenhum gestor de arena conseguia apagar o próprio bloqueio (só o admin da
    // plataforma), embora a tela oferecesse o botão. Separada em três, cada uma
    // olhando o documento que de fato existe naquela operação. É ALARGAMENTO na
    // direção pretendida: ninguém perde acesso, e o gestor segue preso à sua
    // arena. O `update` confere as DUAS pontas para que um bloqueio não possa
    // ser mudado de arena.
    match /arena_unavailabilities/{unavId} {
      allow read: if true;
      allow create: if isAuthed() && (
        isPlatformAdmin() || arenaNd()
      );
      allow update: if isAuthed() && (
        isPlatformAdmin() || (
          arenaOd()
          && arenaNd()
        )
      );
      allow delete: if isAuthed() && (
        isPlatformAdmin() || arenaOd()
      );
    }

// ---- Sprint 4 PRO-15: Professores residentes ----
    // coaches/{uid} — perfil público do professor
    match /coaches/{coachId} {
      allow read: if true;
      allow create, update: if isAuthed() && (
        me() == coachId || isPlatformAdmin()
      );
      allow delete: if isPlatformAdmin();
    }
    // coach_favorites/{uid_coachId} — professor favorito do atleta
    match /coach_favorites/{favId} {
      allow read: if isOwner(favId.split('_')[0]);
      allow create: if isAuthed()
        && me() == favId.split('_')[0]
        && nd().user_id == me()
        && nd().coach_id == favId.split('_')[1];
      allow delete: if isOwner(favId.split('_')[0]);
    }
    // coach_arenas/{coachId_arenaId} — residência
    match /coach_arenas/{resId} {
      allow read: if true;
      allow create, update, delete: if isAuthed() && (
        isPlatformAdmin() ||
        // coach pode adicionar/remover residência dele
        me() == resId.split('_')[0] ||
        // arena manager pode adicionar/remover
        exists(/databases/$(database)/documents/arena_managers/$(resId.split('_')[1] + '_' + me()))
      );
    }

// ---- Produto de aulas do professor (flag coach_lessons) — aditivo ----
    // coach_availability/{coachId} — disponibilidade semanal (1 doc/professor).
    // Leitura pública (o aluno precisa ver horários); escrita só do professor.
    match /coach_availability/{coachId} {
      allow read: if true;
      allow create, update, delete: if isAuthed() && (
        me() == coachId || isPlatformAdmin()
      );
    }
    // coach_lessons/{lessonId} — aula (avulsa/recorrente).
    // Lê o professor e o aluno vinculado (e admin). O PROFESSOR (e o admin)
    // escreve a aula inteira. O ALUNO — quem é só `student_id` — PEDE e
    // CANCELA, e nada além (Onda CG, revisão):
    //  - pede: a aula nasce SOLICITADA, sem preço, e o cupom só PENDENTE —
    //    aplicado/recusado, desconto e preço são decisão do professor, na
    //    confirmação, conferidos contra o banco;
    //  - cancela: só o status vira `cancelled` (e `updated_at`).
    // 🐞 Antes o aluno escrevia qualquer campo: criava a aula já confirmada e
    // podia gravar um cupom "aplicado" com o desconto que quisesse — a agenda
    // do professor mostraria o preço forjado. Nenhuma tela faz isso; a regra
    // passa a dizer o mesmo que o serviço (`respondLesson`) sempre disse.
    function isLessonStudentRequest() {
      let d = nd();
      return d.get('status', '') == 'requested'
        && d.get('price', null) == null
        && (!('coupon' in d) || d.coupon == null || (
          d.coupon is map
          && d.coupon.keys().hasOnly(['coupon_id', 'code', 'benefit', 'kind', 'status'])
          && d.coupon.get('status', '') == 'pending'
        ));
    }
    function isLessonStudentCancel() {
      return chg().hasOnly(['status', 'updated_at'])
        && nd().status == 'cancelled'
        && od().get('status', '') in ['requested', 'negotiating', 'confirmed'];
    }
    match /coach_lessons/{lessonId} {
      allow read: if isAuthed() && (
        me() == od().coach_id ||
        me() == od().student_id ||
        isPlatformAdmin()
      );
      allow create: if isAuthed() && (
        me() == nd().coach_id ||
        isPlatformAdmin() ||
        (me() == nd().student_id && isLessonStudentRequest())
      );
      allow update: if isAuthed() && (
        me() == od().coach_id ||
        isPlatformAdmin() ||
        (me() == od().student_id && isLessonStudentCancel())
      );
      allow delete: if isAuthed() && (
        me() == od().coach_id || isPlatformAdmin()
      );
    }
    // coach_busy_slots/{coachId} — os horários JÁ CONFIRMADOS do professor
    // (só data e hora, sem aluno), escritos SÓ pelo servidor
    // (`functions/coachWaitlist.js`, `recalcularOcupados`). Público: é o que o
    // pedido de aula e o calendário do perfil descontam dos horários livres —
    // a consulta às aulas (`coach_lessons`) é recusada para quem não é parte.
    match /coach_busy_slots/{coachId} {
      allow read: if true;
      allow write: if false;
    }
    // coach_waitlist/{coachId_uid} — lista de espera do professor (aditivo,
    // 2026-10-16). O aluno sem horário livre entra e é avisado quando o
    // professor abrir horários ou uma aula confirmada for desfeita. Quem avisa
    // é o SERVIDOR (`functions/coachWaitlist.js`, que grava `notified_at` e
    // `notify_count` pelo Admin SDK) — por isso o aluno não grava esses campos.
    //  - o ALUNO cria e apaga a PRÓPRIA entrada (id `{coachId}_{uid}`), e edita
    //    só as preferências;
    //  - o PROFESSOR lê e apaga as da lista dele (não edita a entrada do aluno);
    //  - lê-se por CONSULTA (`user_id` ou `coach_id` == uid): `get` de id que
    //    não existe seria recusado.
    function isCoachWaitlistPrefs(d) {
      return d.get('note', '') is string && d.get('note', '').size() <= 500
        && d.get('student_name', '') is string && d.get('student_name', '').size() <= 120
        && d.get('coach_name', '') is string && d.get('coach_name', '').size() <= 120
        && d.get('periods', []) is list && d.get('periods', []).size() <= 3
        && d.get('weekdays', []) is list && d.get('weekdays', []).size() <= 7;
    }
    match /coach_waitlist/{wid} {
      allow read: if isAuthed() && (
        me() == od().user_id ||
        me() == od().coach_id ||
        isPlatformAdmin()
      );
      allow create: if isAuthed()
        && nd().user_id == me()
        && nd().coach_id is string
        && nd().coach_id != me()
        && wid == nd().coach_id + '_' + me()
        && exists(/databases/$(database)/documents/coaches/$(nd().coach_id))
        && nd().keys().hasOnly([
          'coach_id', 'user_id', 'student_name', 'coach_name', 'format', 'periods', 'weekdays', 'note',
          'created_at', 'created_at_ms', 'updated_at'
        ])
        && isCoachWaitlistPrefs(nd());
      allow update: if isAuthed()
        && me() == od().user_id
        && chg()
          .hasOnly(['student_name', 'format', 'periods', 'weekdays', 'note', 'updated_at'])
        && isCoachWaitlistPrefs(nd());
      allow delete: if isAuthed() && (
        me() == od().user_id ||
        me() == od().coach_id ||
        isPlatformAdmin()
      );
    }
    // coach_student_notes/{coachId_studentId} — notas privadas do professor sobre
    // o aluno. O vínculo (`coach_students`) é legível pelo aluno e regra não
    // esconde campo; por isso a nota mora aqui, só do professor e do admin.
    // Lê-se por CONSULTA (`coach_id == uid`): `get` de id inexistente seria recusado.
    match /coach_student_notes/{noteId} {
      allow read: if isAuthed() && (me() == od().coach_id || isPlatformAdmin());
      allow create: if isAuthed()
        && noteId == nd().coach_id + '_' + nd().student_id
        && (me() == nd().coach_id || isPlatformAdmin());
      allow update: if isAuthed()
        && nd().coach_id == od().coach_id
        && nd().student_id == od().student_id
        && (me() == od().coach_id || isPlatformAdmin());
      allow delete: if isAuthed() && (me() == od().coach_id || isPlatformAdmin());
    }
    // coach_students/{coachId_studentId} — vínculo aluno↔professor.
    // Lê o professor e o aluno. Cria/edita/remove o professor; o aluno pode
    // atualizar (aceitar o convite mudando o próprio status).
    match /coach_students/{linkId} {
      allow read: if isAuthed() && (
        me() == od().coach_id ||
        me() == od().student_id ||
        isPlatformAdmin()
      );
      // 🔒 F0 (2026-10-08): o id do vínculo É `{coach_id}_{student_id}` — é por
      // esse caminho que as regras decidem "aluno ativo" (conteúdo "só alunos",
      // treinos, envios do professor). Sem conferir o id, qualquer conta gravava
      // `{PROFESSOR}_{EU}` com `coach_id: EU` e lia o "só alunos" de outro
      // professor. Todo cliente já grava por `studentDocId(coach, aluno)`.
      allow create: if isAuthed()
        && linkId == nd().coach_id + '_' + nd().student_id
        && (me() == nd().coach_id || isPlatformAdmin());
      // 🔒 F0 (2026-10-08): o ALUNO só aceita o convite — muda `status` de
      // `invited` para `active` (e `updated_at`), nada mais. Antes a regra
      // deixava o aluno reescrever o documento inteiro, inclusive as notas
      // privadas do professor (`private_notes`) e as próprias tags. O único
      // caminho do cliente do aluno (`setStudentStatus`) já gravava só isso.
      // O professor (e o admin) não troca de quem é o vínculo: os dois ids ficam.
      //
      // 🔒 O vínculo vale ENQUANTO o professor for professor do aluno (decisão
      // do dono, 2026-10-09). Qualquer um dos dois encerra (`ended`, gravando
      // `ended_at`). Com `ended_at` no documento — encerrado, ou o novo convite
      // ainda sem resposta — o professor só convida de novo ou encerra: não
      // ativa, não pausa, não tira o `ended_at` e não apaga (apagar e criar de
      // novo como ativo desfaria a saída do aluno). Quem reativa é o ALUNO, ao
      // aceitar o convite, e é aí que o `ended_at` sai. Vínculo sem `ended_at`
      // segue exatamente como antes.
      allow update: if isAuthed() && (
        ((me() == od().coach_id || isPlatformAdmin())
          && nd().coach_id == od().coach_id
          && nd().student_id == od().student_id
          && (nd().get('status', '') != 'ended' || 'ended_at' in nd())
          && (!('ended_at' in od())
            || (nd().get('status', '') in ['ended', 'invited'] && 'ended_at' in nd()))) ||
        (me() == od().student_id
          && chg().hasOnly(['status', 'updated_at', 'ended_at', 'ended_by'])
          && (
            // aceitar o convite (o histórico de fim, se houver, sai junto)
            (od().status == 'invited'
              && nd().status == 'active'
              && !('ended_at' in nd())
              && !('ended_by' in nd()))
            // encerrar o vínculo, ou recusar o convite
            || (od().status in ['invited', 'active', 'paused']
              && nd().status == 'ended'
              && nd().get('ended_at', null) == request.time
              && nd().get('ended_by', '') == me())))
      );
      allow delete: if isAuthed() && (
        (me() == od().coach_id && !('ended_at' in od())
          && od().get('status', '') != 'ended')
        // A conta do aluno foi excluída (`users/{uid}` sai por último): a ficha
        // encerrada não guarda mais a história de ninguém, e o professor a tira.
        || (me() == od().coach_id
          && !exists(/databases/$(database)/documents/users/$(od().student_id)))
        || isPlatformAdmin()
      );
    }
    // coach_level_validations/{coachId_studentId} — nível validado por professor
    // (flag coach_leveling). Leitura pública (selo no perfil do atleta);
    // escreve/remove o professor (coach_id) ou admin.
    match /coach_level_validations/{validationId} {
      allow read: if true;
      // O selo é do professor que valida, sobre OUTRA pessoa, no id
      // `{coach}_{aluno}`: antes qualquer conta se dava o selo (`{eu}_{eu}`) e
      // sobrescrevia a validação de outro professor.
      allow create, update: if isAuthed() && (
        (me() == nd().coach_id
          && nd().coach_id != nd().student_id
          && validationId == nd().coach_id + '_' + nd().student_id
          && (resource == null || od().coach_id == me()))
        || isPlatformAdmin()
      );
      allow delete: if isAuthed() && (
        me() == od().coach_id || isPlatformAdmin()
      );
    }
    // coach_clinics/{id} — clínica/workshop aberto (flag coach_clinics).
    // Leitura pública (descoberta); escreve/remove o professor (coach_id)/admin.
    match /coach_clinics/{clinicId} {
      allow read: if true;
      allow create: if isAuthed() && (
        me() == nd().coach_id || isPlatformAdmin()
      );
      allow update, delete: if isAuthed() && (
        me() == od().coach_id || isPlatformAdmin()
      );
      // O atleta mexe só no contador de vagas, de um em um, junto com a
      // PRÓPRIA inscrição (mesmo lote): entra se ainda há vaga e a clínica
      // está aberta; sai devolvendo a vaga. É o contador que faz o teto valer
      // — contar as inscrições a regra não consegue.
      allow update: if isAuthed()
        && chg().hasOnly(['signup_count'])
        && (
          (nd().signup_count == od().get('signup_count', 0) + 1
            && nd().signup_count <= od().capacity
            && od().get('status', 'open') == 'open'
            && !exists(/databases/$(database)/documents/coach_clinic_signups/$(clinicId + '_' + me()))
            && existsAfter(/databases/$(database)/documents/coach_clinic_signups/$(clinicId + '_' + me())))
          || (nd().signup_count == od().get('signup_count', 0) - 1
            && nd().signup_count >= 0
            && exists(/databases/$(database)/documents/coach_clinic_signups/$(clinicId + '_' + me()))
            && !existsAfter(/databases/$(database)/documents/coach_clinic_signups/$(clinicId + '_' + me())))
        );
    }
    // coach_clinic_signups/{clinicId_athleteId} — inscrição do atleta.
    // Leitura pública (contagem de vagas); cria o próprio atleta — com o id,
    // o professor e a vaga conferidos (o contador da clínica sobe no mesmo
    // lote); remove o próprio atleta, o professor da clínica ou admin.
    match /coach_clinic_signups/{signupId} {
      allow read: if true;
      allow create: if isAuthed()
        && me() == nd().athlete_id
        && nd().clinic_id is string
        && signupId == nd().clinic_id + '_' + me()
        && exists(/databases/$(database)/documents/coach_clinics/$(nd().clinic_id))
        && nd().coach_id == get(/databases/$(database)/documents/coach_clinics/$(nd().clinic_id)).data.coach_id
        && getAfter(/databases/$(database)/documents/coach_clinics/$(nd().clinic_id)).data.get('signup_count', 0)
          == get(/databases/$(database)/documents/coach_clinics/$(nd().clinic_id)).data.get('signup_count', 0) + 1;
      allow delete: if isAuthed() && (
        me() == od().athlete_id ||
        me() == od().coach_id ||
        isPlatformAdmin()
      );
    }
    // coach_packages/{id} — definição de pacote. Leitura pública (aluno vê a
    // oferta); escrita do professor/admin.
    match /coach_packages/{packageId} {
      allow read: if true;
      allow create: if isAuthed() && (
        me() == nd().coach_id || isPlatformAdmin()
      );
      allow update, delete: if isAuthed() && (
        me() == od().coach_id || isPlatformAdmin()
      );
    }
    // coach_package_sales/{id} — venda/crédito. Lê o professor e o aluno;
    // escreve o professor/admin.
    match /coach_package_sales/{saleId} {
      allow read: if isAuthed() && (
        me() == od().coach_id ||
        me() == od().student_id ||
        isPlatformAdmin()
      );
      allow create: if isAuthed() && (
        me() == nd().coach_id || isPlatformAdmin()
      );
      allow update, delete: if isAuthed() && (
        me() == od().coach_id || isPlatformAdmin()
      );
    }
    // coach_content/{id} — biblioteca de conteúdo do professor. Lê: público, o
    // professor, e alunos com vínculo ATIVO (coach_students/{coachId_uid} com
    // status `active`). Escreve: o professor/admin.
    // 🔒 F0 (2026-10-08): antes bastava o vínculo EXISTIR — o convidado que
    // nunca aceitou e o aluno pausado liam o "só alunos". A tela
    // (V2CoachProfile) já exigia vínculo ativo; agora a regra também.
    match /coach_content/{contentId} {
      allow read: if od().visibility == 'public' || (isAuthed() && (
        me() == od().coach_id ||
        isPlatformAdmin() ||
        isActiveStudentOf(od().coach_id)
      ));
      allow create: if isAuthed() && (
        me() == nd().coach_id || isPlatformAdmin()
      );
      allow update, delete: if isAuthed() && (
        me() == od().coach_id || isPlatformAdmin()
      );
    }
    // coach_products/{id} — loja do professor. Lê: produtos públicos (qualquer
    // um) e todos os do próprio professor/admin. Escreve: o professor/admin.
    match /coach_products/{productId} {
      allow read: if od().visible_public == true || (isAuthed() && (
        me() == od().coach_id || isPlatformAdmin()
      ));
      allow create: if isAuthed() && (
        me() == nd().coach_id || isPlatformAdmin()
      );
      allow update, delete: if isAuthed() && (
        me() == od().coach_id || isPlatformAdmin()
      );
    }


    // ---- Sprint 5: Inventory / Mercado ----
    // O `delete` destas três olhava `request.resource.data.arena_id`, que num
    // delete é NULO: na prática, nenhum gestor conseguia remover produto,
    // entrada ou saída do estoque. Mesma família de defeito já corrigida em
    // `arena_unavailabilities`.
    match /arena_inventory_products/{productId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && (
        isPlatformAdmin() || arenaNd()
      );
      allow update, delete: if isAuthed() && (
        isPlatformAdmin() || arenaOd()
      );
    }
    match /arena_inventory_entries/{entryId} {
      allow read: if isAuthed() && (
        isPlatformAdmin() || arenaOd()
      );
      allow create: if isAuthed() && (
        isPlatformAdmin() || arenaNd()
      );
      allow update, delete: if isAuthed() && (
        isPlatformAdmin() || arenaOd()
      );
    }
    match /arena_inventory_exits/{exitId} {
      allow read: if isAuthed() && (
        isPlatformAdmin() || arenaOd()
      );
      allow create: if isAuthed() && (
        isPlatformAdmin() || arenaNd()
      );
      allow update, delete: if isAuthed() && (
        isPlatformAdmin() || arenaOd()
      );
    }

    // ---- Catálogo padrão de produtos (flag arena_product_catalog) ----
    // Listagem geral compartilhada: leitura por qualquer autenticado. Criação
    // por platform_admin OU por gestor da arena que está contribuindo (o doc
    // deve declarar contributed_by_arena_id da qual o usuário é gestor).
    // Atualização/remoção (moderação) apenas por platform_admin.
    match /catalog_products/{productId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && (
        isPlatformAdmin() ||
        (
          nd().contributed_by_arena_id != null &&
          isArenaManager(nd().contributed_by_arena_id)
        )
      );
      allow update, delete: if isPlatformAdmin();
    }

    // ---- Relatórios do mercado (flag arena_market_reports) ----
    // Snapshots financeiros por período. Só o gestor da arena (ou admin) lê e
    // escreve. Id determinístico arenaId_periodType_periodKey.
    match /arena_market_reports/{reportId} {
      allow read: if isAuthed() && (
        isPlatformAdmin() ||
        exists(/databases/$(database)/documents/arena_managers/$(od().arena_id + '_' + me()))
      );
      allow create: if isAuthed() && (
        isPlatformAdmin() ||
        arenaNd()
      );
      allow update, delete: if isAuthed() && (
        isPlatformAdmin() ||
        arenaOd()
      );
    }

    // ---- Registro de exportação DUPR (flags dupr_match_export / dupr_official_sync) ----
    // Ledger por partida (id = id da partida) com a situação perante o DUPR
    // (exported/submitted) e os carimbos de data. Governança sensível: apenas o
    // platform_admin lê e escreve. Aditivo — sem a feature, a coleção nem existe.
    match /dupr_export_log/{matchId} {
      allow read, write: if isPlatformAdmin();
    }

    // ---- GAMIFICATION V2 (flag GAMIFICATION_V2) --------------------------------
    // Coleções materializadas adicionadas pela feature de gamificação V2.
    //
    // POLÍTICA GERAL
    //  - Dono escreve o próprio doc; platform_admin escreve qualquer um.
    //  - Onde a feature exige escrita cruzada (dar kudo mexe no índice de quem
    //    recebe; entrar numa crew mexe no contador da crew), a permissão é
    //    ESTREITA: só os campos daquele fluxo, com delta controlado.
    //  - Perfis/rankings públicos são legíveis por qualquer autenticado — sem
    //    isso o Hall da Fama e /conquistas/:uid ficariam vazios para todo mundo.
    //
    // CUIDADO AO CRIAR: em `create`, `resource` é null. Toda condição precisa
    // olhar `request.resource.data` — usar `resource.data` num create derruba a
    // regra inteira e nega a escrita (foi exatamente o bug de rivals/mentorias).
    //
    // ADITIVO: coleções que ainda não existem em produção não têm requests.
    // As regras existem para quando a flag for ativada.

    // Vocabulário de tiers — espelha `TIER_NAMES` em
    // src/modules/progression/domain/tiers.js. Ao mexer lá, mexa aqui.
    function gamificationTierNames() {
      return [
        'Calouro', 'Aprendiz', 'Jogador', 'Regular', 'Veterano',
        'Expert', 'Elite', 'Lenda', 'Imortal'
      ];
    }

    // Campos que um doc de progressão pode ter (nada além disso é aceito).
    function progressionV2FieldsOk() {
      return nd().xpTotal is int
        && nd().xpTotal >= 0
        && nd().level is int
        && nd().level >= 1
        && nd().level <= 200
        && nd().tier in gamificationTierNames()
        && nd().skillTrees is list
        && nd().skillTrees.size() == 5
        // Aditivo e opcional: o XP que o servidor concedeu (o prêmio de
        // temporada não pode contar como XP do mês seguinte).
        && nd().get('grantsXp', 0) is int
        && nd().get('grantsXp', 0) >= 0;
    }

    // user_progression_v2/{uid} — snapshot materializado de XP/tier/level/skilltrees
    // Leitura pública (autenticada): alimenta Hall da Fama e perfil público de
    // conquistas. Só carrega números de progresso — nada sensível.
    // A pessoa decide se o tier e as conquistas dela aparecem para os outros
    // (`user_gamification_prefs.privacy.showOnPublicProfile`). Sem preferência
    // gravada vale o padrão (aparece). É a regra — e não a tela — quem barra:
    // quem abrir o documento por fora do app recebe o mesmo "permissão negada".
    function gamificationPublicOk(uid) {
      return !exists(/databases/$(database)/documents/user_gamification_prefs/$(uid))
        || get(/databases/$(database)/documents/user_gamification_prefs/$(uid)).data.get('privacy', {}).get('showOnPublicProfile', true) != false;
    }
    match /user_progression_v2/{uid} {
      allow read: if isAuthed() && (isOwner(uid) || isPlatformAdmin() || gamificationPublicOk(uid));
      allow create: if isOwner(uid)
        && nd().uid == uid
        && nd().schemaVersion == 1
        && progressionV2FieldsOk();
      allow update: if (isOwner(uid) || isPlatformAdmin())
        && nd().uid == od().uid
        && nd().schemaVersion == od().schemaVersion
        && progressionV2FieldsOk();
      allow create, update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // user_missions/{uid}_{date} — missões geradas (docId = uid + "_" + YYYY-MM-DD)
    // Privado: só o dono e o admin.
    // O id carrega o período (`{uid}_{dia}`, `{uid}_w_{segunda}`, `{uid}_m_{dia 1}`),
    // então cada pessoa tem no máximo UM documento por dia, semana e mês — não dá
    // para fabricar documentos de missão em série para inflar o XP. O XP que cada
    // documento vale também tem teto por escopo (o legítimo fica bem abaixo).
    function missionDocShapeOk(missionId) {
      return nd().date is string
        && nd().date.matches('^20[2-3][0-9]-[0-1][0-9]-[0-3][0-9]$')
        && (
          (nd().scope == 'daily'
            && missionId == nd().uid + '_' + nd().date)
          || (nd().scope == 'weekly'
            && missionId == nd().uid + '_w_' + nd().date)
          || (nd().scope == 'monthly'
            && missionId == nd().uid + '_m_' + nd().date)
        )
        && nd().get('xpEarned', 0) is int
        && nd().get('xpEarned', 0) >= 0
        && nd().get('xpEarned', 0) <= (
          nd().scope == 'daily' ? 600
          : (nd().scope == 'weekly' ? 1500 : 5000)
        );
    }
    match /user_missions/{missionId} {
      allow read: if isAuthed() && (
        resource == null || me() == od().uid || isPlatformAdmin()
      );
      allow create: if isOwner(nd().uid)
        && nd().scope in ['daily', 'weekly', 'monthly']
        && nd().missions is list
        && missionDocShapeOk(missionId);
      allow update: if isOwner(od().uid)
        && nd().uid == me()
        && nd().scope == od().scope
        && nd().date == od().date
        && missionDocShapeOk(missionId);
      allow delete: if isPlatformAdmin();
    }

    // user_achievements_v2/{uid}_{achId} — conquistas desbloqueadas
    // Leitura pública (autenticada): é o conteúdo de /conquistas/:uid.
    match /user_achievements_v2/{achId} {
      allow read: if isAuthed() && (
        resource == null || od().uid == me() || isPlatformAdmin()
        || gamificationPublicOk(od().uid)
      );
      allow create: if isOwner(nd().uid)
        && nd().progress is number
        && nd().progress >= 0
        && nd().progress <= 1;
      // progresso pode avançar (0.3 → 0.6) mas NUNCA regredir; o resto do doc
      // (shareCount, notified) é livre para o dono.
      allow update: if isOwner(od().uid)
        && nd().uid == me()
        && nd().achievementId == od().achievementId
        && nd().progress is number
        && nd().progress >= od().progress
        && nd().progress <= 1;
      allow delete: if isPlatformAdmin();
    }

    // user_streak_meta/{uid} — grace + freeze + vacation + comeback
    // Privado. freezesUsed é acumulativo (sem teto) — só nunca pode regredir.
    match /user_streak_meta/{uid} {
      allow read: if isAuthed() && (me() == uid || isPlatformAdmin());
      allow create, update: if isAuthed() && (me() == uid || isPlatformAdmin())
        && nd().uid == uid
        && nd().graceDaysRemaining is int
        && nd().graceDaysRemaining >= 0
        && nd().graceDaysRemaining <= 3
        && nd().freezesAvailable is int
        && nd().freezesAvailable >= 0
        && nd().freezesAvailable <= 3
        && nd().freezesUsed is int
        && nd().freezesUsed >= 0;
      allow delete: if isPlatformAdmin();
    }

    // ---- Gamificação V2 · sub-sistemas (Fase 16) -------------------------

    // user_referral_codes/{uid} — código + métricas de referral do referrer
    // O dono cria/edita. O referee (outra pessoa) só pode incrementar os
    // contadores do referrer ao usar o código — e apenas de 1 em 1.
    function referralCodeShapeOk() {
      return nd().uid == od().uid
        && nd().schemaVersion == 2
        && nd().code == od().code
        && nd().monthlyCount is int
        && nd().monthlyCount >= 0
        && nd().monthlyCount <= 50;
    }
    match /user_referral_codes/{uid} {
      allow read: if isAuthed();
      allow create: if isAuthed() && (me() == uid || isPlatformAdmin())
        && nd().uid == uid
        && nd().schemaVersion == 2
        && nd().code is string
        && nd().monthlyCount is int
        && nd().monthlyCount >= 0
        && nd().monthlyCount <= 50;
      allow update: if isAuthed() && (me() == uid || isPlatformAdmin())
        && nd().uid == uid
        && nd().schemaVersion == 2
        && nd().monthlyCount is int
        && nd().monthlyCount >= 0
        && nd().monthlyCount <= 50;
      // crédito de indicação vindo de terceiro: só sobe contadores, +1 por vez
      allow update: if isAuthed() && me() != uid
        && referralCodeShapeOk()
        && nd().totalSignups >= od().totalSignups
        && nd().totalSignups <= od().totalSignups + 1
        && nd().totalActivated >= od().totalActivated
        && nd().totalActivated <= od().totalActivated + 1
        && nd().totalXpEarned >= od().totalXpEarned;
      allow delete: if isPlatformAdmin();
    }

    // user_referrals/{refereeUid} — quem indicou esse user
    match /user_referrals/{refereeUid} {
      allow read: if isAuthed() && (
        resource == null
        || me() == od().refereeUid
        || me() == od().referrerUid
        || isPlatformAdmin()
      );
      // criado pelo próprio indicado (docId = uid dele) ou pelo admin
      allow create: if isAuthed()
        && nd().refereeUid == refereeUid
        && nd().referrerUid != refereeUid
        && (me() == refereeUid || isPlatformAdmin());
      // os dois lados podem atualizar, sem trocar quem é quem
      allow update: if isAuthed()
        && nd().refereeUid == od().refereeUid
        && nd().referrerUid == od().referrerUid
        && (
          me() == od().refereeUid
          || me() == od().referrerUid
          || isPlatformAdmin()
        );
      allow delete: if isPlatformAdmin();
    }

    // user_kudos/{kudoId} — kudos dados (visíveis para os 2 envolvidos)
    match /user_kudos/{kudoId} {
      allow read: if isAuthed() && (
        resource == null
        || me() == od().fromUid
        || me() == od().toUid
        || isPlatformAdmin()
      );
      // só pode criar se você é o fromUid
      allow create: if isOwner(nd().fromUid)
        && nd().toUid != me()
        && nd().toUid is string
        && nd().type is string;
      // não pode editar nem deletar (kudo é imutável)
      allow update, delete: if isPlatformAdmin();
    }

    // user_kudos_index/{uid} — contadores diários e totais
    // Quem dá o kudo precisa incrementar o índice de quem recebe: liberado,
    // mas só os contadores de recebimento e só +1 por vez.
    function kudoIndexShapeOk(uid) {
      return nd().uid == uid
        && nd().schemaVersion == 2
        && nd().receivedToday is int
        && nd().receivedToday >= 0
        && nd().receivedToday <= 100
        && nd().givenToday is int
        && nd().givenToday >= 0
        && nd().givenToday <= 50;
    }
    match /user_kudos_index/{uid} {
      allow read: if isAuthed() && (me() == uid || isPlatformAdmin());
      allow create: if isAuthed() && kudoIndexShapeOk(uid)
        && (
          me() == uid
          || isPlatformAdmin()
          // criação do índice de quem recebe o primeiro kudo
          || (nd().receivedCount == 1 && nd().givenCount == 0)
        );
      allow update: if isAuthed() && kudoIndexShapeOk(uid)
        && (me() == uid || isPlatformAdmin());
      // terceiro creditando um kudo recebido: só sobe recebidos, +1, e não
      // mexe nos contadores de quem deu
      allow update: if isAuthed() && me() != uid
        && kudoIndexShapeOk(uid)
        && nd().receivedCount == od().receivedCount + 1
        && nd().givenCount == od().givenCount;
      allow delete: if isPlatformAdmin();
    }

    // user_rivals/{pairKey} — par de rivais (os dois lados escrevem)
    match /user_rivals/{pairKey} {
      allow read: if isAuthed() && (
        resource == null
        || me() == od().userA
        || me() == od().userB
        || isPlatformAdmin()
      );
      allow create: if isAuthed()
        && nd().pairKey == pairKey
        && nd().userA != nd().userB
        && (
          me() == nd().userA
          || me() == nd().userB
          || isPlatformAdmin()
        );
      allow update: if isAuthed()
        && nd().userA == od().userA
        && nd().userB == od().userB
        && (
          me() == od().userA
          || me() == od().userB
          || isPlatformAdmin()
        );
      allow delete: if isPlatformAdmin();
    }

    // crews/{crewId} — crew pública ou privada
    // Privada continua legível pelos membros (senão o próprio membro não vê
    // a crew em que está).
    function isCrewMember(crewId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/crew_members/$(crewId + '_' + me()));
    }
    match /crews/{crewId} {
      allow read: if isAuthed() && (
        resource == null
        || od().isPublic == true
        || me() == od().createdBy
        || isCrewMember(crewId)
        || isPlatformAdmin()
      );
      allow create: if isOwner(nd().createdBy)
        && nd().crewId == crewId
        && nd().schemaVersion == 2
        && nd().membersCount is int
        && nd().membersCount >= 1
        && nd().membersCount <= 50;
      allow update: if isAuthed()
        && nd().createdBy == od().createdBy
        && (me() == od().createdBy || isPlatformAdmin());
      // entrar/sair mexe só no contador, de 1 em 1, dentro do limite
      allow update: if isAuthed()
        && nd().createdBy == od().createdBy
        && nd().name == od().name
        && nd().isPublic == od().isPublic
        && nd().membersCount is int
        && nd().membersCount >= 1
        && nd().membersCount <= 50
        && (
          nd().membersCount == od().membersCount + 1
          || nd().membersCount == od().membersCount - 1
        );
      allow delete: if isAuthed() && (me() == od().createdBy || isPlatformAdmin());
    }

    // crew_members/{crewId}_{uid} — membros de crew
    // Membro da crew enxerga os colegas (senão a lista de membros vem vazia).
    match /crew_members/{memberId} {
      allow read: if isAuthed();
      allow create: if isOwner(nd().uid)
        && memberId == nd().crewId + '_' + me()
        && nd().role in ['owner', 'captain', 'member']
        // Dono/capitão só quem criou a turma; e turma privada só o criador
        // entra por aqui (antes qualquer conta entrava como "owner" e lia).
        && (getAfter(/databases/$(database)/documents/crews/$(nd().crewId)).data.createdBy == me()
            || (nd().role == 'member'
                && getAfter(/databases/$(database)/documents/crews/$(nd().crewId)).data.get('isPublic', false) == true));
      allow update: if isPlatformAdmin()
        || (isOwner(od().uid)
            && !chg().hasAny(['uid', 'crewId', 'role']));
      allow delete: if isAuthed() && (me() == od().uid || isPlatformAdmin());
    }

    // mentorships/{pairKey} — mentoria (os dois lados escrevem)
    // Mentoria é um vínculo entre DUAS pessoas: ninguém entra em uma sem aceitar.
    // O convite nasce `pending` com `proposedBy` (quem o fez) e só a OUTRA pessoa
    // o torna `active`; quem convidou pode apenas retirá-lo. Mentoria já ativa
    // segue como era. Criar direto como ativa (sem convite) é só do admin.
    match /mentorships/{pairKey} {
      allow read: if isAuthed() && (
        resource == null
        || me() == od().mentorUid
        || me() == od().apprenticeUid
        || isPlatformAdmin()
      );
      allow create: if isAuthed()
        && nd().pairKey == pairKey
        && nd().schemaVersion == 2
        && nd().mentorUid != nd().apprenticeUid
        && nd().status in ['pending', 'active', 'paused', 'completed', 'cancelled']
        && (
          (nd().status == 'pending'
            && nd().get('proposedBy', '') == me()
            && (me() == nd().mentorUid
              || me() == nd().apprenticeUid))
          || isPlatformAdmin()
        );
      allow update: if isAuthed()
        && nd().schemaVersion == 2
        && nd().mentorUid == od().mentorUid
        && nd().apprenticeUid == od().apprenticeUid
        && nd().status in ['pending', 'active', 'paused', 'completed', 'cancelled']
        && nd().get('proposedBy', '') == od().get('proposedBy', '')
        && (
          me() == od().mentorUid
          || me() == od().apprenticeUid
          || isPlatformAdmin()
        )
        && (
          isPlatformAdmin()
          // Depois de respondido, vale o que sempre valeu.
          || (od().status != 'pending' && nd().status != 'pending')
          // Convite em aberto: qualquer lado o encerra (recusa ou retira)...
          || (od().status == 'pending' && nd().status in ['pending', 'cancelled'])
          // ...mas só quem NÃO convidou o aceita.
          || (od().status == 'pending' && nd().status == 'active'
              && me() != od().get('proposedBy', ''))
        );
      allow delete: if isPlatformAdmin();
    }

    // season_rankings/{seasonId}_{uid} — XP sazonal
    // Leitura aberta (autenticada): é um placar público.
    // Escrita só admin / Cloud Function sazonal — o cliente não decide posição.
    match /season_rankings/{rid} {
      allow read: if isAuthed();
      allow create, update, delete: if isPlatformAdmin();
    }

    // ---- Divulgação da PLATAFORMA e dos PROFESSORES (Onda CG) --------------
    // Cupons e campanhas com as mesmas ferramentas do marketing da arena, para
    // dois emissores novos (flags `platform_marketing` / `coach_marketing`).
    // ADITIVO: três coleções novas, nenhuma regra existente tocada.
    //
    // O emissor é `issuer_type` + `issuer_id`:
    //  - 'platform' + 'platform' → só o admin da plataforma;
    //  - 'coach' + uid           → só o próprio professor, e só se ele TEM
    //    perfil de professor (`coaches/{uid}` existe — é o que o impede de
    //    virar "professor" só para divulgar).
    // Ninguém cria em nome de outro emissor, e o emissor não muda no update
    // (a mesma trava do cupom da arena): senão um cupom viraria promoção de
    // outro professor sem ele saber.
    function isPromoIssuer(type, id) {
      return isAuthed() && (
        (type == 'platform' && id == 'platform' && isPlatformAdmin())
        || (type == 'coach' && id == me()
          && exists(/databases/$(database)/documents/coaches/$(me())))
        // PR 4: a federação (módulo `promos`) emite pela equipe de comunicação.
        || (type == 'federation' && fedOn() && fedModuleOn(id, 'promos')
          && (fedAny(id, ['comms', 'admin'])))
      );
    }
    function promoIssuerKept() {
      return nd().issuer_type == od().issuer_type
        && nd().issuer_id == od().issuer_id;
    }
    // Legível por conta logada (o atleta vê a promoção e confere o código),
    // como `arena_coupons`. Por isso o CUSTO do vale não mora aqui: fica em
    // `promo_settings`, que só o emissor lê. O admin pode pausar/apagar (moderação).
    match /promo_coupons/{couponId} {
      allow read: if isAuthed();
      allow create: if isPromoIssuer(nd().issuer_type, nd().issuer_id)
        && (nd().issuer_type != 'federation' || fedPublic(nd().issuer_id));
      allow update: if (isPromoIssuer(od().issuer_type, od().issuer_id) && promoIssuerKept())
        || isPlatformAdmin();
      allow delete: if isPromoIssuer(od().issuer_type, od().issuer_id) || isPlatformAdmin();
    }
    match /promo_campaigns/{campaignId} {
      allow read: if isAuthed();
      allow create: if isPromoIssuer(nd().issuer_type, nd().issuer_id)
        && (nd().issuer_type != 'federation' || fedPublic(nd().issuer_id));
      allow update: if (isPromoIssuer(od().issuer_type, od().issuer_id) && promoIssuerKept())
        || isPlatformAdmin();
      allow delete: if isPromoIssuer(od().issuer_type, od().issuer_id) || isPlatformAdmin();
    }
    // Configurações PRIVADAS do emissor: modelos de banner e de cupom, e o
    // custo interno de cada vale. Id = 'platform' ou o uid do professor.
    match /promo_settings/{issuerId} {
      allow read, write: if isPlatformAdmin()
        || (issuerId != 'platform' && (isPromoIssuer('coach', issuerId) || isPromoIssuer('federation', issuerId)));
    }

    // ======================================================================
    // GAMIFICAÇÃO V2 — a camada completa (Onda DA)
    //
    // ADITIVO: coleções novas, nenhuma regra existente mudou (a lista de tipos
    // de notificação ganhou 'gamification', só isso). Princípio de todas: o que
    // define POSIÇÃO, PRÊMIO, REPUTAÇÃO ou XP CONCEDIDO é escrito só pelo
    // servidor (Admin SDK ignora as regras) — o cliente só escreve o que é ato
    // dele: preferências, entrar num desafio, avaliar, pedir uma recompensa.
    // ======================================================================

    // Quem pode ser o EMISSOR de um desafio, recompensa ou meta:
    //  · plataforma  → só o admin;
    //  · arena       → quem gere a arena;
    //  · clube       → admin do clube;
    //  · professor   → o próprio professor, que tem perfil de professor.
    function isGamificationIssuer(type, id) {
      return isAuthed() && (
        (type == 'platform' && id == 'platform' && isPlatformAdmin())
        || (type == 'arena' && isArenaManager(id))
        || (type == 'club' && isClubAdmin(id))
        || (type == 'coach' && id == me()
          && exists(/databases/$(database)/documents/coaches/$(me())))
      );
    }
    function gamificationIssuerKept() {
      return nd().issuerType == od().issuerType
        && nd().issuerId == od().issuerId
        && nd().createdBy == od().createdBy;
    }

    // user_gamification_prefs/{uid} — o que a pessoa decide sobre a própria
    // gamificação. PRIVADO: o servidor (que ignora as regras) o lê para
    // respeitar a escolha — não aparecer no placar, não receber duelo etc.
    match /user_gamification_prefs/{uid} {
      allow read: if isOwner(uid) || isPlatformAdmin();
      allow create, update: if isOwner(uid)
        && nd().keys().hasOnly([
          'uid', 'schemaVersion', 'privacy', 'social', 'notifications',
          'display', 'onboarding', 'celebrated'
        ])
        && nd().get('uid', uid) == uid
        && nd().schemaVersion == 1
        && nd().privacy is map
        && nd().social is map
        && nd().notifications is map
        && nd().display is map
        && nd().onboarding is map
        && nd().onboarding.done is map
        // Tetos que valem para o XP: o roteiro de primeiros passos tem 9
        // etapas, e só ids conhecidos contam no cálculo.
        && nd().onboarding.done.size() <= 24
        && nd().celebrated is map
        && nd().celebrated.size() <= 120;
      allow delete: if isOwner(uid) || isPlatformAdmin();
    }

    // user_xp_grants/{uid}_{tipo}_{ref} — XP que o SERVIDOR concede (prêmio de
    // temporada, duelo, desafio). Ninguém escreve pelo cliente, o admin
    // inclusive: a conta fecha na regra, não na boa vontade de quem usa o app.
    match /user_xp_grants/{grantId} {
      allow read: if (isOwner(od().uid) || isPlatformAdmin());
      allow write: if false;
    }

    // gamification_moderation/{uid} — decisão do admin sobre uma conta: tirar do
    // placar (`excluded`) ou só ocultar do público (`hiddenFromPublic`).
    match /gamification_moderation/{uid} {
      allow read, write: if isPlatformAdmin();
    }

    // gamification_flags/{id} — sinais de integridade que o SERVIDOR abre e o
    // admin revisa. O admin só muda o veredito, nunca o sinal.
    match /gamification_flags/{flagId} {
      allow read: if isPlatformAdmin();
      allow update: if isPlatformAdmin()
        && chg()
          .hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt'])
        && nd().status in ['open', 'reviewed', 'dismissed', 'actioned'];
      allow create, delete: if false;
    }

    // gamification_metrics/{dia} e gamification_integrity/{uid} — o retrato
    // diário do funil (admin lê) e a fotografia de XP da última passada (só o
    // servidor). Sem escrita de cliente.
    match /gamification_metrics/{day} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /gamification_integrity/{uid} {
      allow read, write: if false;
    }

    // hall_of_fame/{uid} — o placar de todos os tempos, SÓ com quem aceitou
    // aparecer (o servidor remove na hora quem deixa de aceitar).
    match /hall_of_fame/{uid} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // match_reviews/{jogo}__{autor}__{avaliado} — a avaliação pós-jogo. Quem
    // LÊ é só o autor (e o admin): o avaliado nunca vê "quem deu quanto", só o
    // agregado em `user_reputation`. Imutável: sem edição, e a única saída é
    // retirar (apagar). Sem texto livre — estrelas, elogios e categorias.
    match /match_reviews/{reviewId} {
      allow read: if (isOwner(od().fromUid) || isPlatformAdmin());
      allow create: if isAuthed()
        && nd().keys().hasOnly([
          'fromUid', 'toUid', 'matchKey', 'rating', 'tags', 'issues', 'relation', 'createdAt'
        ])
        && nd().fromUid == me()
        && nd().toUid is string
        && nd().toUid != me()
        && nd().matchKey is string
        && nd().matchKey.size() > 0
        && nd().matchKey.size() <= 120
        && nd().rating is int
        && nd().rating >= 1
        && nd().rating <= 5
        && nd().tags is list
        && nd().tags.size() <= 4
        && nd().issues is list
        && nd().issues.size() <= 4
        // 1–2 estrelas exigem motivo (a regra do estudo: nota baixa se justifica).
        && (nd().rating > 2 || nd().issues.size() >= 1)
        && nd().createdAt is number
        // Uma por jogo e por par: o id carrega os dois lados.
        && reviewId.matches('^.+__' + me() + '__' + nd().toUid + '$');
      allow update: if false;
      allow delete: if (isOwner(od().fromUid) || isPlatformAdmin());
    }

    // user_reputation/{uid} (público) e user_reputation_private/{uid} (o
    // avaliado e o admin) — agregados que só o servidor escreve.
    match /user_reputation/{uid} {
      allow read: if isAuthed();
      allow write: if false;
    }
    match /user_reputation_private/{uid} {
      allow read: if isOwner(uid) || isPlatformAdmin();
      allow write: if false;
    }

    // partner_letters/{jogo}__{autor}__{destinatário} — a carta ao companheiro.
    // O documento que o DESTINATÁRIO lê não carrega o autor quando é anônima
    // (`fromUid` nulo); a identidade vai para `partner_letter_authors`, legível
    // só por quem escreveu e pelo admin (moderação). O destinatário só marca
    // como lida ou denuncia — não edita o texto.
    match /partner_letters/{letterId} {
      allow read: if (isOwner(od().toUid) || isPlatformAdmin());
      allow create: if isAuthed()
        && nd().keys().hasOnly([
          'toUid', 'fromUid', 'fromName', 'text', 'showName', 'matchKey', 'createdAt', 'readAt', 'reported'
        ])
        && nd().toUid is string
        && nd().toUid != me()
        && nd().text is string
        && nd().text.size() >= 3
        && nd().text.size() <= 280
        && nd().showName is bool
        // Anônima: nenhum rastro do autor no documento do destinatário.
        && (nd().showName == true
            ? nd().fromUid == me()
            : (nd().fromUid == null && nd().get('fromName', null) == null))
        && nd().get('reported', false) == false
        && nd().get('readAt', null) == null
        && letterId.matches('^.+__' + me() + '__' + nd().toUid + '$')
        // E o autor tem de estar registrado, no MESMO lote — sem ele a
        // moderação não teria como chegar a quem escreveu.
        && getAfter(/databases/$(database)/documents/partner_letter_authors/$(letterId)).data.fromUid == me();
      allow update: if isOwner(od().toUid)
        && chg().hasOnly(['readAt', 'reported']);
      allow delete: if isOwner(od().toUid) || isPlatformAdmin();
    }
    match /partner_letter_authors/{letterId} {
      allow read: if (isOwner(od().fromUid) || isPlatformAdmin());
      allow create: if isAuthed()
        && nd().keys().hasOnly(['fromUid', 'toUid', 'matchKey', 'createdAt'])
        && nd().fromUid == me()
        && nd().toUid != me()
        && letterId.matches('^.+__' + me() + '__' + nd().toUid + '$');
      allow update, delete: if isPlatformAdmin();
    }

    // gamification_challenges/{id} — desafios e eventos. O EMISSOR cria e edita
    // o que é dele; ninguém muda de dono; só o servidor encerra (`finished`).
    // Rascunho só o emissor vê. O XP de prêmio de um desafio que não é da
    // plataforma NÃO é concedido — a regra não olha dentro da lista de prêmios,
    // então quem garante é a função que fecha o desafio.
    match /gamification_challenges/{challengeId} {
      allow read: if isAuthed() && (
        od().status != 'draft'
        || isGamificationIssuer(od().issuerType, od().issuerId)
        || isPlatformAdmin()
      );
      allow create: if isGamificationIssuer(nd().issuerType, nd().issuerId)
        && nd().createdBy == me()
        && nd().status in ['draft', 'active']
        && nd().title is string
        && nd().title.size() >= 4
        && nd().title.size() <= 80
        && nd().metric is string
        && nd().subject in ['athlete', 'club']
        && nd().startsAt is number
        && nd().endsAt is number
        && nd().endsAt > nd().startsAt
        // 92 dias, no máximo.
        && nd().endsAt - nd().startsAt <= 92 * 86400000
        && nd().prizes is list
        && nd().prizes.size() <= 5
        // Desafio entre clubes é só da plataforma.
        && (nd().subject == 'athlete' || nd().issuerType == 'platform');
      allow update: if (isGamificationIssuer(od().issuerType, od().issuerId)
          && gamificationIssuerKept()
          && od().status in ['draft', 'active']
          && nd().status in ['draft', 'active', 'cancelled']
          && nd().endsAt - nd().startsAt <= 92 * 86400000)
        || isPlatformAdmin();
      allow delete: if (isGamificationIssuer(od().issuerType, od().issuerId)
          && od().status in ['draft', 'cancelled'])
        || isPlatformAdmin();
    }

    // challenge_entries/{desafio}_{atleta} ou {desafio}_club_{clube} — quem
    // ENTROU. Entrar é ato do cliente (opt-in) e nasce zerado; valor, posição,
    // elegibilidade e prêmio são do servidor — sem `update` de cliente.
    match /challenge_entries/{entryId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && nd().keys().hasOnly([
          'challengeId', 'subjectType', 'subjectId', 'uid', 'joinedAt',
          'value', 'position', 'finalized', 'prizeXp'
        ])
        && nd().uid == me()
        && nd().value == 0
        && nd().position == null
        && nd().finalized == false
        && nd().prizeXp == 0
        && exists(/databases/$(database)/documents/gamification_challenges/$(nd().challengeId))
        && get(/databases/$(database)/documents/gamification_challenges/$(nd().challengeId)).data.status == 'active'
        && request.time.toMillis() < get(/databases/$(database)/documents/gamification_challenges/$(nd().challengeId)).data.endsAt
        && (
          // Atleta: só entra a si mesmo.
          (nd().subjectType == 'athlete'
            && nd().subjectId == me()
            && entryId == nd().challengeId + '_' + me()
            && get(/databases/$(database)/documents/gamification_challenges/$(nd().challengeId)).data.subject == 'athlete')
          // Clube: quem administra o clube.
          || (nd().subjectType == 'club'
            && isClubAdmin(nd().subjectId)
            && entryId == nd().challengeId + '_club_' + nd().subjectId
            && get(/databases/$(database)/documents/gamification_challenges/$(nd().challengeId)).data.subject == 'club')
        );
      allow update: if false;
      // Sair: o dono da entrada (ou o admin do clube), enquanto não fechou.
      allow delete: if isAuthed() && od().finalized != true && (
          od().uid == me()
          || (od().subjectType == 'club' && isClubAdmin(od().subjectId))
        ) || isPlatformAdmin();
    }

    // duels/{semana}_{uidA}_{uidB} — o duelo da semana. O SERVIDOR emparelha e
    // fecha; os dois lados só leem e podem RECUSAR (active → declined).
    match /duels/{duelId} {
      allow read: if isAuthed() && (
        od().uidA == me()
        || od().uidB == me()
        || isPlatformAdmin()
      );
      allow create, delete: if false;
      allow update: if isAuthed()
        && (od().uidA == me() || od().uidB == me())
        && od().status == 'active'
        && nd().status == 'declined'
        && chg()
          .hasOnly(['status', 'declinedBy', 'declinedAt'])
        && nd().declinedBy == me();
    }

    // gamification_rewards/{id} — recompensas reais, liberadas por marcos. O
    // EMISSOR cria e gere. `approvedCount` só sobe, de 1 em 1 (o emissor
    // aprova um pedido por vez).
    match /gamification_rewards/{rewardId} {
      allow read: if isAuthed();
      allow create: if isGamificationIssuer(nd().issuerType, nd().issuerId)
        && nd().createdBy == me()
        && nd().title is string
        && nd().title.size() >= 4
        && nd().title.size() <= 80
        && nd().status in ['active', 'paused']
        && nd().approvedCount == 0;
      allow update: if (isGamificationIssuer(od().issuerType, od().issuerId)
          && gamificationIssuerKept()
          && nd().status in ['active', 'paused', 'ended']
          && nd().approvedCount >= od().approvedCount
          && nd().approvedCount <= od().approvedCount + 1)
        || isPlatformAdmin();
      allow delete: if isGamificationIssuer(od().issuerType, od().issuerId)
        || isPlatformAdmin();
    }

    // reward_claims/{recompensa}_{atleta} — o PEDIDO. A pessoa pede (com um
    // código) e pode cancelar; o emissor aprova, recusa e marca como usada.
    // Nada é entregue sozinho: quem entrega confirma.
    function rewardClaimIssuerKept() {
      return nd().uid == od().uid
        && nd().rewardId == od().rewardId
        && nd().code == od().code
        && nd().issuerType == od().issuerType
        && nd().issuerId == od().issuerId;
    }
    match /reward_claims/{claimId} {
      allow read: if isAuthed() && (
        od().uid == me()
        || isGamificationIssuer(od().issuerType, od().issuerId)
        || isPlatformAdmin()
      );
      allow create: if isAuthed()
        && nd().uid == me()
        && nd().status == 'requested'
        && claimId == nd().rewardId + '_' + me()
        && nd().code is string
        && nd().code.size() >= 6
        && nd().code.size() <= 20
        && exists(/databases/$(database)/documents/gamification_rewards/$(nd().rewardId))
        && get(/databases/$(database)/documents/gamification_rewards/$(nd().rewardId)).data.status == 'active'
        // O pedido aponta para o emissor REAL da recompensa — senão o pedido
        // iria para a fila de outra pessoa.
        && get(/databases/$(database)/documents/gamification_rewards/$(nd().rewardId)).data.issuerType == nd().issuerType
        && get(/databases/$(database)/documents/gamification_rewards/$(nd().rewardId)).data.issuerId == nd().issuerId;
      // A pessoa só cancela o próprio pedido; o emissor decide os demais passos.
      allow update: if isAuthed() && rewardClaimIssuerKept() && (
        (od().uid == me()
          && od().status in ['requested', 'approved']
          && nd().status == 'cancelled')
        || (isGamificationIssuer(od().issuerType, od().issuerId)
          && ((od().status == 'requested' && nd().status in ['approved', 'rejected'])
            || (od().status == 'approved' && nd().status in ['redeemed', 'rejected'])))
      );
      allow delete: if isPlatformAdmin();
    }

    // gamification_goals/{tipo}_{dono}_{mês} — as metas do mês de um professor,
    // arena ou clube. Só o próprio dono lê e escreve (é o painel dele).
    function isGoalsOwner(ownerType, ownerId) {
      return isAuthed() && (
        (ownerType == 'coach' && ownerId == me())
        || (ownerType == 'arena' && isArenaManager(ownerId))
        || (ownerType == 'club' && isClubAdmin(ownerId))
      );
    }
    match /gamification_goals/{goalsId} {
      allow read: if isGoalsOwner(od().ownerType, od().ownerId) || isPlatformAdmin();
      allow create, update: if isGoalsOwner(nd().ownerType, nd().ownerId)
        && nd().keys().hasOnly(['ownerType', 'ownerId', 'month', 'goals', 'updatedAt'])
        && nd().ownerType in ['coach', 'arena', 'club']
        && goalsId == nd().ownerType + '_' + nd().ownerId + '_' + nd().month
        && nd().goals is list
        && nd().goals.size() <= 6;
      allow delete: if isGoalsOwner(od().ownerType, od().ownerId) || isPlatformAdmin();
    }

    // ==== Centro de Treino (flag `training_center`) ========================
    // Biblioteca de treinos e drills de TODOS os autores (plataforma,
    // professores e atletas), compartilhamento, diário, planos, dúvidas e
    // denúncias. TUDO ADITIVO: coleções novas, nenhuma regra antiga mudou
    // (a não ser as duas correções F0 acima, em coach_students e coach_content).
    // Ver `docs/40-CENTRO-DE-TREINO.md` e `tests/rules/training.rules.test.js`.

    // Configuração do módulo: `platform_settings/training` (o admin escreve
    // pela regra de platform_settings). Campo ausente vale o padrão — os
    // mesmos padrões de `training/domain/settings.js`.
    function trainingSetting(key, dflt) {
      return exists(/databases/$(database)/documents/platform_settings/training)
        ? get(/databases/$(database)/documents/platform_settings/training).data.get(key, dflt)
        : dflt;
    }
    function isCoachUser(uid) {
      return exists(/databases/$(database)/documents/coaches/$(uid));
    }
    // Vínculo ATIVO professor→aluno (`coach_students/{coach}_{aluno}`).
    // Confere também os CAMPOS do vínculo (defesa em profundidade): um
    // documento gravado com id forjado antes da correção da F0 não abre nada.
    function hasActiveStudent(coachUid, studentUid) {
      return exists(/databases/$(database)/documents/coach_students/$(coachUid + '_' + studentUid))
        && get(/databases/$(database)/documents/coach_students/$(coachUid + '_' + studentUid)).data.status == 'active'
        && get(/databases/$(database)/documents/coach_students/$(coachUid + '_' + studentUid)).data.coach_id == coachUid
        && get(/databases/$(database)/documents/coach_students/$(coachUid + '_' + studentUid)).data.student_id == studentUid;
    }
    function isActiveStudentOf(coachUid) {
      return isAuthed() && hasActiveStudent(coachUid, me());
    }
    // O item público deste papel entra na biblioteca sem passar pela fila?
    // Padrão: os dois passam pela revisão. Qualquer conta pode se declarar
    // professor (`coaches/{uid}`), então o professor só publica direto quando
    // o admin o VERIFICOU (`verified_professors`, que só o admin escreve) ou
    // quando o admin desliga a revisão de professores. `request.auth.uid` é
    // sempre o autor aqui: `trainingAuthorOk` amarra o papel 'professor' à
    // própria conta, e o autor não muda na edição.
    function trainingAutoApproved(role) {
      return isPlatformAdmin()
        || (role == 'professor' && (trainingSetting('public_review_professor', true) == false
          || me() in trainingSetting('verified_professors', [])))
        || (role == 'atleta' && trainingSetting('public_review_atleta', true) == false);
    }
    // Forma mínima do item (tamanhos). O domínio normaliza o resto; aqui só
    // o que, se faltasse, abriria espaço para abuso (documento gigante,
    // campo de moderação com tipo errado).
    function trainingItemShapeOk(d) {
      return d.kind in ['drill', 'treino', 'fundamento', 'jogada', 'fisico', 'estudo']
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 120
        && d.summary is string && d.summary.size() <= 280
        && d.visibility in ['publico', 'privado', 'alunos']
        && d.review in ['nao_se_aplica', 'pendente', 'aprovado', 'recusado']
        && d.hidden is bool && d.featured is bool
        && d.shared_uids is list && d.shared_uids.size() <= 50
        && d.get('steps', []) is list && d.get('steps', []).size() <= 15
        && d.get('media', []) is list && d.get('media', []).size() <= 8
        && d.get('diagrams', []) is list && d.get('diagrams', []).size() <= 4
        && d.get('blocks', []) is list && d.get('blocks', []).size() <= 12
        && (d.visibility != 'alunos' || d.author_role == 'professor');
    }
    // Autoria coerente: a plataforma só pelo admin; professor só com perfil
    // de professor; ninguém cria em nome de outra pessoa.
    function trainingAuthorOk(d) {
      return d.created_by == me() && (
        (d.author_uid == 'plataforma' && d.author_role == 'plataforma' && isPlatformAdmin())
        || (d.author_uid == me() && (
          d.author_role == 'atleta'
          || (d.author_role == 'professor' && isCoachUser(me()))))
      );
    }
    // Revisão coerente com a visibilidade e a política: não público ⇒ não se
    // aplica; público ⇒ pendente, ou aprovado só se o papel publica direto.
    function trainingReviewOk(d) {
      return (d.visibility != 'publico' && d.review == 'nao_se_aplica')
        || (d.visibility == 'publico' && (
          d.review == 'pendente'
          || (d.review == 'aprovado' && trainingAutoApproved(d.author_role))));
    }
    // Atleta publicando: o admin pode desligar a publicação pública de atletas.
    function trainingPublicAllowed(d) {
      return d.visibility != 'publico' || d.author_role != 'atleta'
        || trainingSetting('allow_public_athlete', true) == true;
    }
    // "Copiar e adaptar": a cópia guarda de onde veio (`derived_from`). O
    // `locked` é CONFERIDO aqui contra o original — não vem do formulário: se
    // o original não está aberto a quem copia (não é dele nem está na
    // biblioteca pública), a cópia nunca vira pública. É o que impede a
    // "lavagem" do treino que um professor mandou só aos alunos dele.
    function trainingOpenToCopy(sourceId) {
      let s = get(/databases/$(database)/documents/training_items/$(sourceId)).data;
      // O próprio item só está "aberto" se não for, ele mesmo, uma cópia
      // travada — senão copiar a cópia destravaria o conteúdo.
      return (s.author_uid == me()
          && (s.get('derived_from', null) == null || s.derived_from.get('locked', false) == false))
        || (s.visibility == 'publico' && s.review == 'aprovado' && s.hidden == false);
    }
    function trainingDerivedOk(d) {
      return d.get('derived_from', null) == null || (
        d.derived_from is map && d.derived_from.id is string
        && exists(/databases/$(database)/documents/training_items/$(d.derived_from.id))
        && d.derived_from.get('locked', false) == !trainingOpenToCopy(d.derived_from.id));
    }
    function trainingUnlocked(d) {
      return d.get('derived_from', null) == null || d.derived_from.get('locked', false) == false;
    }
    function trainingLockOk(d) {
      return d.get('derived_from', null) == null
        || d.derived_from.get('locked', false) == false
        || (d.visibility != 'publico' && d.shared_uids.size() == 0);
    }
    match /training_items/{itemId} {
      allow read: if isAuthed() && (
        od().author_uid == me()
        || (od().visibility == 'publico' && od().review == 'aprovado' && od().hidden == false)
        || (od().hidden == false && me() in od().shared_uids)
        || (od().visibility == 'alunos' && od().hidden == false && isActiveStudentOf(od().author_uid))
        || isPlatformAdmin()
      );
      // O admin pode criar já destacado/aprovado; os demais nascem sem
      // moderação (oculto=false, destaque=false, sem nota de revisão).
      // `pickle_*` é o id fixo das sementes da plataforma: ninguém mais o ocupa.
      allow create: if isAuthed()
        && trainingItemShapeOk(nd())
        && trainingAuthorOk(nd())
        && (isPlatformAdmin() || (
          !itemId.matches('pickle_.*')
          && trainingReviewOk(nd())
          && trainingPublicAllowed(nd())
          && trainingDerivedOk(nd())
          && trainingLockOk(nd())
          && nd().hidden == false
          && nd().featured == false
          && !('review_note' in nd())
          && !('reviewed_by' in nd())
          && !('hidden_reason' in nd())));
      allow update: if isAuthed() && (
        // Admin: edita, oculta, destaca, aprova — mas não troca o autor.
        (isPlatformAdmin()
          && nd().author_uid == od().author_uid
          && nd().author_role == od().author_role
          && nd().created_by == od().created_by
          && trainingItemShapeOk(nd()))
        // Autor: não mexe em autoria nem em moderação.
        || (od().author_uid == me()
          && nd().author_uid == od().author_uid
          && nd().author_role == od().author_role
          && nd().created_by == od().created_by
          && nd().get('created_at', null) == od().get('created_at', null)
          && nd().get('derived_from', null) == od().get('derived_from', null)
          && nd().hidden == od().hidden
          && nd().featured == od().featured
          && nd().get('hidden_reason', '') == od().get('hidden_reason', '')
          && nd().get('review_note', '') == od().get('review_note', '')
          && nd().get('reviewed_by', null) == od().get('reviewed_by', null)
          && nd().get('reviewed_at', null) == od().get('reviewed_at', null)
          && (
            // Só compartilhamento: não é edição do conteúdo, a revisão fica.
            (chg().hasOnly(['shared_uids', 'updated_at'])
              && nd().shared_uids is list
              && nd().shared_uids.size() <= 50
              && trainingLockOk(nd()))
            // Edição: forma, revisão pela política e — se virou público agora —
            // a permissão de publicar.
            || (trainingItemShapeOk(nd())
              && trainingReviewOk(nd())
              && trainingLockOk(nd())
              && (od().visibility == 'publico' || trainingPublicAllowed(nd())))
          ))
      );
      allow delete: if (isOwner(od().author_uid) || isPlatformAdmin());
    }

    // Compartilhar/indicar. `indicacao`: qualquer pessoa, do próprio item ou
    // de um item público da biblioteca. `aluno`: SÓ o professor, para aluno
    // com vínculo ATIVO. O destinatário marca lido/feito; ninguém reescreve.
    // A cópia TRAVADA (de algo que não estava aberto a quem copiou) não é
    // indicada nem enviada: seria entregar o conteúdo exclusivo a terceiros.
    function trainingShareItemOk(itemId) {
      return exists(/databases/$(database)/documents/training_items/$(itemId))
        && ((get(/databases/$(database)/documents/training_items/$(itemId)).data.author_uid == me()
            && trainingUnlocked(get(/databases/$(database)/documents/training_items/$(itemId)).data))
          || (get(/databases/$(database)/documents/training_items/$(itemId)).data.visibility == 'publico'
            && get(/databases/$(database)/documents/training_items/$(itemId)).data.review == 'aprovado'
            && get(/databases/$(database)/documents/training_items/$(itemId)).data.hidden == false));
    }
    match /training_shares/{shareId} {
      allow read: if isAuthed() && (
        od().from_uid == me()
        || od().to_uid == me()
        || isPlatformAdmin()
      );
      allow create: if isAuthed()
        && nd().keys().hasOnly(['from_uid', 'from_name', 'from_role', 'to_uid', 'item_id',
          'item_title', 'item_kind', 'kind', 'note', 'due_date', 'created_at', 'read_at', 'done_at', 'done_note'])
        && nd().from_uid == me()
        && nd().to_uid is string
        && nd().to_uid != me()
        && nd().item_id is string
        && nd().note is string && nd().note.size() <= 500
        && nd().get('read_at', null) == null
        && nd().get('done_at', null) == null
        && trainingSetting('allow_sharing', true) == true
        && trainingShareItemOk(nd().item_id)
        && (
          (nd().kind == 'indicacao'
            && (nd().from_role == 'atleta'
              || (nd().from_role == 'professor' && isCoachUser(me())))
            && nd().get('due_date', null) == null)
          || (nd().kind == 'aluno'
            && nd().from_role == 'professor'
            && isCoachUser(me())
            && hasActiveStudent(me(), nd().to_uid))
        );
      allow update: if isAuthed()
        && od().to_uid == me()
        && chg().hasOnly(['read_at', 'done_at', 'done_note'])
        && nd().get('done_note', '') is string
        && nd().get('done_note', '').size() <= 300;
      allow delete: if isAuthed() && (
        od().from_uid == me()
        || od().to_uid == me()
        || isPlatformAdmin()
      );
    }

    // Diário. Só o dono escreve. O professor lê (e comenta, e confirma) a
    // sessão que o aluno COMPARTILHOU com ele — e só enquanto o vínculo está
    // ativo. Nenhum campo de saúde existe aqui (ver o domínio).
    function trainingSessionShapeOk(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.duration_min is int && d.duration_min >= 0 && d.duration_min <= 600
        && (d.get('rpe', null) == null || (d.rpe is int && d.rpe >= 0 && d.rpe <= 10))
        && d.get('notes', '') is string && d.get('notes', '').size() <= 2000
        && d.get('title', '') is string && d.get('title', '').size() <= 120
        && d.get('item_ids', []) is list && d.get('item_ids', []).size() <= 12
        && d.get('skills', []) is list && d.get('skills', []).size() <= 6;
    }
    function trainingSessionReadable(sid) {
      return isAuthed() && exists(/databases/$(database)/documents/training_sessions/$(sid)) && (
        get(/databases/$(database)/documents/training_sessions/$(sid)).data.uid == me()
        || isPlatformAdmin()
        || (get(/databases/$(database)/documents/training_sessions/$(sid)).data.get('shared_coach_id', null) == me()
          && hasActiveStudent(me(), get(/databases/$(database)/documents/training_sessions/$(sid)).data.uid))
      );
    }
    match /training_sessions/{sessionId} {
      allow read: if isAuthed() && (
        od().uid == me()
        || (od().get('shared_coach_id', null) == me()
          && hasActiveStudent(me(), od().uid))
        || isPlatformAdmin()
      );
      allow create: if isAuthed()
        && nd().uid == me()
        && trainingSessionShapeOk(nd())
        && nd().get('coach_confirmed_at', null) == null
        && (nd().get('shared_coach_id', null) == null
          || hasActiveStudent(nd().shared_coach_id, me()));
      allow update: if isAuthed() && (
        (od().uid == me()
          && nd().uid == od().uid
          && trainingSessionShapeOk(nd())
          && nd().get('coach_confirmed_at', null) == od().get('coach_confirmed_at', null)
          && (nd().get('shared_coach_id', null) == null
            || nd().get('shared_coach_id', null) == od().get('shared_coach_id', null)
            || hasActiveStudent(nd().shared_coach_id, me())))
        || (od().get('shared_coach_id', null) == me()
          && hasActiveStudent(me(), od().uid)
          && chg().hasOnly(['coach_confirmed_at', 'updated_at']))
      );
      allow delete: if (isOwner(od().uid) || isPlatformAdmin());

      match /comments/{commentId} {
        allow read: if trainingSessionReadable(sessionId);
        allow create: if trainingSessionReadable(sessionId)
          && nd().keys().hasOnly(['uid', 'name', 'text', 'created_at'])
          && nd().uid == me()
          && nd().text is string
          && nd().text.size() >= 1 && nd().text.size() <= 1000;
        allow delete: if isAuthed() && (
          od().uid == me()
          || get(/databases/$(database)/documents/training_sessions/$(sessionId)).data.uid == me()
          || isPlatformAdmin()
        );
      }
    }

    // Planos: do atleta, só ele lê e escreve.
    match /training_plans/{planId} {
      allow read: if (isOwner(od().uid) || isPlatformAdmin());
      allow create: if isAuthed()
        && nd().uid == me()
        && nd().title is string && nd().title.size() <= 120
        && nd().weeks is int && nd().weeks >= 1 && nd().weeks <= 16
        && nd().slots is list && nd().slots.size() <= 112
        && nd().days is list && nd().days.size() <= 7;
      allow update: if isAuthed()
        && od().uid == me()
        && nd().uid == od().uid
        && nd().title is string && nd().title.size() <= 120
        && nd().weeks is int && nd().weeks >= 1 && nd().weeks <= 16
        && nd().slots is list && nd().slots.size() <= 112
        && nd().days is list && nd().days.size() <= 7;
      allow delete: if (isOwner(od().uid) || isPlatformAdmin());
    }

    // Preferências e progresso do treino de cada pessoa (id = uid).
    match /training_meta/{uid} {
      allow read: if isOwner(uid) || isPlatformAdmin();
      allow create, update: if isOwner(uid)
        && nd().keys().hasOnly(['favorites', 'routine', 'onboarding_done', 'mastery',
          'assessments', 'focus_hint', 'debrief', 'updated_at'])
        && nd().get('debrief', {}) is map
        && nd().get('debrief', {}).keys().hasOnly(['enabled', 'since'])
        && nd().get('favorites', []) is list
        && nd().get('favorites', []).size() <= 300
        && nd().get('assessments', []) is list
        && nd().get('assessments', []).size() <= 24
        && nd().get('mastery', {}) is map
        && nd().get('mastery', {}).size() <= 300;
      allow delete: if isOwner(uid) || isPlatformAdmin();
    }

    // Balanço do jogo (flag `game_debrief`): só da pessoa. O id começa pelo
    // uid de quem escreve (`{uid}_{jogo}`), então ninguém grava no balanço de
    // outra pessoa nem cria um em nome dela.
    function trainingDebriefShapeOk(d) {
      return d.keys().hasOnly(['uid', 'source', 'status', 'rating', 'strengths', 'weaknesses', 'evolution',
          'body', 'mind', 'note', 'suggestion', 'applied', 'created_at', 'updated_at'])
        && d.status in ['respondido', 'dispensado']
        && d.source is map
        && d.source.keys().hasOnly(['type', 'ref_id', 'title', 'date', 'games', 'wins'])
        && d.source.type in ['dia_de_jogo', 'torneio', 'reserva', 'avulso']
        && d.source.ref_id is string && d.source.ref_id.size() <= 80
        && d.source.get('title', '') is string && d.source.get('title', '').size() <= 120
        && d.source.date is string && d.source.date.size() == 10
        && (d.get('rating', null) == null || (d.rating is int && d.rating >= 1 && d.rating <= 5))
        && (d.status == 'dispensado' || d.get('rating', null) != null)
        && d.get('strengths', []) is list && d.get('strengths', []).size() <= 3
        && d.get('weaknesses', []) is list && d.get('weaknesses', []).size() <= 3
        && d.get('note', '') is string && d.get('note', '').size() <= 500
        && (d.get('suggestion', null) == null
          || (d.suggestion is map && d.suggestion.get('item_ids', []) is list && d.suggestion.get('item_ids', []).size() <= 16))
        && (d.get('applied', null) == null || d.applied is map);
    }
    match /training_debriefs/{debriefId} {
      allow read: if (isOwner(od().uid) || isPlatformAdmin());
      allow create, update: if isAuthed()
        && nd().uid == me()
        && debriefId.matches(me() + '_.+')
        && trainingDebriefShapeOk(nd());
      allow delete: if (isOwner(od().uid) || isPlatformAdmin());
    }

    // Dúvidas: privadas entre quem pergunta e o professor (vínculo ATIVO para
    // abrir). As mensagens só são acrescentadas — ninguém reescreve.
    function trainingQuestionParty(qid) {
      return isAuthed() && exists(/databases/$(database)/documents/training_questions/$(qid)) && (
        get(/databases/$(database)/documents/training_questions/$(qid)).data.asker_uid == me()
        || get(/databases/$(database)/documents/training_questions/$(qid)).data.coach_uid == me()
      );
    }
    match /training_questions/{questionId} {
      allow read: if isAuthed() && (
        od().asker_uid == me()
        || od().coach_uid == me()
        || isPlatformAdmin()
      );
      allow create: if isAuthed()
        && nd().asker_uid == me()
        && nd().coach_uid is string
        && nd().coach_uid != me()
        && hasActiveStudent(nd().coach_uid, me())
        && nd().status == 'aberta'
        && nd().subject is string
        && nd().subject.size() >= 1 && nd().subject.size() <= 120;
      allow update: if isAuthed()
        && (od().asker_uid == me() || od().coach_uid == me())
        && chg().hasOnly(['status', 'last_from', 'updated_at'])
        && nd().status in ['aberta', 'respondida', 'encerrada'];
      allow delete: if (isOwner(od().asker_uid) || isPlatformAdmin());

      match /messages/{messageId} {
        allow read: if trainingQuestionParty(questionId) || isPlatformAdmin();
        // Escrever só enquanto o vínculo estiver ativo: encerrado (ou pausado),
        // a conversa fica para consulta, sem mensagem nova.
        allow create: if trainingQuestionParty(questionId)
          && hasActiveStudent(
            get(/databases/$(database)/documents/training_questions/$(questionId)).data.coach_uid,
            get(/databases/$(database)/documents/training_questions/$(questionId)).data.asker_uid)
          && nd().keys().hasOnly(['uid', 'name', 'text', 'created_at'])
          && nd().uid == me()
          && nd().text is string
          && nd().text.size() >= 1 && nd().text.size() <= 2000;
        // Quem perguntou apaga a conversa inteira (mensagens antes da dúvida).
        allow delete: if isPlatformAdmin()
          || (isAuthed() && exists(/databases/$(database)/documents/training_questions/$(questionId))
            && get(/databases/$(database)/documents/training_questions/$(questionId)).data.asker_uid == me());
      }
    }

    // Denúncias de conteúdo: qualquer conta denuncia; só quem denunciou e o
    // admin leem; só o admin resolve.
    match /training_reports/{reportId} {
      allow read: if (isOwner(od().reporter_uid) || isPlatformAdmin());
      allow create: if isAuthed()
        && nd().reporter_uid == me()
        && nd().status == 'aberta'
        && nd().item_id is string
        && nd().reason in ['impreciso', 'perigoso', 'ofensivo', 'spam', 'direitos', 'outro']
        && nd().get('text', '') is string
        && nd().get('text', '').size() <= 500
        && !('resolved_by' in nd());
      allow update, delete: if isPlatformAdmin();
    }

    // =====================================================================
    // MERCADO (flag `marketplace`) — o marketplace próprio da plataforma.
    // ADITIVO: coleções novas com prefixo `market_`, nada antigo muda.
    // Ver `src/modules/marketplace/README.md`.
    //
    //  - quem vende é um VENDEDOR (`market_sellers/{chave}`), de chave
    //    determinística: `athlete_{uid}`, `coach_{uid}`, `arena_{arenaId}`,
    //    `store_{uid}`. Quem opera a chave é o dono do uid ou quem gere a arena;
    //  - anúncio, pergunta, favorito e carrinho o navegador escreve, com os
    //    campos de confiança (moderação, vendas, reputação) TRAVADOS;
    //  - pedido, oferta, avaliação e disputa só o SERVIDOR escreve
    //    (`functions/marketplace.js`): é quem confere estoque, preço e a vez de
    //    cada um. O navegador só lê o que é dele.
    // =====================================================================
    function marketOn() {
      return get(/databases/$(database)/documents/platform_settings/global).data
        .get('feature_flags', {}).get('marketplace', false) == true;
    }
    function isMarketOperator(key) {
      return isAuthed() && key is string && (
        key == 'athlete_' + me()
        || key == 'coach_' + me()
        || key == 'store_' + me()
        || (key.matches('arena_[^/]+') && isArenaManager(key.replace('^arena_', '')))
        // PR 4: a loja oficial da federação (módulo `store`) — quem tem `admin` ou `finance`.
        || (key.matches('federation_[^/]+') && fedOn() && fedModuleOn(key.replace('^federation_', ''), 'store')
          && (fedAny(key.replace('^federation_', ''), ['admin', 'finance']))));
    }
    function marketSeller(key) {
      return get(/databases/$(database)/documents/market_sellers/$(key)).data;
    }
    // Campos do vendedor que só o admin (ou o servidor) muda.
    function marketSellerLocked() {
      return ['seller_type', 'entity_id', 'owner_uid', 'status', 'verified', 'rating_avg',
        'rating_count', 'sales_count', 'seller_key', 'reviewed_by', 'reviewed_at', 'reject_reason', 'follower_count'];
    }

    match /market_sellers/{key} {
      allow read: if isAuthed();
      allow create: if marketOn() && isMarketOperator(key)
        && (!key.matches('federation_[^/]+') || fedPublic(key.replace('^federation_', '')))
        && nd().seller_key == key
        && nd().owner_uid == me()
        && nd().display_name is string
        && nd().display_name.size() >= 2
        && nd().display_name.size() <= 60
        && !nd().keys().hasAny(['verified', 'rating_avg', 'rating_count', 'sales_count', 'reviewed_by', 'reject_reason'])
        && (
          (key == 'athlete_' + me() && nd().seller_type == 'athlete' && nd().status == 'active')
          || (key == 'coach_' + me() && nd().seller_type == 'coach' && nd().status == 'active' && isCoachUser(me()))
          || (key.matches('arena_[^/]+') && nd().seller_type == 'arena' && nd().status == 'active')
          || (key.matches('federation_[^/]+') && nd().seller_type == 'federation' && nd().status == 'active')
          || (key == 'store_' + me() && nd().seller_type == 'store' && nd().status == 'pending')
        );
      // A loja recusada pode pedir de novo (volta a "em análise"); fora isso,
      // o operador edita a vitrine, nunca o que dá confiança.
      allow update: if isPlatformAdmin() || (isMarketOperator(key)
        // O CNPJ que o admin aprovou não muda pela própria loja.
        && !(od().status == 'active' && chg().hasAny(['cnpj_masked']))
        && (
        !chg().hasAny(marketSellerLocked())
        || (od().seller_type == 'store' && od().status == 'rejected'
          && nd().status == 'pending'
          && !chg()
            .difference(['status', 'reject_reason'].toSet()).hasAny(marketSellerLocked()))
      ));
      allow delete: if isPlatformAdmin();

      // Pix, telefone e CNPJ: só quem opera o vendedor e o admin.
      match /private/{docId} {
        allow read, write: if docId == 'data' && (isMarketOperator(key) || isPlatformAdmin());
      }
    }

    // Campos do anúncio que o navegador nunca escreve.
    function marketListingLocked() {
      return ['moderation', 'quantity_sold', 'favorite_count', 'seller_rating_avg',
        'seller_rating_count', 'seller_verified', 'source', 'price_alert_cents', 'view_count', 'followers_notified_at_ms'];
    }
    // Visualização: qualquer conta logada soma 1 ao contador de um anúncio no
    // ar, e SÓ isso (nada mais do documento muda na mesma escrita).
    function marketViewBumpOk() {
      return isAuthed() && od().status in ['active', 'sold_out']
        && chg().hasOnly(['view_count'])
        && nd().view_count is int
        && nd().view_count == od().get('view_count', 0) + 1;
    }
    function marketListingShapeOk(d) {
      return d.title is string && d.title.size() >= 3 && d.title.size() <= 120
        && d.price_cents is int && d.price_cents > 0 && d.price_cents <= 100000000
        && d.quantity is int && d.quantity >= 0 && d.quantity <= 100000
        && d.get('media', []) is list && d.get('media', []).size() <= 11
        && d.get('description', '') is string && d.get('description', '').size() <= 5000
        // O "de" (preço riscado) só vale MAIOR que o preço: "de" inventado não sobe na vitrine de ofertas.
        && (d.get('compare_at_cents', null) == null
          || (d.compare_at_cents is int && d.compare_at_cents > d.price_cents && d.compare_at_cents <= 100000000))
        // Variações (tamanho, cor…): lista curta; o servidor confere cada uma na compra.
        && d.get('variants', []) is list && d.get('variants', []).size() <= 20
        // Promoção com prazo e resposta automática a ofertas: números opcionais, abaixo do preço.
        && (d.get('sale_until_ms', null) == null || d.sale_until_ms is int)
        && (d.get('offer_auto_accept_cents', null) == null
          || (d.offer_auto_accept_cents is int && d.offer_auto_accept_cents > 0 && d.offer_auto_accept_cents < d.price_cents))
        && (d.get('offer_auto_decline_cents', null) == null
          || (d.offer_auto_decline_cents is int && d.offer_auto_decline_cents > 0 && d.offer_auto_decline_cents < d.price_cents));
    }

    match /market_listings/{listingId} {
      // Público (para quem está logado) o que está à venda ou esgotado; o
      // resto só para quem vende e o admin.
      allow read: if isAuthed() && (
        od().status in ['active', 'sold_out']
        || isMarketOperator(od().seller_key)
        || isPlatformAdmin());
      allow create: if marketOn() && isMarketOperator(nd().seller_key)
        && exists(/databases/$(database)/documents/market_sellers/$(nd().seller_key))
        && marketSeller(nd().seller_key).status == 'active'
        && nd().seller_name == marketSeller(nd().seller_key).display_name
        && nd().seller_type == marketSeller(nd().seller_key).seller_type
        && nd().created_by == me()
        && nd().status in ['draft', 'active']
        && !nd().keys().hasAny(marketListingLocked())
        && marketListingShapeOk(nd());
      allow update: if isPlatformAdmin() || marketViewBumpOk() || (
        isMarketOperator(od().seller_key)
        && od().status != 'removed'
        && nd().status in ['draft', 'active', 'paused', 'sold_out', 'closed']
        // Vendedor suspenso não põe anúncio de volta no ar (o admin pausou).
        && (nd().status != 'active' || od().status == 'active'
          || marketSeller(od().seller_key).status == 'active')
        && !chg()
          .hasAny(marketListingLocked().concat(['seller_key', 'seller_type', 'created_by']))
        // Anúncio ligado ao estoque da arena: a quantidade é do servidor.
        && (!(od().get('source', null) is map && od().source.get('tracked', false) == true)
          || !chg().hasAny(['quantity']))
        && (!chg().hasAny(['seller_name'])
          || nd().seller_name == marketSeller(od().seller_key).display_name)
        && marketListingShapeOk(nd()));
      // Apagar só o que nunca vendeu (o pedido guarda a foto do anúncio).
      allow delete: if isPlatformAdmin() || (
        isMarketOperator(od().seller_key)
        && od().get('quantity_sold', 0) == 0);
    }

    match /market_questions/{questionId} {
      allow read: if isAuthed() && (
        od().status in ['open', 'answered']
        || od().asker_uid == me()
        || isMarketOperator(od().seller_key)
        || isPlatformAdmin());
      allow create: if marketOn() && isAuthed()
        && nd().keys().hasOnly(['listing_id', 'listing_title', 'seller_key', 'asker_uid', 'asker_name', 'text', 'status', 'created_at', 'created_at_ms'])
        && nd().asker_uid == me()
        && nd().status == 'open'
        && nd().text is string
        && nd().text.size() >= 5 && nd().text.size() <= 500
        && exists(/databases/$(database)/documents/market_listings/$(nd().listing_id))
        && get(/databases/$(database)/documents/market_listings/$(nd().listing_id)).data.seller_key == nd().seller_key
        && nd().listing_title == get(/databases/$(database)/documents/market_listings/$(nd().listing_id)).data.title
        && get(/databases/$(database)/documents/market_listings/$(nd().listing_id)).data.status in ['active', 'sold_out']
        && !isMarketOperator(nd().seller_key);
      // Quem vende responde (só a resposta); o admin esconde.
      allow update: if isPlatformAdmin() || (
        isMarketOperator(od().seller_key)
        && od().status in ['open', 'answered']
        && chg().hasOnly(['answer', 'answered_at', 'answered_by', 'status'])
        && nd().status == 'answered'
        && nd().answered_by == me()
        && nd().answer is string
        && nd().answer.size() >= 2 && nd().answer.size() <= 1000);
      allow delete: if isPlatformAdmin()
        || (isOwner(od().asker_uid) && od().status == 'open');
    }

    // Favorito `{uid}_{anúncio}`: só do dono.
    match /market_favorites/{favId} {
      allow get: if isAuthed() && favId.split('_')[0] == me();
      allow list: if isOwner(od().uid);
      allow create: if isAuthed()
        && nd().keys().hasOnly(['uid', 'listing_id', 'created_at'])
        && nd().uid == me()
        && favId == me() + '_' + nd().listing_id;
      allow delete: if isAuthed() && favId.split('_')[0] == me();
    }

    match /market_saved_searches/{searchId} {
      allow read, delete: if isOwner(od().uid);
      // Na atualização, a busca já tem de ser da pessoa (não dá para "adotar" a de outra).
      allow create, update: if isAuthed()
        && nd().uid == me()
        && (resource == null || od().uid == me())
        && nd().get('label', '') is string
        && nd().get('label', '').size() <= 60;
    }

    // Endereços de entrega guardados (`market_addresses/{uid}`): só do dono, até 5.
    match /market_addresses/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && nd().get('addresses', []) is list
        && nd().get('addresses', []).size() <= 5;
      allow delete: if isOwner(uid);
    }

    // Seguir uma loja `{uid}_{vendedor}`: só do dono (como o favorito).
    match /market_follows/{followId} {
      allow get: if isAuthed() && followId.split('_')[0] == me();
      allow list: if isOwner(od().uid);
      allow create: if isAuthed()
        && nd().keys().hasOnly(['uid', 'seller_key', 'created_at'])
        && nd().uid == me()
        && nd().seller_key is string
        && followId == me() + '_' + nd().seller_key;
      allow delete: if isAuthed() && followId.split('_')[0] == me();
    }

    match /market_carts/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && nd().get('items', []) is list
        && nd().get('items', []).size() <= 50
        && nd().get('saved', []) is list
        && nd().get('saved', []).size() <= 50;
      allow delete: if isOwner(uid);
    }

    // Cupom da loja `{vendedor}_{CÓDIGO}`: quem vende cria e muda; o uso
    // (`uses_count`) só o servidor conta, na compra. Quem SABE o código lê o
    // cupom (é assim que a tela mostra o desconto antes de fechar); a lista
    // aberta é só dos divulgados.
    function marketCouponShapeOk(d) {
      return d.code is string && d.code.matches('[A-Z0-9]{3,20}')
        && d.kind in ['percent', 'amount', 'free_shipping']
        && d.value is int
        && ((d.kind == 'percent' && d.value >= 1 && d.value <= 90)
          || (d.kind == 'amount' && d.value >= 100 && d.value <= 10000000)
          || (d.kind == 'free_shipping' && d.value == 0))
        && d.get('min_subtotal_cents', 0) is int && d.get('min_subtotal_cents', 0) >= 0
        && d.get('listing_ids', []) is list && d.get('listing_ids', []).size() <= 30
        && d.get('description', '') is string && d.get('description', '').size() <= 140
        && (d.get('max_uses', null) == null || (d.max_uses is int && d.max_uses >= 1 && d.max_uses <= 100000))
        && d.get('public', false) is bool && d.get('active', true) is bool;
    }
    match /market_coupons/{couponId} {
      allow get: if isAuthed();
      allow list: if isAuthed() && (
        (od().public == true && od().active == true)
        || isMarketOperator(od().seller_key)
        || isPlatformAdmin());
      allow create: if marketOn() && isMarketOperator(nd().seller_key)
        && couponId == nd().seller_key + '_' + nd().code
        && nd().get('uses_count', 0) == 0
        && nd().created_by == me()
        && marketCouponShapeOk(nd());
      allow update: if isPlatformAdmin() || (
        isMarketOperator(od().seller_key)
        && !chg()
          .hasAny(['seller_key', 'code', 'uses_count', 'last_used_at_ms', 'created_by'])
        && marketCouponShapeOk(nd()));
      allow delete: if isPlatformAdmin() || isMarketOperator(od().seller_key);
      // Quantas vezes CADA pessoa usou: a própria pessoa lê o seu; só o servidor escreve.
      match /market_coupon_uses/{uid} {
        allow get: if isOwner(uid) || isPlatformAdmin();
        allow write: if false;
      }
    }

    // ---- Escritos SÓ pelo servidor ----

    // Vale-presente: quem comprou, quem resgatou e a loja que aceita leem.
    // Saldo, código e resgate passam pelo servidor (`marketGiftCardAction`).
    match /market_gift_cards/{cardId} {
      allow read: if isAuthed() && (
        od().holder_uid == me()
        || od().buyer_uid == me()
        || isMarketOperator(od().seller_key)
        || isPlatformAdmin());
      allow write: if false;
    }
    match /market_offers/{offerId} {
      allow read: if isAuthed() && (
        od().buyer_uid == me()
        || isMarketOperator(od().seller_key)
        || isPlatformAdmin());
      allow write: if false;
    }

    function marketOrderParty(orderId) {
      return isAuthed() && exists(/databases/$(database)/documents/market_orders/$(orderId)) && (
        get(/databases/$(database)/documents/market_orders/$(orderId)).data.buyer_uid == me()
        || isMarketOperator(get(/databases/$(database)/documents/market_orders/$(orderId)).data.seller_key)
        || isPlatformAdmin());
    }

    match /market_orders/{orderId} {
      allow read: if isAuthed() && (
        od().buyer_uid == me()
        || isMarketOperator(od().seller_key)
        || isPlatformAdmin());
      allow write: if false;

      match /events/{eventId} {
        allow read: if marketOrderParty(orderId);
        allow write: if false;
      }
      // Endereço de entrega: o comprador sempre; quem vende só depois de
      // aceitar o pedido (`shipping_visible`, gravado pelo servidor).
      match /private/{docId} {
        allow read: if isAuthed() && exists(/databases/$(database)/documents/market_orders/$(orderId)) && (
          get(/databases/$(database)/documents/market_orders/$(orderId)).data.buyer_uid == me()
          || isPlatformAdmin()
          || (get(/databases/$(database)/documents/market_orders/$(orderId)).data.get('shipping_visible', false) == true
            && isMarketOperator(get(/databases/$(database)/documents/market_orders/$(orderId)).data.seller_key)));
        allow write: if false;
      }
    }

    // Avaliação cega: aparece para todos só quando o servidor revela. Quem
    // vende RESPONDE à avaliação revelada do comprador (só a resposta).
    match /market_reviews/{reviewId} {
      allow read: if isAuthed() && (
        od().visible == true
        || od().author_uid == me()
        || isPlatformAdmin());
      allow create, delete: if false;
      allow update: if marketOn() && isMarketOperator(od().seller_key)
        && od().author_role == 'buyer' && od().visible == true
        && chg().hasOnly(['reply', 'reply_at_ms', 'reply_by'])
        && nd().reply is string
        && nd().reply.size() >= 2 && nd().reply.size() <= 500
        && nd().reply_by == me();
    }

    match /market_disputes/{disputeId} {
      allow read: if isAuthed() && (
        od().buyer_uid == me()
        || isMarketOperator(od().seller_key)
        || isPlatformAdmin());
      allow write: if false;
    }

    // Denúncia de anúncio: uma por pessoa e anúncio (id `{anúncio}_{uid}`).
    // Quem denuncia só cria e lê a própria; a moderação decide.
    match /market_reports/{reportId} {
      // `get` pelo id (que termina no uid) funciona mesmo sem o documento:
      // é como a tela sabe se a pessoa já denunciou.
      allow get: if isAuthed() && (reportId.matches('.+_' + me()) || isPlatformAdmin());
      allow list: if (isOwner(od().reporter_uid) || isPlatformAdmin());
      allow create: if marketOn() && isAuthed()
        && reportId == nd().listing_id + '_' + me()
        && nd().keys().hasOnly(['listing_id', 'listing_title', 'seller_key', 'reporter_uid', 'reason', 'text', 'status', 'created_at', 'created_at_ms'])
        && nd().reporter_uid == me()
        && nd().status == 'open'
        && nd().listing_id is string
        && nd().seller_key is string
        && !isMarketOperator(nd().seller_key)
        && nd().reason in ['fake', 'prohibited', 'misleading', 'scam', 'offensive', 'other']
        && nd().get('text', '') is string
        && nd().get('text', '').size() <= 500
        && nd().get('listing_title', '') is string
        && nd().get('listing_title', '').size() <= 120;
      allow update, delete: if isPlatformAdmin();
    }

    // =====================================================================
    // FEDERAÇÕES (flag `federations`) — coleções `federation_*`, aditivas.
    //  - a flag DESLIGADA fecha toda escrita (`fedOn()`), como no Mercado;
    //  - a federação nasce `pending` por qualquer conta; status, verificação e
    //    selo oficial só o admin da plataforma (ou o servidor) mudam;
    //  - a equipe (`federation_staff/{fed}_{uid}`) tem PAPEL, e a regra
    //    pergunta pela PERMISSÃO do papel (`fedHas`) — cópia de
    //    `STAFF_ROLE_PERMISSIONS`, com teste de paridade; o presidente só é
    //    trocado por presidente ou pelo admin da plataforma;
    //  - a FILIAÇÃO só o SERVIDOR cria e muda de estado (`functions/
    //    federations.js`): o atleta não "se aprova". No documento, a pessoa
    //    muda só as próprias preferências (selo público, diretório, foto);
    //  - a lista de filiados NUNCA é pública: lê o próprio, a equipe
    //    (filiados/financeiro/admin) e o admin da plataforma;
    //  - a COBRANÇA só o servidor cria; o pagador só DECLARA que pagou
    //    (aberta → informada); confirmar é do financeiro, pelo servidor;
    //  - `federation_card_index` (código da carteirinha → filiação): ninguém
    //    pelo cliente — a verificação é uma função.
    // =====================================================================
    function fedOn() {
      return get(/databases/$(database)/documents/platform_settings/global).data
        .get('feature_flags', {}).get('federations', false) == true;
    }
    function fedDoc(fedId) {
      return get(/databases/$(database)/documents/federations/$(fedId)).data;
    }
    function fedApproved(fedId) {
      return exists(/databases/$(database)/documents/federations/$(fedId)) && fedDoc(fedId).status == 'approved';
    }
    function fedStaffPath(fedId) {
      return /databases/$(database)/documents/federation_staff/$(fedId + '_' + me());
    }
    function fedStaff(fedId) {
      return get(fedStaffPath(fedId)).data;
    }
    // Papel ANTIGO → permissões (documento sem `perms`; cópia de
    // `src/modules/federations/domain/constants.js`). O cargo novo grava a
    // cópia das permissões em `perms` — só o servidor (`federationStaff`).
    function fedRolePerms(role) {
      return role == 'president' || role == 'director'
        ? ['admin', 'members', 'finance', 'competitions', 'courses', 'discipline', 'comms', 'docs', 'staff', 'fiscal', 'safeguarding']
        : (role == 'secretary' ? ['members', 'docs']
        : (role == 'treasurer' ? ['finance']
        : (role == 'competitions' ? ['competitions']
        : (role == 'referees' ? ['courses']
        : (role == 'discipline' ? ['discipline']
        : (role == 'communication' ? ['comms']
        : (role == 'fiscal_council' ? ['fiscal'] : [])))))));
    }
    // As permissões do cargo com o MANDATO valendo (`term_end_ms` 0 = sem
    // prazo). O admin master segura: a federação nunca fica sem ninguém, e o
    // servidor só o tira quando sobra outro. O admin master é "tudo" — inclusive
    // as permissões criadas depois de o cargo ser gravado. Mesma conta de
    // `staffPerms` no cliente e de `permsOf` no servidor.
    function fedPerms(fedId) {
      return !(isAuthed() && exists(fedStaffPath(fedId))) ? []
        : (fedStaff(fedId).get('is_master', fedStaff(fedId).role == 'president') ? fedRolePerms('president')
        : (fedStaff(fedId).get('term_end_ms', 0) == 0 || fedStaff(fedId).term_end_ms > request.time.toMillis()
          ? fedStaff(fedId).get('perms', fedRolePerms(fedStaff(fedId).role)) : []));
    }
    // O admin da plataforma só administra uma federação com o acesso
    // JUSTIFICADO valendo: motivo e prazo (até 8 h) registrados pelo servidor
    // (`federationAdminAccess` → `admin_access_logs`). A revisão (aprovar,
    // suspender) e a leitura dos pedidos seguem com `isPlatformAdmin()`.
    function fedPlat(fedId) {
      return isPlatformAdmin()
        && exists(/databases/$(database)/documents/federation_admin_grants/$(fedId + '_' + me()))
        && get(/databases/$(database)/documents/federation_admin_grants/$(fedId + '_' + me())).data.expires_ms > request.time.toMillis();
    }
    function fedHas(fedId, perm) {
      return isAuthed() && (fedPlat(fedId) || perm in fedPerms(fedId));
    }
    // Qualquer uma das permissões, numa leitura só do cargo: várias `fedHas`
    // em OU estouram o teto de 1.000 expressões do Firestore numa leitura negada.
    function fedAny(fedId, perms) {
      return isAuthed() && (fedPlat(fedId) || fedPerms(fedId).hasAny(perms));
    }
    function fedMemberActive(fedId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/federation_members/$(fedId + '_' + me()))
        && get(/databases/$(database)/documents/federation_members/$(fedId + '_' + me())).data.status == 'active';
    }
    // PUBLICADA: aprovada pela plataforma E aberta ao público pelo admin da
    // federação (`published`, ausente = oculta). Antes disso a equipe estrutura
    // tudo, e a federação não aparece para mais ninguém.
    function fedPublic(fedId) {
      return fedApproved(fedId) && fedDoc(fedId).get('published', false) == true;
    }
    // Quem vê a "cara pública" da federação: todos depois de publicada; antes,
    // a equipe, o admin da plataforma (acesso justificado) e quem já é filiado.
    function fedSees(fedId) {
      return fedPublic(fedId) || fedPlat(fedId) || fedPerms(fedId).size() > 0 || fedMemberActive(fedId);
    }
    // Nome, sigla, endereço e nível válidos — no pedido de abertura E em toda edição.
    function fedProfileOk() {
      return nd().name is string
        && nd().name.size() >= 5
        && nd().name.size() <= 120
        && nd().acronym is string
        && nd().acronym.size() >= 2
        && nd().acronym.size() <= 12
        && nd().slug is string
        && nd().slug.matches('[a-z0-9][a-z0-9-]{1,58}[a-z0-9]')
        && nd().level in ['state', 'regional', 'national'];
    }
    // Campos da federação que só o admin da plataforma (ou o servidor) muda.
    function fedLocked() {
      return ['status', 'verified', 'official', 'member_counter', 'member_count', 'created_by', 'created_by_name', 'created_at', 'review', 'cnpj_masked', 'staff_roles', 'doc_numbers', 'referee_rules', 'confederation', 'national_body', 'national_config', 'ambassadors_public', 'adapted_classes', 'payment_gateway'];
    }

    match /federations/{fedId} {
      // Aprovada E publicada pelo admin dela é pública (diretório, /f/:slug); a
      // consulta pública filtra `status` e `published` em igualdade. Oculta:
      // quem pediu, a equipe (qualquer cargo), quem é filiado e o admin.
      allow read: if (od().status == 'approved' && od().published == true)
        || isPlatformAdmin()
        || (isOwner(od().created_by))
        || fedPerms(fedId).size() > 0
        || fedMemberActive(fedId);
      allow create: if fedOn() && isAuthed()
        && nd().created_by == me()
        && nd().status == 'pending'
        && nd().get('verified', false) == false
        && nd().get('official', false) == false
        && !nd().keys().hasAny(['member_counter', 'review', 'staff_roles', 'published', 'confederation', 'national_body', 'national_config', 'ambassadors_public'])
        && fedProfileOk();
      // A equipe (admin) edita página, Pix, marca e módulos — nunca o que dá confiança.
      // Publicar e tirar do ar: só o admin, e só a federação aprovada.
      allow update: if fedPlat(fedId) || (fedOn() && fedHas(fedId, 'admin')
        && !chg().hasAny(fedLocked())
        && (!('published' in chg()) || (od().status == 'approved' && nd().published is bool))
        && (!chg().hasAny(['name', 'acronym', 'slug', 'level']) || fedProfileOk())
        // PR 4: patrocinadores são lista curta (a página e a carteirinha os mostram).
        && (!('sponsors' in chg()) || (nd().sponsors is list && nd().sponsors.size() <= 12)))
        // Competições configura só o ranking oficial.
        || (fedOn() && fedHas(fedId, 'competitions')
          && chg().hasOnly(['ranking_config', 'updated_at']))
        // O financeiro informa o Pix que recebe as filiações (a aba Recebimento é dele).
        || (fedOn() && fedHas(fedId, 'finance')
          && chg().hasOnly(['payment', 'updated_at']));
      allow delete: if isPlatformAdmin();

      // CNPJ completo, razão social: quem pediu (enquanto pendente), a equipe (admin) e o admin da plataforma.
      match /private/{docId} {
        allow read: if docId == 'data' && (isPlatformAdmin() || fedHas(fedId, 'admin')
          || (isAuthed() && exists(/databases/$(database)/documents/federations/$(fedId)) && fedDoc(fedId).created_by == me()));
        allow write: if docId == 'data' && fedOn() && (fedHas(fedId, 'admin')
          || (isAuthed() && exists(/databases/$(database)/documents/federations/$(fedId))
            && fedDoc(fedId).created_by == me() && fedDoc(fedId).status == 'pending'));
      }
    }

    match /federation_staff/{staffId} {
      // A equipe de uma federação APROVADA é a diretoria dela: qualquer conta
      // logada lê (é assim que um clube, um organizador ou um filiado avisa a
      // equipe de um pedido). Da federação pendente, só quem é dela e o admin.
      allow read: if isPlatformAdmin()
        || (isOwner(od().user_id))
        || (isAuthed() && fedSees(od().federation_id))
        || fedAny(od().federation_id, ['admin', 'members', 'finance']);
      // Cargos, mandatos e admins master: SÓ o servidor (`federationStaff`).
      // Ele confere quem pode nomear para quê, grava a cópia das permissões do
      // cargo e garante que sempre sobra um admin master.
      allow write: if false;
    }

    // O acesso justificado do admin da plataforma a uma federação (`fedPlat`):
    // só o servidor abre e fecha; o admin lê o próprio para saber até quando vale.
    match /federation_admin_grants/{grantId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /federation_plans/{planId} {
      // Os planos são públicos (a página da federação os mostra a quem vai se
      // filiar) — da federação publicada; da oculta, quem a vê (`fedSees`).
      allow read: if fedSees(od().federation_id);
      allow create: if fedOn() && fedApproved(nd().federation_id)
        && (fedAny(nd().federation_id, ['admin', 'finance']))
        && nd().name is string
        && nd().name.size() >= 3
        && nd().name.size() <= 80
        && nd().price_cents is int
        && nd().price_cents >= 0
        && nd().price_cents <= 100000000
        && nd().billing in ['monthly', 'annual']
        && nd().tier in ['registered', 'federated']
        // O tipo vem do catálogo da plataforma (`platform_settings/federations`, Etapa 2 de
        // 2026-10-22): atleta, professor, árbitro, clube, arena ou um tipo criado pelo admin.
        // A regra confere o FORMATO do código; quem decide pessoa × clube × arena no pedido é o servidor.
        && nd().person_type is string
        && nd().person_type.matches('[a-z][a-z0-9_]{1,23}')
        && nd().get('entity', 'person') in ['person', 'club', 'arena'];
      allow update: if fedOn() && (fedAny(od().federation_id, ['admin', 'finance']))
        && !chg().hasAny(['federation_id'])
        && nd().price_cents is int
        && nd().price_cents >= 0
        && nd().price_cents <= 100000000
        && nd().billing in ['monthly', 'annual'];
      // Plano com filiação apontando para ele não se apaga: desativa. Só o admin da plataforma apaga.
      allow delete: if fedPlat(od().federation_id);
    }

    // O dono da filiação: a própria pessoa ou, no DEPENDENTE menor (`user_id`
    // nulo), o responsável que o filiou (`guardian_uid`) — D7.
    // Filiação de CLUBE/ARENA por plano (Etapa 2, 2026-10-22): o dono é quem gere a entidade.
    function fedMemberOwner(data) {
      return isAuthed() && (data.get('user_id', null) == me() || data.get('guardian_uid', null) == me()
        || (data.get('org_kind', '') in ['club', 'arena'] && fedOrgManager(data.org_kind, data.org_id)));
    }
    match /federation_members/{memberId} {
      // ⭐ NUNCA pública. O próprio (ou o responsável), a equipe que atende (filiados, financeiro, admin) e o admin da plataforma.
      allow read: if fedMemberOwner(od())
        || fedHas(od().federation_id, 'admin')
        || fedHas(od().federation_id, 'members')
        || fedHas(od().federation_id, 'finance')
        || fedHas(od().federation_id, 'discipline')
        // A lista das filiações de UM clube/arena (consulta por `org_kind` + `org_id`).
        || fedOrgManager(od().get('org_kind', ''), od().get('org_id', ''));
      // 🐞 O `get` da PRÓPRIA filiação ({fed}_{uid}) antes de existir: com o
      // documento ausente `od()` é nulo e a leitura acima dá erro — era o que
      // tirava o "Filiar-se" da página para quem ainda não é filiado (a tela
      // mostrava "não carregou a sua situação"). Mesma lição de
      // `canGetMissingArenaUserDoc`. Só o id com o próprio uid no fim.
      allow get: if isAuthed() && resource == null && memberId.matches('.*_' + me());
      // Só o servidor cria (`federationMembership`): número, estado, validade e código.
      allow create, delete: if false;
      // O próprio muda só as próprias preferências; tudo o mais é do servidor.
      // `minor_photo_consent` é o consentimento do responsável para a foto do menor na verificação pública.
      allow update: if fedOn() && fedMemberOwner(od())
        && chg().hasOnly(['public_badge', 'show_in_directory', 'public_photo', 'minor_photo_consent', 'prefs_updated_at']);

      // CPF (se a federação pede), responsável do menor, nascimento do dependente (PR 3):
      // lê o próprio/responsável, a secretaria e o admin. GRAVA só o servidor
      // (`federationMembership`, no pedido): o nascimento decide o desconto de
      // idade e o consentimento do responsável — não é o navegador que os muda.
      // A secretaria REVELA o CPF com auditoria na tela.
      match /private/{docId} {
        allow read: if docId == 'data' && (fedMemberOwner(get(/databases/$(database)/documents/federation_members/$(memberId)).data)
          || fedAny(memberId.split('_')[0], ['members', 'admin']));
        allow write: if false;
      }
    }

    // Documento enviado para a filiação (PR 3: identidade, atestado,
    // autorização do responsável…). O arquivo mora em `federacao/{uid}/…` no
    // Storage e só quem enviou o abre pela regra; a secretaria o vê pela
    // função `federationDocument` (confere o papel). Aqui só o registro.
    match /federation_documents_submitted/{docId} {
      allow read: if (isOwner(od().user_id))
        || fedHas(od().federation_id, 'members')
        || fedHas(od().federation_id, 'admin')
        // Documento de clube/arena filiado: todos os gestores da entidade veem (Etapa 2).
        || fedOrgManager(od().get('org_kind', ''), od().get('org_id', ''));
      allow create: if fedOn() && isAuthed()
        && nd().user_id == me()
        && nd().status == 'pending'
        && nd().federation_id is string
        && nd().member_id is string
        && nd().kind in ['identidade', 'atestado', 'comprovante_residencia', 'autorizacao_responsavel', 'outro']
        && nd().storage_path is string
        && nd().storage_path.matches('federacao/' + me() + '/[A-Za-z0-9_-]+\\.[a-z]{3,4}')
        // Documento PRÓPRIO do plano ("outro documento" com nome, 2026-10-22): a chave e o nome, curtos.
        && nd().get('doc_key', '').matches('[A-Za-z0-9_-]{0,24}')
        && nd().get('label', '') is string && nd().get('label', '').size() <= 80
        && fedMemberOwner(get(/databases/$(database)/documents/federation_members/$(nd().member_id)).data)
        && nd().federation_id == get(/databases/$(database)/documents/federation_members/$(nd().member_id)).data.federation_id
        && nd().get('org_kind', '') == get(/databases/$(database)/documents/federation_members/$(nd().member_id)).data.get('org_kind', '')
        && nd().get('org_id', '') == get(/databases/$(database)/documents/federation_members/$(nd().member_id)).data.get('org_id', '');
      // A secretaria aceita ou recusa (com motivo) e diz até quando vale; nada mais muda.
      allow update: if fedOn() && (fedAny(od().federation_id, ['members', 'admin']))
        && chg().hasOnly(['status', 'review', 'valid_until', 'updated_at'])
        && nd().status in ['approved', 'rejected']
        && nd().get('valid_until', '') is string;
      // Quem enviou apaga enquanto está em análise (e troca o arquivo); o admin sempre.
      allow delete: if fedPlat(od().federation_id) || (fedOn() && fedHas(od().federation_id, 'admin'))
        || (fedOn() && isOwner(od().user_id) && od().status == 'pending');
    }

    // Transferência de clube ou de federação (PR 3): SÓ o servidor grava
    // (`federationTransfer`). Lê a pessoa, a secretaria da federação atual e,
    // na troca de federação, a secretaria da federação de destino.
    match /federation_transfers/{trId} {
      allow read: if fedMemberOwner(od())
        || fedAny(od().federation_id, ['members', 'admin'])
        || (od().get('to_federation_id', null) is string
          && (fedAny(od().to_federation_id, ['members', 'admin'])))
        // Bloco 6: a confederação que homologa a troca entre duas filiadas.
        || (od().get('homologation_by', null) is string
          && fedAny(od().homologation_by, ['members', 'admin']));
      allow write: if false;
    }

    // Relatório de uma importação de filiados (PR 3): e-mails pendentes de
    // conta. Só a secretaria lê; só o servidor grava (`federationImportMembers`).
    match /federation_imports/{impId} {
      allow read: if fedAny(od().federation_id, ['members', 'admin']);
      allow write: if false;
    }

    // Convite para filiar (`{fed}_{uid}`): a secretaria escolhe a pessoa na
    // lista da plataforma e só o servidor grava (`federationMembership`:
    // invite, invite_cancel, invite_decline). Lê quem foi convidado e a
    // secretaria; aceitar é pedir a filiação no plano do convite.
    match /federation_invites/{invId} {
      allow read: if isOwner(od().user_id)
        || fedAny(od().federation_id, ['members', 'admin']);
      allow write: if false;
    }

    // Curso (PR 3, módulo `courses`): público quando não é rascunho; a equipe
    // (cursos/admin) cria e edita — a inscrição e a credencial são do servidor.
    match /federation_courses/{courseId} {
      allow read: if (od().status != 'draft' && fedSees(od().federation_id))
        || fedAny(od().federation_id, ['courses', 'admin']);
      allow create: if fedOn() && fedModuleOn(nd().federation_id, 'courses')
        && (fedAny(nd().federation_id, ['courses', 'admin']))
        && nd().name is string
        && nd().name.size() >= 3
        && nd().name.size() <= 120
        && nd().kind in ['referee', 'coach', 'clinic', 'workshop', 'director', 'safeguarding', 'antidoping']
        && nd().status in ['draft', 'open', 'closed', 'done', 'cancelled']
        && nd().price_cents is int
        && nd().price_cents >= 0
        && nd().get('enrolled_count', 0) == 0;
      allow update: if fedOn()
        && (fedAny(od().federation_id, ['courses', 'admin']))
        && !chg().hasAny(['federation_id', 'enrolled_count'])
        && nd().status in ['draft', 'open', 'closed', 'done', 'cancelled'];
      allow delete: if fedPlat(od().federation_id) || (fedOn() && fedHas(od().federation_id, 'admin') && od().get('enrolled_count', 0) == 0);
    }

    // Inscrição em curso (`{curso}_{uid}`): só o servidor (`federationCourse`) —
    // confere vagas, filiação exigida e gera a cobrança. Lê o próprio e a equipe.
    match /federation_course_enrollments/{enrId} {
      allow read: if (isOwner(od().user_id))
        || fedAny(od().federation_id, ['courses', 'finance', 'admin']);
      allow write: if false;
    }

    // Credencial (árbitro, treinador…): o servidor emite ao aprovar o curso; a
    // equipe (cursos/admin) revoga. Pública SÓ se a pessoa marcou `public`
    // (diretório de credenciados); a pessoa muda só isso.
    // Competições (Bloco 2): relatório do diretor e convites da final — só o servidor grava.
    match /federation_tournament_reports/{tid} {
      allow read: if isOwner(od().director_uid) || isOwner(od().organizer_uid)
        || fedAny(od().federation_id, ['competitions', 'admin']);
      allow write: if false;
    }
    match /federation_final_invites/{invId} {
      allow read: if isOwner(od().user_id)
        || fedAny(od().federation_id, ['competitions', 'admin']);
      allow write: if false;
    }
    // Seleção e editais (Bloco 3) — só o servidor grava (`federationSelection`).
    // A convocação publicada e o edital publicado são públicos (a lista da
    // delegação leva só nome e categoria; os pagamentos do edital vão à
    // transparência). O convite e a inscrição: a pessoa e a equipe.
    match /federation_callups/{id} {
      allow read: if (od().status in ['open', 'closed', 'cancelled'] && fedSees(od().federation_id))
        || fedAny(od().federation_id, ['competitions', 'finance', 'admin']);
      allow write: if false;
    }
    match /federation_callup_members/{id} {
      allow read: if isOwner(od().user_id) || fedAny(od().federation_id, ['competitions', 'admin']);
      allow write: if false;
    }
    match /federation_grants/{id} {
      allow read: if (od().status in ['open', 'review', 'result', 'final', 'cancelled'] && fedSees(od().federation_id))
        || fedAny(od().federation_id, ['competitions', 'finance', 'admin']);
      allow write: if false;
    }
    match /federation_grant_applications/{id} {
      allow read: if isOwner(od().user_id) || fedAny(od().federation_id, ['competitions', 'finance', 'admin']);
      allow write: if false;
    }
    match /federation_credentials/{credId} {
      allow read: if (od().get('public', false) == true && od().status == 'active' && fedSees(od().federation_id))
        || (isOwner(od().user_id))
        || fedAny(od().federation_id, ['courses', 'admin']);
      allow create, delete: if false;
      allow update: if fedOn() && (
        (isOwner(od().user_id)
          && chg().hasOnly(['public', 'public_photo', 'prefs_updated_at']))
        || ((fedAny(od().federation_id, ['courses', 'admin']))
          && chg().hasOnly(['status', 'review', 'updated_at'])
          && nd().status in ['active', 'revoked'])
      );
    }

    // Sanção disciplinar (PR 3, módulo `discipline`): SÓ o servidor grava
    // (`federationDiscipline`), inclusive o recurso. ⭐ Só a pessoa, a
    // disciplina/admin da federação e o admin da plataforma leem (D11).
    // Ocorrências (lesão, acidente) do módulo de seguro: SÓ o servidor grava
    // (`federationRegularity`). Leem o atleta (ou o responsável), quem registrou
    // e a equipe que atende (filiados, competições, admin).
    match /federation_incidents/{incId} {
      allow read: if fedMemberOwner(od()) || isOwner(od().reported_by)
        || fedAny(od().federation_id, ['members', 'competitions', 'admin']);
      allow write: if false;
    }

    match /federation_sanctions/{sancId} {
      allow read: if fedMemberOwner(od())
        || fedAny(od().federation_id, ['discipline', 'admin']);
      allow write: if false;
    }

    // Ouvidoria (PR 3): qualquer conta logada abre uma manifestação, anônima
    // ou não — anônima NÃO grava `reporter_uid`. O protocolo é o id do
    // documento: quem o tem acompanha (get, nunca list). Trata a disciplina.
    // A denúncia de PROTEÇÃO DE MENOR (`minor_protection`, Bloco 4) é de acesso
    // restrito: só a permissão `safeguarding` (o admin master a tem) a lê e
    // trata — a disciplina e o admin comum, não (consultam `kind in` os demais).
    function fedRepStaff(rep) {
      return rep.kind == 'minor_protection'
        ? fedAny(rep.federation_id, ['safeguarding'])
        : fedAny(rep.federation_id, ['discipline', 'admin']);
    }
    match /federation_reports/{repId} {
      allow get: if (isAuthed() && od().get('anonymous', false) == true)
        || (isAuthed() && od().get('reporter_uid', null) == me())
        || fedRepStaff(od());
      allow list: if (isAuthed() && od().get('reporter_uid', null) == me())
        || fedRepStaff(od());
      allow create: if fedOn() && isAuthed()
        && fedModuleOn(nd().federation_id, 'discipline')
        && fedSees(nd().federation_id)
        && nd().status == 'open'
        && (nd().kind in ['conduct', 'referee', 'organization', 'other']
          || (nd().kind == 'minor_protection' && fedModuleOn(nd().federation_id, 'safeguarding')))
        && nd().body is string
        && nd().body.size() >= 20
        && nd().body.size() <= 2000
        && nd().anonymous is bool
        && (nd().anonymous
          ? nd().get('reporter_uid', null) == null
          : nd().reporter_uid == me())
        && !nd().keys().hasAny(['notes', 'handled_by']);
      allow update: if fedOn()
        && fedRepStaff(od())
        && chg().hasOnly(['status', 'notes', 'handled_by', 'updated_at'])
        && nd().status in ['open', 'in_review', 'closed'];
      allow delete: if fedPlat(od().federation_id);
    }

    // LICENÇA DE PROFESSOR e PROTEÇÃO DE MENORES (Bloco 4) — só o servidor
    // grava (`federationCoaching`). A licença: o professor e a equipe de cursos
    // (ou o admin). O SELO (`federation_coach_badges/{uid}`) é público: só as
    // licenças válidas que o professor deixou aparecer, de federação publicada.
    // O registro da proteção (certidão conferida, curso válido): a pessoa e a
    // permissão `safeguarding` — o resultado da certidão nunca sai daqui.
    match /federation_coach_licenses/{id} {
      allow read: if isOwner(od().user_id) || fedAny(od().federation_id, ['courses', 'admin']);
      allow write: if false;
    }
    match /federation_coach_badges/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /federation_safeguarding/{id} {
      allow read: if isOwner(od().user_id) || fedAny(od().federation_id, ['safeguarding']);
      allow write: if false;
    }

    // PR 4: NOTÍCIAS E AVISOS (módulo `news`). A equipe de comunicação
    // (`comms`/`admin`) grava pelo cliente. Publicada e PÚBLICA é lida por
    // qualquer um (página fora do app); "só filiados" por quem tem filiação
    // ATIVA nesta federação. O aviso aos filiados é do servidor
    // (`federationNews`): `notified_at`/`notified_count` o cliente não toca.
    match /federation_news/{newsId} {
      allow read: if (od().status == 'published'
          && ((od().audience == 'public' && fedSees(od().federation_id)) || (od().audience == 'members' && fedMemberActive(od().federation_id))))
        || fedAny(od().federation_id, ['comms', 'admin']);
      allow create: if fedOn() && fedModuleOn(nd().federation_id, 'news')
        && (fedAny(nd().federation_id, ['comms', 'admin']))
        && nd().title is string
        && nd().title.size() >= 3
        && nd().title.size() <= 140
        && nd().body is string
        && nd().body.size() <= 6000
        && nd().status in ['draft', 'scheduled', 'published', 'archived']
        && (nd().status != 'scheduled' || nd().publish_at_ms is number)
        && nd().audience in ['public', 'members']
        && !nd().keys().hasAny(['notified_at', 'notified_count']);
      allow update: if fedOn()
        && (fedAny(od().federation_id, ['comms', 'admin']))
        && !chg().hasAny(['federation_id', 'notified_at', 'notified_count'])
        && nd().title is string
        && nd().title.size() >= 3
        && nd().title.size() <= 140
        && nd().status in ['draft', 'scheduled', 'published', 'archived']
        && (nd().status != 'scheduled' || nd().publish_at_ms is number)
        && nd().audience in ['public', 'members'];
      allow delete: if fedPlat(od().federation_id)
        || (fedOn() && (fedAny(od().federation_id, ['comms', 'admin'])));
    }

    // ACERVO OFICIAL (módulo `official_docs`): normas, atos, atas, editais,
    // transparência. Só o SERVIDOR grava (`functions/federationAcervo.js`):
    // numeração, imutabilidade do publicado e SHA-256 dos arquivos não se
    // garantem no navegador. Leitura: publicado e público, qualquer um (sem
    // conta); "só filiados", filiado ativo e a equipe; "só equipe", quem é da equipe; a
    // equipe do acervo (docs/admin) lê tudo, rascunho e retirado inclusive.
    // A consulta da tela traz `status` e `visibility` em igualdade, para a
    // regra ser provável sem índice.
    match /federation_docs/{docId} {
      allow read: if (od().status == 'published'
          && ((od().visibility == 'public' && fedSees(od().federation_id))
            || (od().visibility == 'members' && fedMemberActive(od().federation_id))
            || (od().visibility in ['members', 'staff'] && (fedPlat(od().federation_id) || fedPerms(od().federation_id).size() > 0))))
        || fedAny(od().federation_id, ['docs', 'admin']);
      allow write: if false;
    }

    // CALENDÁRIO OFICIAL (módulo `calendar`): agenda esportiva, assembleias,
    // reuniões, prazos e eventos. Só o SERVIDOR grava
    // (`functions/federationAgenda.js`): adiar, remarcar e cancelar o que já
    // foi divulgado exige motivo e histórico. Não há rascunho: o evento "só
    // equipe" é o que ainda não se divulga. Leitura como no acervo — público,
    // qualquer um; "só filiados", filiado ativo e equipe; "só equipe", a
    // equipe. A tela consulta com `visibility` em igualdade (regra provável).
    match /federation_events/{eventId} {
      allow read: if (od().visibility == 'public' && fedSees(od().federation_id))
        || (od().visibility == 'members' && fedMemberActive(od().federation_id))
        || (od().visibility in ['members', 'staff'] && (fedPlat(od().federation_id) || fedPerms(od().federation_id).size() > 0));
      allow write: if false;
    }

    // ORÇAMENTO E PRESTAÇÃO DE CONTAS (módulo `accounts`): só o SERVIDOR
    // grava (`functions/federationAccounts.js`). Lê o financeiro, o conselho
    // fiscal e o admin; o orçamento e a prestação PUBLICADOS (`pub`, que nunca
    // volta a falso) leem todos que veem a federação, com o módulo ligado. A
    // consulta pública traz `pub == true` em igualdade (regra provável). O
    // lançamento é só da equipe das contas.
    function fedAcc(fid) {
      return fedHas(fid, 'finance') || fedHas(fid, 'fiscal') || fedHas(fid, 'admin');
    }
    function fedAccPub() {
      return od().get('pub', false) == true && fedModuleOn(od().federation_id, 'accounts') && fedSees(od().federation_id);
    }
    match /federation_budgets/{id} {
      allow read: if fedAcc(od().federation_id) || fedAccPub();
      allow write: if false;
    }
    match /federation_account_reports/{id} {
      allow read: if fedAcc(od().federation_id) || fedAccPub();
      allow write: if false;
    }
    match /federation_ledger/{id} {
      allow read: if fedAcc(od().federation_id);
      allow write: if false;
    }
    // CONTRATOS DE PATROCÍNIO (módulo `sponsors`) e PATRIMÔNIO (módulo
    // `assets`), Bloco 5. Só o SERVIDOR grava (`federationManagement`): a
    // parcela recebida vira receita nas contas e o período fechado não muda.
    // Contrato: financeiro, admin e conselho fiscal (`fedAcc`). Patrimônio:
    // os mesmos e as competições (o material vai aos eventos). Nada público.
    match /federation_sponsor_contracts/{id} {
      allow read: if fedAcc(od().federation_id);
      allow write: if false;
    }
    match /federation_assets/{id} {
      allow read: if fedAcc(od().federation_id) || fedHas(od().federation_id, 'competitions');
      allow write: if false;
    }
    // REGULARIDADE DA PRÓPRIA FEDERAÇÃO (rodada 3, Bloco 2): o cofre de
    // certidões e os projetos da Lei de Incentivo. Financeiro, admin e
    // conselho fiscal leem; só o servidor grava (`federationInstitutional`).
    // O arquivo da certidão fica numa pasta do Storage sem regra (fechada) e
    // sai pela função.
    match /federation_certificates/{id} {
      allow read: if fedAcc(od().federation_id);
      allow write: if false;
    }
    match /federation_incentive_projects/{id} {
      allow read: if fedAcc(od().federation_id);
      allow write: if false;
    }
    // PICKLEBALL ADAPTADO (rodada 3, Bloco 4b): a classificação do atleta
    // (categoria, revisão, o caminho do laudo) só a pessoa e a comissão
    // (competições/admin) leem — o laudo em si fica numa pasta fechada do
    // Storage e abre pela função. Só o servidor grava (`federationAdapted`);
    // as categorias da federação (`adapted_classes`) estão em `fedLocked()`.
    match /federation_adapted_classifications/{id} {
      allow read: if isOwner(od().user_id) || fedAny(od().federation_id, ['competitions', 'admin']);
      allow write: if false;
    }
    // REDE E DESENVOLVIMENTO (rodada 3, Bloco 3): a candidatura e o mandato de
    // embaixador (motivação, relatórios) só a pessoa e a secretaria/admin leem
    // — a lista pública (nome, foto, região, sem uid) é o campo
    // `federations.ambassadors_public`, gravado pelo servidor. O pedido de selo
    // (evidências) só quem gere a organização e a secretaria/admin; o selo
    // concedido sai em `federation_affiliations.seal`. Só o servidor grava
    // (`federationDevelopment`).
    match /federation_ambassadors/{id} {
      allow read: if isOwner(od().user_id) || fedAny(od().federation_id, ['members', 'admin']);
      allow write: if false;
    }
    match /federation_club_seals/{id} {
      allow read: if fedOrgManager(od().kind, od().org_id) || fedAny(od().federation_id, ['members', 'admin']);
      allow write: if false;
    }
    // SEGURO (rodada 3, Bloco 5): o certificado de seguro do evento do clube ou
    // da arena — leem quem gere a organização e a secretaria/admin; a
    // verificação pública passa pela função. Só o servidor grava
    // (`federationInsurance`).
    match /federation_insurance_certificates/{id} {
      allow read: if fedOrgManager(od().kind, od().org_id) || fedAny(od().federation_id, ['members', 'admin']);
      allow write: if false;
    }
    // SEDES E COPA (rodada 3, Bloco 3): o edital de sede e a Copa das
    // Federações são públicos depois de publicados (o rascunho só a equipe);
    // a candidatura (carta, proposta) só quem gere a organização e a equipe;
    // as notas da comissão só a equipe; o elenco da Copa as duas equipes e o
    // próprio atleta (`athlete_uids`, a exportação dele lê dali). Só o servidor
    // grava (`federationHosting`) — sem `allow write`, nada passa.
    function fedComp(f) {
      return fedAny(f, ['admin', 'competitions']);
    }
    match /federation_host_bids/{id} {
      allow read: if (od().status != 'draft' && fedSees(od().federation_id)) || fedComp(od().federation_id);
    }
    match /federation_host_entries/{id} {
      allow read: if fedOrgManager(od().kind, od().org_id) || fedComp(od().federation_id);
    }
    match /federation_host_scores/{id} {
      allow read: if fedComp(od().federation_id);
    }
    match /federation_cups/{id} {
      allow read: if (od().status != 'draft' && fedSees(od().federation_id)) || fedComp(od().federation_id);
    }
    match /federation_cup_teams/{id} {
      allow read: if me() in od().athlete_uids || fedComp(od().conf_id) || fedComp(od().federation_id);
    }
    // JOGO LIMPO (rodada 3, Bloco 1): a lista de equipamentos homologados é
    // pública com o módulo ligado (a estadual mostra também a da confederação);
    // a equipe de competições e o admin leem sempre. Só o servidor grava
    // (`federationIntegrity`).
    match /federation_equipment/{id} {
      allow read: if (fedSees(od().federation_id) && fedModuleOn(od().federation_id, 'equipment'))
        || fedAny(od().federation_id, ['competitions', 'admin']);
      allow write: if false;
    }
    // CAMADA NACIONAL (Bloco 6): só o SERVIDOR grava (`federationNational`).
    // O vínculo da estadual com a confederação (`{conf}_{fed}`): qualquer
    // cargo das duas lê (a lista pública das filiadas sai do espelho
    // `federations.national_body`). A anuidade (`{conf}_{fed}_{ano}`): as
    // contas das duas (financeiro, conselho fiscal, admin).
    match /federation_national_links/{id} {
      allow read: if fedPlat(od().federation_id) || fedPerms(od().federation_id).size() > 0
        || fedPlat(od().conf_id) || fedPerms(od().conf_id).size() > 0;
      allow write: if false;
    }
    match /federation_dues/{id} {
      allow read: if fedAcc(od().federation_id) || fedAcc(od().conf_id);
      allow write: if false;
    }
    // REPASSES da cobrança dividida (Bloco 6d): a parte do clube e da confederação
    // numa filiação paga. Só o SERVIDOR grava (`federations.js` anota, `federationSplit`
    // marca repassado); lê quem lê as contas de quem repassa e da confederação que recebe.
    match /federation_repasses/{id} {
      allow read: if fedAcc(od().federation_id) || (od().to == 'confederation' && fedAcc(od().to_id));
      allow write: if false;
    }
    // ARBITRAGEM (módulo `referees`): o quadro (`{fed}_{uid}`) e as escalas.
    // Só o SERVIDOR grava (`federationReferees`): os alertas da convocação
    // leem dados de outras pessoas, e a diária paga vira despesa. Lê a equipe
    // de arbitragem (`courses`, ou `admin`) e o próprio árbitro — valores,
    // notas e conflitos não são públicos; o quadro público e quem apita
    // passam pela função `federationRefereesPublic`. As notas internas da
    // equipe (`private/staff`) o árbitro não lê.
    function fedRef(fedId) {
      return fedHas(fedId, 'courses') || fedHas(fedId, 'admin');
    }
    match /federation_referees/{id} {
      allow read: if isOwner(od().user_id) || fedRef(od().federation_id);
      allow write: if false;
      match /private/{doc} {
        allow read: if fedRef(id.split('_')[0]);
        allow write: if false;
      }
    }
    match /federation_assignments/{id} {
      allow read: if isOwner(od().referee_uid) || fedRef(od().federation_id);
      allow write: if false;
    }

    // Quem SEGUE as publicações oficiais — acervo e calendário (id
    // `{fed}_{uid}`): só a própria pessoa lê, segue e deixa de seguir. O aviso
    // é do servidor, e só vai a quem pode ler o ato ou o evento. `get` do
    // documento que ainda não existe: é assim que o botão sabe se a pessoa
    // segue (sem isso o `get` dá permissão negada).
    // COMENTÁRIOS nos documentos do acervo e nos eventos da agenda: só o
    // SERVIDOR grava (`federationComments`), e a lista pública passa por ele
    // (quem vê o comentário é quem vê o documento ou o evento AGORA). A pessoa
    // lê só os próprios — é a exportação dos dados. As denúncias ninguém lê
    // pelo cliente: quem denunciou não aparece para quem foi denunciado.
    match /federation_comments/{id} {
      allow read: if isOwner(od().user_id);
      allow write: if false;
    }
    match /federation_comment_reports/{id} {
      allow read, write: if false;
    }

    // ELEIÇÕES (módulo `elections`): só o SERVIDOR grava (`federationElections`).
    // Conduz a COMISSÃO eleitoral (`commission_uids`); sem comissão, o admin.
    // Edital e chapas ACEITAS são públicos (`public`); o resto, comissão e admin.
    // A CÉDULA ninguém lê pelo cliente — ela não tem uid, e o eleitor só mostra
    // que votou, nunca em quem. A tela consulta com `federation_id` em
    // igualdade (regra provável).
    function fedElRun(eid, fid) {
      let c = get(/databases/$(database)/documents/federation_elections/$(eid)).data.get('commission_uids', []);
      return me() in c || (c.size() == 0 && fedHas(fid, 'admin'));
    }
    match /federation_elections/{id} {
      allow read: if (od().public == true && fedSees(od().federation_id) && fedModuleOn(od().federation_id, 'elections'))
        || me() in od().get('commission_uids', []) || fedHas(od().federation_id, 'admin');
      allow write: if false;
    }
    match /federation_candidacies/{id} {
      allow read: if (od().public == true && fedSees(od().federation_id) && fedModuleOn(od().federation_id, 'elections'))
        || me() in od().member_uids || fedElRun(od().election_id, od().federation_id) || fedHas(od().federation_id, 'admin');
      allow write: if false;
    }
    match /federation_election_voters/{id} {
      allow read: if isOwner(od().user_id) || fedElRun(od().election_id, od().federation_id);
      allow write: if false;
    }
    match /federation_election_endorsements/{id} {
      allow read: if isOwner(od().user_id);
      allow write: if false;
    }
    match /federation_ballots/{id} {
      allow read, write: if false;
    }

    match /federation_followers/{id} {
      allow get: if isAuthed() && resource == null && id == id.split('_')[0] + '_' + me();
      allow read, delete: if isOwner(od().user_id);
      allow create: if fedOn() && isAuthed()
        && id == nd().federation_id + '_' + me()
        && nd().user_id == me()
        && nd().keys().hasOnly(['federation_id', 'user_id', 'created_at'])
        && nd().created_at == request.time
        && (fedModuleOn(nd().federation_id, 'official_docs') || fedModuleOn(nd().federation_id, 'calendar'))
        && fedSees(nd().federation_id);
    }

    match /federation_charges/{chargeId} {
      // O conselho fiscal (`fiscal`) confere as receitas (a cobrança paga entra nas contas).
      allow read: if (isOwner(od().payer_uid))
        || fedAny(od().federation_id, ['admin', 'finance', 'members', 'fiscal'])
        // Competições vê a taxa de chancela (aprova depois do pagamento).
        || (od().get('origin', '') == 'sanction' && fedHas(od().federation_id, 'competitions'));
      // Só o servidor cria; confirmar e cancelar também são dele.
      allow create, delete: if false;
      // "Já paguei": o pagador só DECLARA — aberta/informada → informada, com a observação
      // e, opcional, o COMPROVANTE: um arquivo da PRÓPRIA pasta (`federacao/{uid}/`),
      // que a equipe abre pela função `federationDocument` (`chargeId`).
      allow update: if fedOn() && isOwner(od().payer_uid)
        && od().status in ['open', 'declared']
        && nd().status == 'declared'
        && chg().hasOnly(['status', 'declared_at', 'declared_note', 'declared_proof'])
        && nd().get('declared_note', '') is string
        && nd().get('declared_note', '').size() <= 300
        && (!chg().hasAny(['declared_proof']) || (nd().declared_proof is map
          && nd().declared_proof.keys().hasOnly(['path', 'name', 'content_type', 'size'])
          && nd().declared_proof.path is string
          && nd().declared_proof.path.matches('federacao/' + me() + '/[A-Za-z0-9_-]+[.](pdf|jpg|png|webp)')
          && nd().declared_proof.get('name', '') is string
          && nd().declared_proof.get('name', '').size() <= 120));
    }

    // Código da carteirinha → filiação. Só o servidor (a verificação é a função `federationVerify`).
    match /federation_card_index/{code} {
      allow read, write: if false;
    }

    // --- PR 2: clubes e arenas filiados, resultados chancelados e o ranking oficial ---
    // Quem gere a organização: admin do clube ou gestor da arena.
    function fedOrgManager(kind, orgId) {
      return (kind == 'club' && isClubAdmin(orgId)) || (kind == 'arena' && isArenaManager(orgId));
    }
    function fedModuleOn(fedId, moduleId) {
      return fedApproved(fedId) && fedDoc(fedId).get('modules', {}).get(moduleId, false) == true;
    }

    // Filiação de CLUBE/ARENA (`{fed}_{club|arena}_{org}`): a organização PEDE
    // (pendente) e retira; a equipe (filiados/admin) aprova, recusa, suspende.
    // Filiado é público (página da federação, selo no clube/arena).
    match /federation_affiliations/{affId} {
      allow read: if (od().status == 'approved' && fedSees(od().federation_id))
        || (isOwner(od().requested_by))
        || fedOrgManager(od().kind, od().org_id)
        || fedAny(od().federation_id, ['admin', 'members']);
      // A organização PEDE (`pending`) ou a equipe CONVIDA (`invited`, 2026-10-22).
      allow create: if fedOn() && isAuthed()
        && ((nd().status == 'pending' && nd().requested_by == me() && fedOrgManager(nd().kind, nd().org_id))
          || (nd().status == 'invited' && nd().invited_by == me() && nd().requested_by == null
            && (fedAny(nd().federation_id, ['admin', 'members']))))
        && nd().kind in ['club', 'arena']
        && nd().org_id is string
        && nd().federation_id is string
        && affId == nd().federation_id + '_' + nd().kind + '_' + nd().org_id
        && nd().get('message', '') is string
        && nd().get('message', '').size() <= 500
        // O selo de clube certificado (`seal`) só o servidor grava.
        && !('seal' in nd())
        && fedModuleOn(nd().federation_id, 'affiliations')
        && fedPublic(nd().federation_id);
      // A equipe decide o pedido; quem gere a organização ACEITA o convite (vira filiado).
      allow update: if fedOn()
        && (((fedAny(od().federation_id, ['admin', 'members']))
            && od().status != 'invited'
            // A filiação POR PLANO (`member_id`) é espelho do servidor: decide-se na filiação.
            && !('member_id' in od())
            && chg().hasOnly(['status', 'review', 'updated_at'])
            && nd().status in ['approved', 'rejected', 'suspended'])
          || (od().status == 'invited' && fedOrgManager(od().kind, od().org_id)
            && nd().status == 'approved' && nd().requested_by == me()
            && chg().hasOnly(['status', 'requested_by', 'accepted_at_ms', 'updated_at'])));
      // A organização retira/recusa; o admin apaga; quem cuida dos filiados cancela convite ou limpa recusado.
      allow delete: if fedPlat(od().federation_id)
        || (fedOn() && !('member_id' in od()) && (fedOrgManager(od().kind, od().org_id) || fedHas(od().federation_id, 'admin')))
        || (fedOn() && fedHas(od().federation_id, 'members') && od().status in ['invited', 'rejected']);
    }

    // O torneio tem a chancela APROVADA desta federação?
    function fedSanctionedBy(tid, fedId) {
      let tdoc = get(/databases/$(database)/documents/tournaments/$(tid)).data;
      return tdoc.get('federation_id', null) == fedId
        && tdoc.get('federation_sanction', {}).get('status', '') == 'approved';
    }

    // A temporada (ano) do ranking oficial ainda aceita mudança? Fecha em
    // 1º/fev do ano seguinte, 00:00 de Brasília (03:00 UTC) — o mês de folga é
    // para o resultado de um torneio de dezembro chegar. Depois disso o ano é
    // IMUTÁVEL: nenhum resultado dele entra, muda ou sai. Mesma data em
    // `seasonClosesAtMs` (domínio e servidor).
    function fedSeasonOpen(s) {
      return s is int && request.time < timestamp.date(s + 1, 2, 1) + duration.value(3, 'h');
    }

    // RESULTADO de uma categoria de torneio chancelado (`{fed}_{torneio}_{categoria}`):
    // o organizador envia e reenvia (`sent`); competições recusa ou readmite.
    // Público, como o quadro do torneio — e o ranking que sai dele. Só na
    // temporada ABERTA, e a temporada do documento nunca muda.
    match /federation_results/{resId} {
      allow read: if true;
      allow create: if fedOn() && isAuthed()
        && nd().federation_id is string
        && nd().tournament_id is string
        && nd().modality_id is string
        && resId == nd().federation_id + '_' + nd().tournament_id + '_' + nd().modality_id
        && nd().status == 'sent'
        && fedSeasonOpen(nd().season)
        && nd().sent_by == me()
        && nd().rows is list
        && nd().rows.size() <= 400
        && isTournamentAdmin(nd().tournament_id)
        && fedSanctionedBy(nd().tournament_id, nd().federation_id)
        // O peso (tier) é o da chancela — não o que quem envia escolher.
        && nd().get('tier', null) == get(/databases/$(database)/documents/tournaments/$(nd().tournament_id)).data.federation_sanction.get('tier', 'regional');
      allow update: if fedOn() && isAuthed()
        && nd().federation_id == od().federation_id
        && nd().tournament_id == od().tournament_id
        && nd().modality_id == od().modality_id
        && nd().get('season', null) == od().get('season', null)
        && fedSeasonOpen(od().season)
        && (
          (nd().status == 'sent'
            && nd().sent_by == me()
            && nd().rows is list
            && nd().rows.size() <= 400
            && isTournamentAdmin(od().tournament_id)
            && fedSanctionedBy(od().tournament_id, od().federation_id)
            // No reenvio também: a categoria é a da chancela, não a de quem envia.
            && nd().get('tier', null) == get(/databases/$(database)/documents/tournaments/$(od().tournament_id)).data.federation_sanction.get('tier', 'regional'))
          || (fedHas(od().federation_id, 'competitions')
            && chg().hasOnly(['status', 'review', 'updated_at'])
            && nd().status in ['sent', 'rejected'])
        );
      allow delete: if fedSeasonOpen(od().season) && (fedPlat(od().federation_id)
        || (fedOn() && fedHas(od().federation_id, 'admin'))
        || (fedOn() && isTournamentAdmin(od().tournament_id)));
    }

    // LANÇAMENTOS de pontos no histórico do atleta (`{resultado}_{uid}`): um
    // por categoria de torneio; o cancelado fica, com o motivo. Público como o
    // resultado e o ranking; só o servidor grava (`federationRankingRecompute`).
    match /federation_points/{pointId} {
      allow read: if true;
      allow write: if false;
    }

    // Ranking oficial por temporada (`{fed}_{ano}`): só o servidor grava (`federationRankingRecompute`).
    match /federation_rankings/{rankId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
