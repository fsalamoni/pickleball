rules_version = '2';

// Regras do Firebase Storage.
//
// Estrutura: todos os uploads ficam em `uploads/{uid}/...`, garantindo que
// cada usuário só possa gravar/excluir os próprios arquivos. A leitura é
// liberada para usuários autenticados (e as URLs de download com token
// permanecem acessíveis para exibição de imagens e anexos). Aceitamos imagens
// e documentos (chat e fóruns), sempre com limite de tamanho para evitar abuso.
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() { return request.auth != null; }
    function sizeOk() { return request.resource.size < 25 * 1024 * 1024; }

    // ⚠️ SEMÂNTICA DAS REGRAS: quando vários `match` alcançam o mesmo caminho,
    // o acesso é concedido se QUALQUER um permitir. Por isso o bloco genérico
    // abaixo precisa EXCLUIR explicitamente a pasta `private` — um bloco
    // restritivo sozinho não teria efeito nenhum. Verificado no emulador.

    // Arquivos SENSÍVEIS: comprovantes, documentos, anexos de suporte.
    // Só o dono lê, grava e apaga. ADITIVO — nada grava aqui hoje, então
    // nenhum arquivo existente muda de comportamento. É o destino de todo
    // upload sensível novo. Achado P1-05.
    //
    // Limite honesto: a URL de download do Firebase carrega um token e quem
    // tiver a URL acessa o arquivo mesmo assim. Isto protege contra
    // ENUMERAÇÃO de caminho, não contra o vazamento da própria URL — para
    // isso é preciso signed URL de curta duração (ver 10-SEGURANCA-TECNICA).
    match /uploads/{uid}/private/{allPaths=**} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow write: if isAuthed() && request.auth.uid == uid && sizeOk();
      allow delete: if isAuthed() && request.auth.uid == uid;
    }

    // Conteúdo exibido a outras pessoas (foto de perfil, foto de torneio,
    // anexo de chat, logo de arena). Comportamento INALTERADO, exceto por não
    // alcançar mais a pasta `private`.
    match /uploads/{uid}/{folder}/{allPaths=**} {
      // `get` (abrir pelo link) para quem tem conta; `list` (enumerar a pasta)
      // só do dono — senão qualquer conta listava os anexos de chat alheios.
      allow get: if isAuthed() && folder != 'private';
      allow list: if isAuthed() && request.auth.uid == uid && folder != 'private';
      allow write: if isAuthed() && request.auth.uid == uid && sizeOk()
        && folder != 'private';
      allow delete: if isAuthed() && request.auth.uid == uid && folder != 'private';
    }

    // Compatibilidade: arquivo solto direto em `uploads/{uid}/arquivo`, sem
    // pasta. O código atual sempre usa uma pasta, mas arquivos antigos podem
    // existir nesse formato e não podem perder acesso.
    match /uploads/{uid}/{fileName} {
      allow get: if isAuthed();
      allow list: if isAuthed() && request.auth.uid == uid;
      allow write: if isAuthed() && request.auth.uid == uid && sizeOk();
      allow delete: if isAuthed() && request.auth.uid == uid;
    }

    // Centro de Treino (flag `training_center`): imagens e vídeos dos itens de
    // treino. ADITIVO — pasta nova, nada antigo muda.
    //  - `get` para qualquer conta logada (o item pode ser público); `list`
    //    SÓ do dono, para ninguém enumerar a pasta de outra pessoa e achar a
    //    mídia de um item privado;
    //  - envio só do dono, com TIPO e TAMANHO conferidos aqui: imagem
    //    WebP/JPEG/PNG < 3 MB (o navegador comprime antes), vídeo
    //    MP4/WebM/MOV < 60 MB. A configuração do admin só pode baixar esses
    //    tetos (conferido no cliente);
    //  - sem sobrescrever (`resource == null`; no Storage gravar por cima de
    //    um arquivo conta como `create`): arquivo novo é arquivo novo.
    match /treino/{uid}/{fileName} {
      allow get: if isAuthed();
      allow list: if isAuthed() && request.auth.uid == uid;
      allow create: if isAuthed() && request.auth.uid == uid && resource == null && (
        (request.resource.contentType.matches('image/(webp|jpeg|png)')
          && request.resource.size < 3 * 1024 * 1024)
        || (request.resource.contentType.matches('video/(mp4|webm|quicktime)')
          && request.resource.size < 60 * 1024 * 1024)
      );
      allow delete: if isAuthed() && request.auth.uid == uid;
    }

    // Mercado (flag `marketplace`): fotos e vídeos dos anúncios e o
    // comprovante do Pix. Mesmo desenho do `treino/`: `get` para conta logada
    // (o anúncio é público; o comprovante tem nome aleatório e só o pedido
    // guarda o caminho), `list` só do dono, envio só do dono com tipo e
    // tamanho conferidos, sem sobrescrever. ADITIVO.
    match /mercado/{uid}/{fileName} {
      allow get: if isAuthed();
      allow list: if isAuthed() && request.auth.uid == uid;
      allow create: if isAuthed() && request.auth.uid == uid && resource == null && (
        (request.resource.contentType.matches('image/(webp|jpeg|png)')
          && request.resource.size < 3 * 1024 * 1024)
        || (request.resource.contentType.matches('video/(mp4|webm|quicktime)')
          && request.resource.size < 60 * 1024 * 1024)
        || (request.resource.contentType == 'application/pdf'
          && request.resource.size < 3 * 1024 * 1024)
      );
      // O comprovante do Pix é prova do pedido (a moderação o abre numa
      // disputa): quem pagou não o apaga. A exclusão de conta usa o servidor.
      allow delete: if isAuthed() && request.auth.uid == uid && !fileName.matches('comprovante-.*');
    }

    // Federações (flag `federations`, PR 3): documentos de filiação (identidade,
    // atestado, autorização do responsável). SÓ QUEM ENVIOU lê pela regra —
    // a secretaria o vê pela função `federationDocument`, que confere o papel
    // na equipe e devolve o arquivo (a regra do Storage não consulta o banco
    // nomeado `pickleball`). PDF ou imagem < 5 MB, sem sobrescrever. ADITIVO.
    match /federacao/{uid}/{fileName} {
      allow get: if isAuthed() && request.auth.uid == uid;
      allow list: if isAuthed() && request.auth.uid == uid;
      allow create: if isAuthed() && request.auth.uid == uid && resource == null && (
        (request.resource.contentType.matches('image/(webp|jpeg|png)')
          && request.resource.size < 5 * 1024 * 1024)
        || (request.resource.contentType == 'application/pdf'
          && request.resource.size < 5 * 1024 * 1024)
      );
      allow delete: if isAuthed() && request.auth.uid == uid;
    }

    // Acervo oficial da federação (módulo `official_docs`): o RASCUNHO sobe
    // para a pasta de quem envia (só ela lê); ao publicar, a função
    // `federationAcervo` copia para `federacao-acervo-oficial/` (fechada à
    // regra: o documento público ganha link próprio, o restrito é entregue
    // pela função) e apaga a origem. Tetos iguais a `ACERVO_FILE_FAMILIES`
    // (`src/modules/federations/domain/acervo.js`). ADITIVO.
    match /federacao-acervo/{uid}/{fileName} {
      allow get, list, delete: if isAuthed() && request.auth.uid == uid;
      allow create: if isAuthed() && request.auth.uid == uid && resource == null && (
        (request.resource.contentType.matches('application/pdf|text/(plain|csv)|application/msword|application/vnd[.]ms-excel|application/vnd[.]openxmlformats-officedocument[.][a-z.]+|application/vnd[.]oasis[.]opendocument[.][a-z.]+')
          && request.resource.size < 25 * 1024 * 1024)
        || (request.resource.contentType.matches('image/(webp|jpeg|png)')
          && request.resource.size < 10 * 1024 * 1024)
        || (request.resource.contentType.matches('audio/(mpeg|mp4|ogg|wav|x-m4a|webm)')
          && request.resource.size < 50 * 1024 * 1024)
        || (request.resource.contentType.matches('video/(mp4|webm|quicktime)')
          && request.resource.size < 100 * 1024 * 1024)
      );
    }

    // Contas da federação (módulo `accounts`): a nota, o recibo ou a
    // demonstração sobe para a pasta de quem envia (só ela lê); ao lançar ou
    // salvar a prestação, a função `federationAccounts` copia para
    // `federacao-contas-oficial/` (fechada à regra: a equipe das contas abre
    // pela função) e apaga a origem. PDF ou imagem até 9 MB, como
    // `ACCOUNT_FILE_MAX` (`src/modules/federations/domain/accounts.js`). ADITIVO.
    match /federacao-contas/{uid}/{fileName} {
      allow get, list, delete: if isAuthed() && request.auth.uid == uid;
      allow create: if isAuthed() && request.auth.uid == uid && resource == null
        && request.resource.contentType.matches('application/pdf|image/(webp|jpeg|png)')
        && request.resource.size <= 9 * 1024 * 1024;
    }

    // ACERVO DO CLUBE-ASSOCIAÇÃO (Bloco D2): a mesma pasta de rascunho da federação, para a
    // função `clubDocs` copiar para `clube-acervo-oficial/` (fechada à regra) e apagar a origem.
    match /clube-acervo/{uid}/{fileName} {
      allow get, list, delete: if isAuthed() && request.auth.uid == uid;
      allow create: if isAuthed() && request.auth.uid == uid && resource == null && (
        (request.resource.contentType.matches('application/pdf|text/(plain|csv)|application/msword|application/vnd[.]ms-excel|application/vnd[.]openxmlformats-officedocument[.][a-z.]+|application/vnd[.]oasis[.]opendocument[.][a-z.]+')
          && request.resource.size < 25 * 1024 * 1024)
        || (request.resource.contentType.matches('image/(webp|jpeg|png)')
          && request.resource.size < 10 * 1024 * 1024)
        || (request.resource.contentType.matches('audio/(mpeg|mp4|ogg|wav|x-m4a|webm)')
          && request.resource.size < 50 * 1024 * 1024)
        || (request.resource.contentType.matches('video/(mp4|webm|quicktime)')
          && request.resource.size < 100 * 1024 * 1024)
      );
    }

    // CONTAS DO CLUBE-ASSOCIAÇÃO (Bloco D1): mesmo desenho da pasta da federação,
    // para a função `clubAccounts` copiar para `clube-contas-oficial/` (fechada).
    match /clube-contas/{uid}/{fileName} {
      allow get, list, delete: if isAuthed() && request.auth.uid == uid;
      allow create: if isAuthed() && request.auth.uid == uid && resource == null
        && request.resource.contentType.matches('application/pdf|image/(webp|jpeg|png)')
        && request.resource.size <= 9 * 1024 * 1024;
    }

    // Bloqueia qualquer outro caminho por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
